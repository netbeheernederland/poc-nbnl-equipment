'@context':
  '@vocab': http://www.w3.org/ns/shacl#
  adms: http://www.w3.org/ns/adms#
  dcat: http://www.w3.org/ns/dcat#
  dcterms: http://purl.org/dc/terms/
  owl: http://www.w3.org/2002/07/owl#
  rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns#
  rdfs: http://www.w3.org/2000/01/rdf-schema#
  sh: http://www.w3.org/ns/shacl#
  xsd: http://www.w3.org/2001/XMLSchema#
  classes:
    '@container': '@id'
    '@id': dcterms:hasPart
  closed:
    '@type': xsd:boolean
  datatype:
    '@type': '@id'
  class:
    '@type': '@id'
  description:
    '@id': dcterms:description
    '@type': xsd:string
  enums:
    '@container': '@id'
    '@id': dcterms:hasPart
    '@context':
      value:
        '@id': in
        '@container': '@list'
        '@type': '@id'
      name:
        '@id': sh:name
        '@type': xsd:string
  imports:
    '@id': owl:imports
    '@type': '@id'
  in:
    '@container': '@list'
    '@type': '@id'
  name:
    '@id': rdfs:label
  node:
    '@type': '@id'
  nodeKind:
    '@type': '@id'
  or:
    '@container': '@list'
    '@type': '@id'
  path:
    '@type': '@id'
  property:
    '@container': '@index'
    '@context':
      description:
        '@id': sh:description
        '@type': xsd:string
      name:
        '@id': sh:name
        '@type': xsd:string
    '@index': path
  publisher:
    '@id': dcterms:publisher
  seeAlso:
    '@id': rdfs:seeAlso
  title:
    '@id': dcterms:title
    '@container': '@language'
  isVersionOf:
    '@id': dcterms:isVersionOf
    '@type': '@id'
  version:
    '@id': dcat:version
    '@type': xsd:string

