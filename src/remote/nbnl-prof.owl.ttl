@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix nl: <https://cim.ucaiug.io/ns/nl#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .

<http://localhost:8000/remote/nbnl-prof.owl.ttl> a owl:Ontology .

sh:ShapesGraph rdfs:subClassOf owl:Ontology .
prof:Profile rdfs:subClassOf adms:Asset .
adms:Asset rdfs:subClassOf dcat:Dataset .

nl:hasClassShape a owl:ObjectProperty ;
    rdfs:domain sh:ShapesGraph ;
    rdfs:range sh:NodeShape , rdfs:Class ;
    rdfs:subPropertyOf dcterms:hasPart .

nl:hasEnumerationShape a owl:ObjectProperty ;
    rdfs:domain sh:ShapesGraph ;
    rdfs:range sh:NodeShape ;
    rdfs:subPropertyOf nl:hasMember .

nl:hasRuleShape a owl:ObjectProperty ;
    rdfs:domain sh:ShapesGraph ;
    rdfs:range sh:NodeShape ;
    rdfs:subPropertyOf nl:hasMember .
