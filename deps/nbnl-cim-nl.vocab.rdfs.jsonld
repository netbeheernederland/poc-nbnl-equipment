{
  "@context": {
    "@version": 1.1,
    "adms": "http://www.w3.org/ns/adms#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "cim": "https://cim.ucaiug.io/ns#",
    "nl": "https://cim.ucaiug.io/ns/nl#",
    "imports": {
      "@id": "owl:imports",
      "@type": "@id"
    },
    "classes": {
      "@container": "@id",
      "@id": "dcterms:hasPart"
    },
    "properties": {
      "@container": "@id",
      "@id": "dcterms:hasPart"
    },
    "concepts": {
      "@container": "@id",
      "@id": "dcterms:hasPart",
      "@context": {
        "@vocab": "http://www.w3.org/2004/02/skos/core#"
      }
    },
    "name": "rdfs:label",
    "definition": "skos:definition",
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    },
    "notation": "skos:notation"
  },
  "@id": "https://modellen.netbeheernederland.nl/cim-nl",
  "@type": [
    "adms:Asset",
    "owl:Ontology"
  ],
  "imports": [
    "cim-17.vocab.rdfs.ttl"
  ],
  "classes": {
    "nl:UpdateInfo": {
      "@type": "owl:Class",
      "name": "UpdateInfo",
      "definition": "Specific type of information that was updated for this dataset."
    }
  },
  "properties": {
    "nl:UpdateInfo.date": {
      "@type": "owl:DatatypeProperty",
      "name": "date",
      "definition": "Date of the update.",
      "domain": "nl:UpdateInfo",
      "range": "xsd:date"
    },
    "nl:UpdateInfo.type": {
      "@type": "owl:ObjectProperty",
      "name": "type",
      "definition": "Type of the update.",
      "domain": "nl:UpdateInfo",
      "range": "skos:Concept"
    },
    "nl:IdentifiedObject.europeanArticleNumberEAN": {
      "name": "europeanArticleNumberEAN",
      "domain": "cim:IdentifiedObject",
      "range": "xsd:string"
    }
  },
  "concepts": {
    "nl:UpdateInfoKind.ATC": {
      "@type": "skos:Concept",
      "definition": "Aanwezige transportcapaciteit.",
      "notation": "ATC"
    }
  }
