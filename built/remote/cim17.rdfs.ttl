cim:MWLimitSchedule a rdfs:Class ;
    rdfs:comment """Maximum MW and optionally Minimum MW (Y1 and Y2, respectively).\r
""" .

cim:MagneticField a rdfs:Class ;
    rdfs:comment "Magnetic field in nanotesla." .

cim:MagneticStorm a rdfs:Class ;
    rdfs:comment "A magnetic storm, a temporary disturbance of the earth's magnetic field, induced by radiation and streams of charged particles from the sun." ;
