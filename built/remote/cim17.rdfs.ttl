    rdfs:comment """A specialized class of AggregatedNode type. Defines the MarketRegions. Regions could be system Market Regions, Energy Regions or Ancillary Service Regions.\r
""" ;
    rdfs:subClassOf cim:AggregateNode .

cim:MarketRegionResults a rdfs:Class ;
    rdfs:comment """Provides all Region Ancillary Service results for the DA and RT markets. The specific data is commodity type (Regulation Up, Regulation Down, Spinning Reserve, Non-spinning Reserve, or Total Up reserves) based for the cleared MW, cleared price, and total capacity required for the region.\r
""" .

cim:MarketResults a rdfs:Class ;
    rdfs:comment """This class holds elements that are single values for the entire market time horizon. That is, for the Day Ahead market, there is 1 value for each element, not hourly based.  Is a summary of the market run.\r
""" .

cim:MarketRole a rdfs:Class ;
    rdfs:comment "The external intended behavior played by a party within the electricity market." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:MarketRun a rdfs:Class ;
    rdfs:comment "This class represents an actual instance of a planned market. For example, a Day Ahead market opens with the Bid Submission, ends with the closing of the Bid Submission. The market run represent the whole process. MarketRuns can be defined for markets such as Day Ahead Market, Real Time Market, Hour Ahead Market, Week Ahead Market, etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MarketScheduledEvent a rdfs:Class ;
    rdfs:comment "Signifies an event to trigger one or more activities, such as reading a meter, recalculating a bill, requesting work, when generating units shall be scheduled for maintenance, when a transformer is scheduled to be refurbished, etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MarketSkill a rdfs:Class ;
    rdfs:comment """Proficiency level of a craft, which is required to operate or maintain a particular type of asset and/or perform certain types of work. \r
""" ;
    rdfs:subClassOf cim:Document .

cim:MarketStatement a rdfs:Class ;
    rdfs:comment """A statement is a roll up of statement line items. Each statement along with its line items provide the details of specific charges at any given time.  Used by Billing and Settlement.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:MarketStatementLineItem a rdfs:Class ;
    rdfs:comment "An individual line item on an ISO settlement statement." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Marketer a rdfs:Class ;
    rdfs:comment """Matches buyers and sellers, and secures transmission (and other ancillary services) needed to complete the energy transaction.\r
""" ;
    rdfs:subClassOf cim:Organisation .

cim:Mass a rdfs:Class ;
    rdfs:comment "Mass." .

cim:MaterialItem a rdfs:Class ;
    rdfs:comment """The physical consumable supply used for work and other purposes. It includes items such as nuts, bolts, brackets, glue, etc.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MaxStartUpCostCurve a rdfs:Class ;
    rdfs:comment """The maximum Startup costs and time as a function of down time.  Relationship between unit startup cost (Y1-axis) vs. unit elapsed down time (X-axis). This is used to validate the information provided in the Bid.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:MeasurementAction a rdfs:Class ;
    rdfs:comment "Measurement taken as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:MeasurementCalculator a rdfs:Class ;
    rdfs:comment "Result of a calculation of one or more measurement. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MeasurementCalculatorInput a rdfs:Class ;
    rdfs:comment "Input to measurement calculation.  Support Analog, Discrete and Accumulator." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MechLoad1 a rdfs:Class ;
    rdfs:comment "Mechanical load model type 1." ;
    rdfs:subClassOf cim:MechanicalLoadDynamics .

cim:MechanicalLoadUserDefined a rdfs:Class ;
    rdfs:comment "Mechanical load function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:MechanicalLoadDynamics .

cim:Medium a rdfs:Class ;
    rdfs:comment "A substance that either (1) provides the means of transmission of a force or effect, such as hydraulic fluid, or (2) is used for a surrounding or enveloping substance, such as oil in a transformer or circuit breaker." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MerchantAccount a rdfs:Class ;
    rdfs:comment "The operating account controlled by merchant agreement, against which the vendor may vend tokens or receipt payments. Transactions via vendor shift debit the account and bank deposits via bank statement credit the account." ;
    rdfs:subClassOf cim:Document .

cim:MerchantAgreement a rdfs:Class ;
    rdfs:comment "A formal controlling contractual agreement between supplier and merchant, in terms of which the merchant is authorised to vend tokens and receipt payments on behalf of the supplier. The merchant is accountable to the supplier for revenue collected at point of sale." ;
    rdfs:subClassOf cim:Agreement .

cim:Meter a rdfs:Class ;
    rdfs:comment """Physical asset that performs the metering role of the usage point. Used for measuring consumption and detection of events.\r
""" ;
    rdfs:subClassOf cim:EndDevice .

cim:MeterMultiplier a rdfs:Class ;
    rdfs:comment """Multiplier applied at the meter.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MeterReadSchedule a rdfs:Class ;
    rdfs:subClassOf cim:Document .

cim:MeterReading a rdfs:Class ;
    rdfs:comment "Set of values obtained from the meter." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MeterWorkTask a rdfs:Class ;
    rdfs:comment "Work task involving meters." ;
    rdfs:subClassOf cim:WorkTask .

cim:MeteredSubSystem a rdfs:Class ;
    rdfs:comment """A metered subsystem.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MetrologyRequirement a rdfs:Class ;
    rdfs:comment """A specification of the metering requirements for a particular point within a network.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Minutes a rdfs:Class ;
    rdfs:comment """Time in minutes.\r
""" .

cim:MiscCostItem a rdfs:Class ;
    rdfs:comment """Various cost items that are not associated with compatible units. Examples include rental equipment, labor, materials, contractor costs, permits - anything not covered in a CU.\r
""" ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:MitigatedBid a rdfs:Class ;
    rdfs:comment """Mitigated bid results posted for a given settlement period.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MitigatedBidClearing a rdfs:Class ;
    rdfs:comment """Model of market power mitigation through reference or mitigated bids. Interval based.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:MitigatedBidSegment a rdfs:Class ;
    rdfs:comment """Model of mitigated bid. Indicates segment of piece-wise linear bid, that has been mitigated.\r
""" .

cim:MktACLineSegment a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Wires:ACLineSegment." ;
    rdfs:subClassOf cim:ACLineSegment .

cim:MktActivityRecord a rdfs:Class ;
    rdfs:comment "Subclass of IEC61968: Common:ActivityRecord." ;
    rdfs:subClassOf cim:ActivityRecord .

cim:MktAnalogLimit a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Meas:AnalogLimit." ;
    rdfs:subClassOf cim:AnalogLimit .

cim:MktAnalogLimitSet a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Meas:AnalogLimitSet." ;
    rdfs:subClassOf cim:AnalogLimitSet .

cim:MktCombinedCyclePlant a rdfs:Class ;
    rdfs:comment """Subclass of Production: CombinedCyclePlant from IEC 61970 package.\r
A set of combustion turbines and steam turbines where the exhaust heat from the combustion turbines is recovered to make steam for the steam turbines, resulting in greater overall plant efficiency.""" ;
    rdfs:subClassOf cim:CombinedCyclePlant .

cim:MktConductingEquipment a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Core:ConductingEquipment." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:MktConnectivityNode a rdfs:Class ;
    rdfs:comment "Subclass of IEC61970:Topology:ConnectivityNode." ;
    rdfs:subClassOf cim:ConnectivityNode .

cim:MktContingency a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Contingency." ;
    rdfs:subClassOf cim:Contingency .

cim:MktControlArea a rdfs:Class ;
    rdfs:comment "Market subclass of IEC 61970:ControlArea." ;
    rdfs:subClassOf cim:ControlArea .

cim:MktGeneratingUnit a rdfs:Class ;
    rdfs:comment "Subclass of IEC61970:Production:GeneratingUnit." ;
    rdfs:subClassOf cim:GeneratingUnit .

cim:MktHeatRateCurve a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970: Generation: Production:HeatRateCurve." ;
    rdfs:subClassOf cim:HeatRateCurve .

cim:MktLine a rdfs:Class ;
    rdfs:comment "Subclass for IEC61970:Wires:Line." ;
    rdfs:subClassOf cim:Line .

cim:MktMeasurement a rdfs:Class ;
    rdfs:comment "Subclass of IEC61970:Meas:Measurement." ;
    rdfs:subClassOf cim:Measurement .

cim:MktPSRType a rdfs:Class ;
    rdfs:comment "The type of a power system resource." ;
    rdfs:subClassOf cim:PSRType .

cim:MktPowerTransformer a rdfs:Class ;
    rdfs:comment "Subclass of IEC61970:Wires:PowerTransformer." ;
    rdfs:subClassOf cim:PowerTransformer .

cim:MktSeriesCompensator a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Wires:SeriesCompensator." ;
    rdfs:subClassOf cim:SeriesCompensator .

cim:MktShuntCompensator a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Wires:ShuntCompensator." ;
    rdfs:subClassOf cim:ShuntCompensator .

cim:MktSwitch a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Wires:Switch." ;
    rdfs:subClassOf cim:Switch .

cim:MktTapChanger a rdfs:Class ;
    rdfs:comment "Subclass of IEC 61970:Wires:TapChanger." ;
    rdfs:subClassOf cim:TapChanger .

cim:MktTerminal a rdfs:Class ;
    rdfs:comment "Subclass of IEC61970:Core:Terminal." ;
    rdfs:subClassOf cim:Terminal .

cim:MktThermalGeneratingUnit a rdfs:Class ;
    rdfs:comment "Subclass of ThermalGeneratingUnit from Production Package in IEC 61970." ;
    rdfs:subClassOf cim:ThermalGeneratingUnit .

cim:MktUserAttribute a rdfs:Class ;
    rdfs:comment "Subclass of IEC61968:Domain2:UserAttribute." ;
    rdfs:subClassOf cim:UserAttribute .

cim:ModelAuthority a rdfs:Class ;
    rdfs:comment "A Modeling Authority is an entity responsible for supplying and maintaining the data defining a specific set of objects in a network model." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelFrameType a rdfs:Class ;
    rdfs:comment "Examples would be \"Boundary\" or \"Region\" type of frame." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelOperation a rdfs:Class ;
    rdfs:comment "An operation performed on models. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelOperationDescription a rdfs:Class ;
    rdfs:comment "The type of model operation.   This class is referenced by model operations and defines the kind of operation." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelOperationSequence a rdfs:Class ;
    rdfs:comment "A concrete sequence of operations.    For example, this may be used to describe a specific audit trail, a script or other specific set of actions on specific datasets." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelPartSpecification a rdfs:Class ;
    rdfs:comment "The type of model.  For example,  state estimator, planning, planning dynamics, short circuit, or real-time dynamics etc.     The model must conform to a profile. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelPartVersion a rdfs:Class ;
    rdfs:comment "This is a version of a part of a model.  New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated data set.  Instances of this class are considered immutable.  The case audit trail can reference this immutable data to exactly reproduce a case." ;
    rdfs:subClassOf cim:ModelToBeDeleted .

cim:Money a rdfs:Class ;
    rdfs:comment """Amount of money.\r
""" .

cim:MonthDayInterval a rdfs:Class ;
    rdfs:comment "Interval between two times specified as month and day." .

cim:MutualCoupling a rdfs:Class ;
    rdfs:comment """This class represents the zero sequence line mutual coupling.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Name a rdfs:Class ;
    rdfs:comment """The Name class provides the means to define any number of human readable  names for an object. A name is <b>not</b> to be used for defining inter-object relationships. For inter-object relationships instead use the object identification 'mRID'.\r
""" .

cim:NameType a rdfs:Class ;
    rdfs:comment """Type of name. Possible values for attribute 'name' are implementation dependent but standard profiles may specify types. An enterprise may have multiple IT systems each having its own local name for the same object, e.g. a planning system may have different names from an EMS. An object may also have different names within the same IT system, e.g. localName as defined in CIM version 14. The definition from CIM14 is:\r
The localName is a human readable name of the object. It is a free text name local to a node in a naming hierarchy similar to a file directory structure. A power system related naming hierarchy may be: Substation, VoltageLevel, Equipment etc. Children of the same parent in such a hierarchy have names that typically are unique among them.\r
""" .

cim:NameTypeAuthority a rdfs:Class ;
    rdfs:comment """Authority responsible for creation and management of names of a given type; typically an organization or an enterprise system.\r
""" .

cim:NetworkBoundary a rdfs:Class ;
    rdfs:comment "A framework part that is a boundary between 2 frames." ;
    rdfs:subClassOf cim:FrameworkPart .

cim:NetworkFrame a rdfs:Class ;
    rdfs:comment "A region isolated by boundaries." ;
    rdfs:subClassOf cim:FrameworkPart .

cim:NetworkModelCaseDefinition a rdfs:Class ;
    rdfs:comment "Instructions to build a network model case, including when appropriate the results. " .

cim:NetworkModelProject a rdfs:Class ;
    rdfs:comment """A grouping of network model change descriptions.  Primarily used to organize the phases of an overall project.\r
\r
\r
 """ ;
    rdfs:subClassOf cim:NetworkModelProjectComponent .

cim:NetworkModelProject2 a rdfs:Class ;
    rdfs:subClassOf cim:NetworkModelProjectComponent2 .

cim:NetworkModelProjectChange a rdfs:Class ;
    rdfs:comment "Network model project change described by versions of an associated change set.  Has persistent identity over multiple versions of the associated change set. " ;
    rdfs:subClassOf cim:NetworkModelProjectComponent .

cim:NetworkModelProjectChangeVersion a rdfs:Class ;
    rdfs:comment "Describes the status and the planned implementation of the associated change set into the as-built model.    New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated change set.  Instances of this class are considered immutable.  The case audit trail can reference this immutable data to exactly reproduce a case." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:NetworkModelProjectCollection a rdfs:Class .

cim:NetworkModelProjectDocument a rdfs:Class .

cim:NetworkModelProjectStage a rdfs:Class ;
    rdfs:subClassOf cim:NetworkModelProjectComponent2 .

cim:NetworkModelProjectState a rdfs:Class ;
    rdfs:comment "A network model project version state.  States are agreed upon by the exchange community.  Examples are \"approved\", \"proposed\", \"withdrawn\", \"committed\" etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:NoLoadTest a rdfs:Class ;
    rdfs:comment "No-load test results determine core admittance parameters. They include exciting current and core loss measurements from applying voltage to one winding. The excitation may be positive sequence or zero sequence. The test may be repeated at different voltages to measure saturation." ;
    rdfs:subClassOf cim:TransformerTest .

cim:NodeConstraintTerm a rdfs:Class ;
    rdfs:comment """To be used only to constrain a quantity that cannot be associated with a terminal. For example, a registered generating unit that is not electrically connected to the network.\r
""" ;
    rdfs:subClassOf cim:ConstraintTerm .

cim:NonConformLoad a rdfs:Class ;
    rdfs:comment "NonConformLoad represents loads that do not follow a daily load change pattern and whose changes are not correlated with the daily load change pattern." ;
    rdfs:subClassOf cim:EnergyConsumer .

cim:NonConformLoadGroup a rdfs:Class ;
    rdfs:comment "Loads that do not follow a daily and seasonal load variation pattern." ;
    rdfs:subClassOf cim:LoadGroup .

cim:NonConformLoadSchedule a rdfs:Class ;
    rdfs:comment "An active power (Y1-axis) and reactive power (Y2-axis) schedule (curves) versus time (X-axis) for non-conforming loads, e.g., large industrial load or power station service (where modelled)." ;
    rdfs:subClassOf cim:SeasonDayTypeSchedule .

cim:NonStandardItem a rdfs:Class ;
    rdfs:comment """This document provides information for non-standard items like customer contributions (e.g., customer digs trench), vouchers (e.g., credit), and contractor bids. \r
""" ;
    rdfs:subClassOf cim:WorkDocument .

cim:NonlinearShuntCompensator a rdfs:Class ;
    rdfs:comment "A non linear shunt compensator has bank or section admittance values that differ. The attributes g, b, g0 and b0 of the associated NonlinearShuntCompensatorPoint describe the total conductance and admittance of a NonlinearShuntCompensatorPoint at a section number specified by NonlinearShuntCompensatorPoint.sectionNumber." ;
    rdfs:subClassOf cim:ShuntCompensator .

cim:NonlinearShuntCompensatorPhase a rdfs:Class ;
    rdfs:comment "A per phase non linear shunt compensator has bank or section admittance values that differ. The attributes g and b of the associated NonlinearShuntCompensatorPhasePoint describe the total conductance and admittance of a NonlinearShuntCompensatorPhasePoint at a section number specified by NonlinearShuntCompensatorPhasePoint.sectionNumber." ;
    rdfs:subClassOf cim:ShuntCompensatorPhase .

cim:NonlinearShuntCompensatorPhasePoint a rdfs:Class ;
    rdfs:comment "A per phase non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPhasePoint instances associated with a NonlinearShuntCompensatorPhase shall be equal to ShuntCompensatorPhase.maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPhasePoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPhasePoint-s." .

cim:NonlinearShuntCompensatorPoint a rdfs:Class ;
    rdfs:comment "A non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPoint instances associated with a NonlinearShuntCompensator shall be equal to ShuntCompensator.maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPoint-s." .

cim:NotificationTimeCurve a rdfs:Class ;
    rdfs:comment """Notification time curve as a function of down time.  Relationship between crew notification time (Y1-axis) and unit startup time (Y2-axis) vs. unit elapsed down time (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:NuclearGeneratingUnit a rdfs:Class ;
    rdfs:comment "A nuclear generating unit." ;
    rdfs:subClassOf cim:GeneratingUnit .

cim:ObjectCreation a rdfs:Class ;
    rdfs:comment "An object is to be created in the context." ;
    rdfs:subClassOf cim:ChangeSetMember .

cim:ObjectDeletion a rdfs:Class ;
    rdfs:comment """An object is to be deleted in the context.\r
""" ;
    rdfs:subClassOf cim:ChangeSetMember .

cim:ObjectModification a rdfs:Class ;
    rdfs:comment "The object already exists and is to be modified." ;
    rdfs:subClassOf cim:ChangeSetMember .

cim:ObjectReverseModification a rdfs:Class ;
    rdfs:comment "Used to specify precondition properties for a preconditioned update." ;
    rdfs:subClassOf cim:ChangeSetMember .

cim:Observation a rdfs:Class ;
    rdfs:comment "Observed (actual non-forecast) values sets and/or phenomena characteristics." ;
    rdfs:subClassOf cim:EnvironmentalInformation .

cim:OilAnalysisFluidAnalog a rdfs:Class ;
    rdfs:comment """Asset oil analysis fluid test type of analog.\r
.""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisFluidDiscrete a rdfs:Class ;
    rdfs:comment """Asset oil analysis fluid type of discrete.\r
""" ;
    rdfs:subClassOf cim:AssetDiscrete .

cim:OilAnalysisGasAnalog a rdfs:Class ;
    rdfs:comment """Asset oil analysis gas type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisMetalsAnalog a rdfs:Class ;
    rdfs:comment """Asset oil analysis metals type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisMoistureAnalog a rdfs:Class ;
    rdfs:comment """Asset oil analysis moisture type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisPCBAnalog a rdfs:Class ;
    rdfs:comment """Asset oil analysis PCB type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisPCBDiscrete a rdfs:Class ;
    rdfs:comment """Asset oil analysis PCB type of discrete.\r
""" ;
    rdfs:subClassOf cim:AssetDiscrete .

cim:OilAnalysisPaperAnalog a rdfs:Class ;
    rdfs:comment """Asset oil inspection paper type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisParticleAnalog a rdfs:Class ;
    rdfs:comment """Asset oil analysis particle type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:OilAnalysisParticleDiscrete a rdfs:Class ;
    rdfs:comment """Asset oil analysis particle type of discrete.\r
""" ;
    rdfs:subClassOf cim:AssetDiscrete .

cim:OilPrice a rdfs:Class ;
    rdfs:comment """Price of oil in monetary units.\r
""" .

cim:OilSpecimen a rdfs:Class ;
    rdfs:subClassOf cim:Specimen .

cim:OldCrew a rdfs:Class ;
    rdfs:comment "A crew is a group of people with specific skills, tools, and vehicles." ;
    rdfs:subClassOf cim:Crew .

cim:OldPerson a rdfs:Class ;
    rdfs:comment "General purpose information for name and other information to contact people." ;
    rdfs:subClassOf cim:Person .

cim:OldTransformerEndInfo a rdfs:Class ;
    rdfs:subClassOf cim:TransformerEndInfo .

cim:OldTransformerTankInfo a rdfs:Class ;
    rdfs:subClassOf cim:TransformerTankInfo .

cim:OldWorkTask a rdfs:Class ;
    rdfs:comment "A set of tasks is required to implement a design." ;
    rdfs:subClassOf cim:WorkTask .

cim:OneCallRequest a rdfs:Class ;
    rdfs:comment "A request for other utilities to mark their underground facilities prior to commencement of construction and/or maintenance." ;
    rdfs:subClassOf cim:WorkDocument .

cim:OpenAccessProduct a rdfs:Class ;
    rdfs:comment """Contracts for services offered commercially.\r
""" ;
    rdfs:subClassOf cim:Agreement .

cim:OpenCircuitTest a rdfs:Class ;
    rdfs:comment "Open-circuit test results verify winding turn ratios and phase shifts. They include induced voltage and phase shift measurements on open-circuit windings, with voltage applied to the energised end. For three-phase windings, the excitation can be a positive sequence (the default) or a zero sequence." ;
    rdfs:subClassOf cim:TransformerTest .

cim:OpenTieSchedule a rdfs:Class ;
    rdfs:comment """Result of bid validation against conditions that may exist on an interchange that becomes disconnected or is heavily discounted with respect the MW flow.\r
\r
This schedule is assocated with the hourly parameters in a resource bid.\r
""" ;
    rdfs:subClassOf cim:BidHourlySchedule .

cim:OperatingMechanism a rdfs:Class ;
    rdfs:comment "Breaker mechanism." ;
    rdfs:subClassOf cim:Asset .

cim:OperatingMechanismInfo a rdfs:Class ;
    rdfs:comment "Breaker operating mechanism datasheet information." ;
    rdfs:subClassOf cim:AssetInfo .

cim:OperatingParticipant a rdfs:Class ;
    rdfs:comment """An operator of multiple power system resource objects. Note multple operating participants may operate the same power system resource object.   This can be used for modeling jointly owned units where each owner operates as a contractual share.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OperatingShare a rdfs:Class ;
    rdfs:comment """Specifies the operations contract relationship between a power system resource and a contract participant.\r
""" .

cim:Operation a rdfs:Class .

cim:OperationalLimitSet a rdfs:Class ;
    rdfs:comment """A set of limits associated with equipment.  Sets of limits might apply to a specific temperature, or season for example. A set of limits may contain different severities of limit levels that would apply to the same equipment. The set may contain limits of different types such as apparent power and current limits or high and low voltage limits  that are logically applied together as a set.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OperationalLimitType a rdfs:Class ;
    rdfs:comment """The operational meaning of a category of limits.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OperationalTag a rdfs:Class ;
    rdfs:comment "Operational tag placed on a power system resource or asset in the context of switching plan execution or other work in the field." ;
    rdfs:subClassOf cim:Document .

cim:OperationalUpdatedRating a rdfs:Class ;
    rdfs:comment "Lowered capability because of deterioration or inadequacy (sometimes referred to as derating or partial outage) or other kind of operational rating change." ;
    rdfs:subClassOf cim:OperationalRestriction .

cim:OperationsSafetySupervisor a rdfs:Class ;
    rdfs:comment "Operator with responsibility that the work in high voltage installation is executed in a safe manner and according to safety regulation." ;
    rdfs:subClassOf cim:Operator .

cim:OperatonalLimitTypeScaling a rdfs:Class ;
    rdfs:comment "One operational limit type scales values of another operational limit type when under the same operational limit set.    This applies to any operational limit assigned to the target operational limit type and without other limit dependency models. " .

cim:OrgOrgRole a rdfs:Class ;
    rdfs:comment """Roles played between Organisations and other Organisations. This includes role ups for ogranisations, cost centers, profit centers, regulatory reporting, etc.\r
Note that the parent and child relationship is indicated by the name on each end of the association.""" ;
    rdfs:subClassOf cim:OrganisationRole .

cim:OrgPnodeAllocation a rdfs:Class ;
    rdfs:comment "This class models the allocation between asset owners and pricing nodes." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OrgResOwnership a rdfs:Class ;
    rdfs:comment "This class model the ownership percent and type of ownership between resource and organisation." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OutageArea a rdfs:Class ;
    rdfs:comment "This defines the area covered by the Outage." .

cim:OutageOrder a rdfs:Class ;
    rdfs:comment "Transmits an outage plan to a crew in order for the planned outage to be executed." ;
    rdfs:subClassOf cim:Document .

cim:OutagePlan a rdfs:Class ;
    rdfs:comment "Document containing the definition of planned outages of equipment and/or usage points. It will reference switching plans that are used to execute the planned outage." ;
    rdfs:subClassOf cim:Document .

cim:OverexcLim2 a rdfs:Class ;
    rdfs:comment """Different from LimIEEEOEL, LimOEL2 has a fixed pickup threshold and reduces the excitation set-point by means of a non-windup integral regulator.\r
<i>Irated</i> is the rated machine excitation current (calculated from nameplate conditions: <i>V</i><i><sub>nom</sub></i>, <i>P</i><i><sub>nom</sub></i>, <i>CosPhi</i><i><sub>nom</sub></i>).""" ;
    rdfs:subClassOf cim:OverexcitationLimiterDynamics .

cim:OverexcLimIEEE a rdfs:Class ;
    rdfs:comment """The over excitation limiter model is intended to represent the significant features of OELs necessary for some large-scale system studies. It is the result of a pragmatic approach to obtain a model that can be widely applied with attainable data from generator owners. An attempt to include all variations in the functionality of OELs and duplicate how they interact with the rest of the excitation systems would likely result in a level of application insufficient for the studies for which they are intended.\r
Reference: IEEE OEL 421.5-2005, 9. """ ;
    rdfs:subClassOf cim:OverexcitationLimiterDynamics .

cim:OverexcLimX1 a rdfs:Class ;
    rdfs:comment "Field voltage over excitation limiter." ;
    rdfs:subClassOf cim:OverexcitationLimiterDynamics .

cim:OverexcLimX2 a rdfs:Class ;
    rdfs:comment "Field voltage or current overexcitation limiter designed to protect the generator field of an AC machine with automatic excitation control from overheating due to prolonged overexcitation." ;
    rdfs:subClassOf cim:OverexcitationLimiterDynamics .

cim:OverexcitationLimiterUserDefined a rdfs:Class ;
    rdfs:comment "Overexcitation limiter system function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:OverexcitationLimiterDynamics .

cim:OverheadCost a rdfs:Class ;
    rdfs:comment "Overhead cost applied to work order." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:OverheadWireInfo a rdfs:Class ;
    rdfs:comment """Overhead wire data.\r
""" ;
    rdfs:subClassOf cim:WireInfo .

cim:Ownership a rdfs:Class ;
    rdfs:comment "Ownership of e.g. asset." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PFVArControllerType1UserDefined a rdfs:Class ;
    rdfs:comment "Power factor or VAr controller type 1 function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:PFVArControllerType1Dynamics .

cim:PFVArControllerType2UserDefined a rdfs:Class ;
    rdfs:comment "Power factor or VAr controller type 2 function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:PFVArControllerType2Dynamics .

cim:PFVArType1IEEEPFController a rdfs:Class ;
    rdfs:comment """IEEE PF controller type 1 which operates by moving the voltage reference directly.\r
Reference: IEEE 421.5-2005, 11.2. """ ;
    rdfs:subClassOf cim:PFVArControllerType1Dynamics .

cim:PFVArType1IEEEVArController a rdfs:Class ;
    rdfs:comment """IEEE VAR controller type 1 which operates by moving the voltage reference directly.\r
Reference: IEEE 421.5-2005, 11.3.""" ;
    rdfs:subClassOf cim:PFVArControllerType1Dynamics .

cim:PFVArType2Common1 a rdfs:Class ;
    rdfs:comment """Power factor / reactive power regulator. This model represents the power factor or reactive power controller such as the Basler SCP-250. The controller measures power factor or reactive power (PU on generator rated power) and compares it with the operator's set point.\r
[Footnote: Basler SCP-250 is an example of a suitable product available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of this product.]""" ;
    rdfs:subClassOf cim:PFVArControllerType2Dynamics .

cim:PFVArType2IEEEPFController a rdfs:Class ;
    rdfs:comment """IEEE PF controller type 2 which is a summing point type controller making up the outside loop of a two-loop system. This controller is implemented as a slow PI type controller. The voltage regulator forms the inner loop and is implemented as a fast controller.\r
Reference: IEEE 421.5-2005, 11.4. """ ;
    rdfs:subClassOf cim:PFVArControllerType2Dynamics .

cim:PFVArType2IEEEVArController a rdfs:Class ;
    rdfs:comment """IEEE VAR controller type 2 which is a summing point type controller. It makes up the outside loop of a two-loop system. This controller is implemented as a slow PI type controller, and the voltage regulator forms the inner loop and is implemented as a fast controller.\r
Reference: IEEE 421.5-2005, 11.5.""" ;
    rdfs:subClassOf cim:PFVArControllerType2Dynamics .

cim:PFmode a rdfs:Class .

cim:PSREvent a rdfs:Class ;
    rdfs:comment "Event recording the change in operational status of a power system resource (PSR); may be for an event that has already occurred or for a planned activity." ;
    rdfs:subClassOf cim:ActivityRecord .

cim:PU a rdfs:Class ;
    rdfs:comment """Per Unit - a positive or negative value referred to a defined base. Values typically range from -10 to +10.\r
""" .

cim:PWRSteamSupply a rdfs:Class ;
    rdfs:comment """Pressurized water reactor used as a steam supply to a steam turbine.\r
""" ;
    rdfs:subClassOf cim:SteamSupply .

cim:PackageDependenciesCIMVersion a rdfs:Class ;
    rdfs:comment """The version of dependencies description among top level subpackages of the combined CIM model.  This is not the same as the combined packages version.\r
""" .

cim:PanDemandResponse a rdfs:Class ;
    rdfs:comment """PAN control used to issue action/command to PAN devices during a demand response/load control event.\r
""" ;
    rdfs:subClassOf cim:EndDeviceAction .

cim:PanDisplay a rdfs:Class ;
    rdfs:comment """PAN action/command used to issue the displaying of text messages on PAN devices.\r
""" ;
    rdfs:subClassOf cim:EndDeviceAction .

cim:PanPricing a rdfs:Class ;
    rdfs:comment """PAN action/command used to issue pricing information to a PAN device.\r
""" ;
    rdfs:subClassOf cim:EndDeviceAction .

cim:PanPricingDetail a rdfs:Class ;
    rdfs:comment """Detail for a single price command/action.\r
""" .

cim:ParentOrganization a rdfs:Class ;
    rdfs:subClassOf cim:Organisation .

cim:Participation a rdfs:Class ;
    rdfs:comment """Participation level of a given Pnode in a given AggregatePnode.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ParticulateDensity a rdfs:Class ;
    rdfs:comment "Particulate density as kg/m<sup>3</sup>." .

cim:PassThroughBill a rdfs:Class ;
    rdfs:comment """Pass Through Bill is used for:\r
1)Two sided charge transactions with or without ISO involvement\r
2) Specific direct charges or payments that are calculated outside or provided directly to settlements\r
3) Specific charge bill determinants that are externally supplied and used in charge calculations\r
""" ;
    rdfs:subClassOf cim:Document .

cim:Pcontrol a rdfs:Class .

cim:PendingCalculation a rdfs:Class ;
    rdfs:comment """When present, a scalar conversion that needs to be applied to every IntervalReading.value contained in IntervalBlock. This conversion results in a new associated ReadingType, reflecting the true dimensions of IntervalReading values after the conversion.\r
""" .

cim:PenstockLossCurve a rdfs:Class ;
    rdfs:comment "Relationship between penstock head loss (in meters) and  total discharge through the penstock (in cubic meters per second). One or more turbines may be connected to the same penstock." ;
    rdfs:subClassOf cim:Curve .

cim:PerCent a rdfs:Class ;
    rdfs:comment """Percentage on a defined base.   For example, specify as 100 to indicate at the defined base.\r
""" .

cim:PerLengthDCLineParameter a rdfs:Class ;
    rdfs:comment "Common type for per-length electrical catalogues describing DC line parameters." ;
    rdfs:subClassOf cim:PerLengthLineParameter .

cim:PerLengthPhaseImpedance a rdfs:Class ;
    rdfs:comment "Impedance and admittance parameters per unit length for n-wire unbalanced lines, in matrix form." ;
    rdfs:subClassOf cim:PerLengthImpedance .

cim:PerLengthSequenceImpedance a rdfs:Class ;
    rdfs:comment "Sequence impedance and admittance parameters per unit length, for transposed lines of 1, 2, or 3 phases. For 1-phase lines, define x=x0=xself. For 2-phase lines, define x=xs-xm and x0=xs+xm." ;
    rdfs:subClassOf cim:PerLengthImpedance .

cim:Period a rdfs:Class ;
    rdfs:comment "An identification of a time interval that may have a given resolution." .

cim:PeriodicStatisticalCalculation a rdfs:Class ;
    rdfs:comment """Description of period for which calculation is performed.\r
""" ;
    rdfs:subClassOf cim:StatisticalCalculation .

cim:PersonOrganisationRole a rdfs:Class ;
    rdfs:comment """Role an organisation plays with respect to persons.\r
""" ;
    rdfs:subClassOf cim:OrganisationRole .

cim:PersonPropertyRole a rdfs:Class ;
    rdfs:comment "The role of a person relative to a given piece of property. Examples of roles include: owner, renter, contractor, etc." ;
    rdfs:subClassOf cim:Role .

cim:PetersenCoil a rdfs:Class ;
    rdfs:comment "A variable impedance device normally used to offset line charging during single line faults in an ungrounded section of network." ;
    rdfs:subClassOf cim:EarthFaultCompensator .

cim:PhaseImpedanceData a rdfs:Class ;
    rdfs:comment """Impedance and conductance matrix element values. \r
The diagonal elements are described by the elements having the same toPhase and fromPhase value and the off diagonal elements have different toPhase and fromPhase values.  The matrix can also be stored in symmetric lower triangular format using the row and column attributes, which map to ACLineSegmentPhase.sequenceNumber.""" .

cim:PhaseTapChangerAsymmetrical a rdfs:Class ;
    rdfs:comment "Describes the tap model for an asymmetrical phase shifting transformer in which the difference voltage vector adds to the in-phase winding. The out-of-phase winding is the transformer end where the tap changer is located.  The angle between the in-phase and out-of-phase windings is named the winding connection angle. The phase shift depends on both the difference voltage magnitude and the winding connection angle." ;
    rdfs:subClassOf cim:PhaseTapChangerNonLinear .

cim:PhaseTapChangerLinear a rdfs:Class ;
    rdfs:comment """Describes a tap changer with a linear relation between the tap step and the phase angle difference across the transformer. This is a mathematical model that is an approximation of a real phase tap changer.\r
The phase angle is computed as stepPhaseShiftIncrement times the tap position.\r
The voltage magnitude of both sides is the same.""" ;
    rdfs:subClassOf cim:PhaseTapChanger .

cim:PhaseTapChangerSymmetrical a rdfs:Class ;
    rdfs:comment "Describes a symmetrical phase shifting transformer tap model in which the voltage magnitude of both sides is the same. The difference voltage magnitude is the base in an equal-sided triangle where the sides corresponds to the primary and secondary voltages. The phase angle difference corresponds to the top angle and can be expressed as twice the arctangent of half the total difference voltage." ;
    rdfs:subClassOf cim:PhaseTapChangerNonLinear .

cim:PhaseTapChangerTable a rdfs:Class ;
    rdfs:comment "Describes a tabular curve for how the phase angle difference and impedance varies with the tap step." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PhaseTapChangerTablePoint a rdfs:Class ;
    rdfs:comment """Describes each tap step in the phase tap changer tabular curve.\r
""" ;
    rdfs:subClassOf cim:TapChangerTablePoint .

cim:PhaseTapChangerTabular a rdfs:Class ;
    rdfs:comment "Describes a tap changer with a table defining the relation between the tap step and the phase angle difference across the transformer. " ;
    rdfs:subClassOf cim:PhaseTapChanger .

cim:PhenomenonClassification a rdfs:Class ;
    rdfs:comment "A pre-defined phenomenon classification as defined by a particular authority." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PhotoVoltaicUnit a rdfs:Class ;
    rdfs:comment "A photovoltaic device or an aggregation of such devices." ;
    rdfs:subClassOf cim:PowerElectronicsUnit .

cim:PinBranchGroup a rdfs:Class ;
    rdfs:comment "Value associated with branch group is used as compare." ;
    rdfs:subClassOf cim:GateInputPin .

cim:PinEquipment a rdfs:Class ;
    rdfs:comment "Value associated with Equipment is used as compare." ;
    rdfs:subClassOf cim:GateInputPin .

cim:PinGate a rdfs:Class ;
    rdfs:comment "An output from one gate represent an input to another gate." ;
    rdfs:subClassOf cim:GateInputPin .

cim:PinMeasurement a rdfs:Class ;
    rdfs:comment "Gate input pin that is associated with a Measurement or a calculation of Measurement. " ;
    rdfs:subClassOf cim:GateInputPin .

cim:PinTerminal a rdfs:Class ;
    rdfs:comment "Value associated with Terminal is used as compare." ;
    rdfs:subClassOf cim:GateInputPin .

cim:PlannedMarket a rdfs:Class ;
    rdfs:comment "Represent a planned market. For example a planned DA/HA/RT market." .

cim:PlannedMarketEvent a rdfs:Class ;
    rdfs:comment "This class represents planned events. Used to model the various planned events in a market (closing time, clearing time, etc.)" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PlannedOutage a rdfs:Class ;
    rdfs:subClassOf cim:Outage .

cim:PlannedOutageNotification a rdfs:Class ;
    rdfs:comment "This class will be used to generate call ahead lists for customers who will be affected by a planned outage." ;
    rdfs:subClassOf cim:Document .

cim:Plant a rdfs:Class ;
    rdfs:comment "A Plant is a collection of equipment for purposes of generation." ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:PnodeClearing a rdfs:Class ;
    rdfs:comment """Pricing node clearing results posted for a given settlement period.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:PnodeDistributionFactor a rdfs:Class ;
    rdfs:comment """This class allows SC to input different distribution factors for pricing node.\r
""" .

cim:PnodeResults a rdfs:Class ;
    rdfs:comment """Provides the total price, the cost component, the loss component, and the congestion component for Pnodes for the forward and real time markets. There are several prices produced based on the run type (MPM, RUC, Pricing, or Scheduling/Dispatch).\r
""" .

cim:Point a rdfs:Class ;
    rdfs:comment "An identification of a set of values beeing adressed within a specific interval of time." .

cim:PointOfSale a rdfs:Class ;
    rdfs:comment "Logical point where transactions take place with operational interaction between cashier and the payment system; in certain cases the point of sale interacts directly with the end customer, in which case the cashier might not be a real person: for example a self-service kiosk or over the internet." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Pole a rdfs:Class ;
    rdfs:comment """Pole asset.\r
""" ;
    rdfs:subClassOf cim:Structure .

cim:PositionPoint a rdfs:Class ;
    rdfs:comment "Set of spatial coordinates that determine a point, defined in the coordinate system specified in 'Location.CoordinateSystem'. Use a single position point instance to describe a point-oriented location. Use a sequence of position points to describe a line-oriented object (physical location of non-point oriented objects like cables or lines), or area of an object (like a substation or a geographical zone - in this case, have first and last position point with the same values)." .

cim:PostLineSensor a rdfs:Class ;
    rdfs:comment """ A sensor used mainly in overhead distribution networks as the source of both current and voltage measurements.\r
""" ;
    rdfs:subClassOf cim:Sensor .

cim:PotentialTransformer a rdfs:Class ;
    rdfs:comment "Instrument transformer (also known as Voltage Transformer) used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as voltage transducer for the purpose of metering, protection, or sometimes auxiliary substation supply. A typical secondary voltage rating would be 120V." ;
    rdfs:subClassOf cim:Sensor .

cim:PotentialTransformerInfo a rdfs:Class ;
    rdfs:comment """Properties of potential transformer asset.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:PowerCutZone a rdfs:Class ;
    rdfs:comment "An area or zone of the power system which is used for load shedding purposes." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:PowerElectronicsConnection a rdfs:Class ;
    rdfs:comment "A connection to the AC network for energy production or consumption that uses power electronics rather than rotating machines." ;
    rdfs:subClassOf cim:RegulatingCondEq .

cim:PowerElectronicsConnectionPhase a rdfs:Class ;
    rdfs:comment "A single phase of a power electronics connection." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:PowerElectronicsWindUnit a rdfs:Class ;
    rdfs:comment "A wind generating unit that connects to the AC network with power electronics rather than rotating machines or an aggregation of such units." ;
    rdfs:subClassOf cim:PowerElectronicsUnit .

cim:PowerQualityPricing a rdfs:Class ;
    rdfs:comment """Pricing can be based on power quality.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:PowerSystemProjectLifecycleToBeDeleted a rdfs:Class ;
    rdfs:comment "Represent the base lifecycle of a functional model change that could be a construction of new elements." .

cim:PowerSystemStabilizerUserDefined a rdfs:Class ;
    rdfs:comment "<font color=\"#0f0f0f\">Power system stabilizer</font> function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PowerTransformerEnd a rdfs:Class ;
    rdfs:comment """A PowerTransformerEnd is associated with each Terminal of a PowerTransformer.\r
The impedance values r, r0, x, and x0 of a PowerTransformerEnd represents a star equivalent as follows.\r
1) for a two Terminal PowerTransformer the high voltage (TransformerEnd.endNumber=1) PowerTransformerEnd has non zero values on r, r0, x, and x0 while the low voltage (TransformerEnd.endNumber=2) PowerTransformerEnd has zero values for r, r0, x, and x0.  Parameters are always provided, even if the PowerTransformerEnds have the same rated voltage.  In this case, the parameters are provided at the PowerTransformerEnd which has TransformerEnd.endNumber equal to 1.\r
2) for a three Terminal PowerTransformer the three PowerTransformerEnds represent a star equivalent with each leg in the star represented by r, r0, x, and x0 values.\r
3) For a three Terminal transformer each PowerTransformerEnd shall have g, g0, b and b0 values corresponding to the no load losses distributed on the three PowerTransformerEnds. The total no load loss shunt impedances may also be placed at one of the PowerTransformerEnds, preferably the end numbered 1, having the shunt values on end 1.  This is the preferred way.\r
4) for a PowerTransformer with more than three Terminals the PowerTransformerEnd impedance values cannot be used. Instead use the TransformerMeshImpedance or split the transformer into multiple PowerTransformers.\r
Each PowerTransformerEnd must be contained by a PowerTransformer. Because a PowerTransformerEnd (or any other object) can not be contained by more than one parent, a PowerTransformerEnd can not have an association to an EquipmentContainer (Substation, VoltageLevel, etc).""" ;
    rdfs:subClassOf cim:TransformerEnd .

cim:PowerTransformerInfo a rdfs:Class ;
    rdfs:comment """Set of power transformer data, from an equipment library.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:Pressure a rdfs:Class ;
    rdfs:comment "Pressure in pascals." .

cim:Price a rdfs:Class ;
    rdfs:comment "The cost corresponding to a specific measure and expressed in a currency." .

cim:PriceDescriptor a rdfs:Class ;
    rdfs:comment "The price of a Commodity during a given time interval may change over time.  For example, a price may be forecasted a year ahead, a month ahead, a day ahead, an hour ahead, and in real time; this is defined using the MarketType. Additionally a price may have one or more components. For example, a locational marginal energy price may be the arithmetic sum of the system price, the congestion price, and the loss price.  The priceType enumeration is used determine if the price is the complete price (priceType=\"total\") or one of potentially many constituent components." .

cim:PricingStructure a rdfs:Class ;
    rdfs:comment "Grouping of pricing components and prices used in the creation of customer charges and the eligibility criteria under which these terms may be offered to a customer. The reasons for grouping include state, customer classification, site characteristics, classification (i.e. fee price structure, deposit price structure, electric service price structure, etc.) and accounting requirements." ;
    rdfs:subClassOf cim:Document .

cim:Priority a rdfs:Class ;
    rdfs:comment "Priority definition." .

cim:Procedure a rdfs:Class ;
    rdfs:comment "Documented procedure for various types of work or work tasks on assets." ;
    rdfs:subClassOf cim:Document .

cim:Process a rdfs:Class ;
    rdfs:comment """The formal specification of a set of business transactions having the same business goal.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ProductAssetModel a rdfs:Class ;
    rdfs:comment "Asset model by a specific manufacturer." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ProductBid a rdfs:Class ;
    rdfs:comment """Component of a bid that pertains to one market product.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ProfileData a rdfs:Class ;
    rdfs:comment """Data for profile.\r
""" .

cim:Project a rdfs:Class ;
    rdfs:comment "A collection of related work. For construction projects and maintenance projects, multiple phases may be performed." ;
    rdfs:subClassOf cim:WorkDocument .

cim:ProjectAlternative a rdfs:Class ;
    rdfs:comment """Project B is an alternative to project A.  Project A is the primary alternative.\r
Multiple project alternatives should not be selected into a single network study case.""" ;
    rdfs:subClassOf cim:NetworkModelProjectRelationship .

cim:ProjectDependency a rdfs:Class ;
    rdfs:comment "Project A change sets should be applied before Project B during case creation. " ;
    rdfs:subClassOf cim:NetworkModelProjectRelationship .

cim:PropertyOrganisationRole a rdfs:Class ;
    rdfs:comment """Role an organisation plays with respect to property (for example, the organisation may be the owner, renter, occupier, taxiing authority, etc.).\r
""" ;
    rdfs:subClassOf cim:OrganisationRole .

cim:PropertyUnit a rdfs:Class ;
    rdfs:comment "Unit of property for reporting purposes." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:ProportionalDistributionComponent a rdfs:Class ;
    rdfs:subClassOf cim:EnergyComponent .

cim:ProprietaryParameterDynamics a rdfs:Class ;
    rdfs:comment """Supports definition of one or more parameters of several different datatypes for use by proprietary user-defined models.  \r
This class does not inherit from IdentifiedObject since it is not intended that a single instance of it be referenced by more than one proprietary user-defined model instance.""" .

cim:ProtectionEquipmentInfo a rdfs:Class ;
    rdfs:comment "Properties of protection equipment asset." ;
    rdfs:subClassOf cim:AssetInfo .

cim:ProtectiveActionAdjustment a rdfs:Class ;
    rdfs:comment "Protective actions on non-switching equipment. The operating condition is adjusted." ;
    rdfs:subClassOf cim:ProtectiveAction .

cim:ProtectiveActionCollection a rdfs:Class ;
    rdfs:comment "A collection of protective actions to protect the integrity of the power system." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ProtectiveActionEquipment a rdfs:Class ;
    rdfs:comment "Protective action to put an Equipment in-service/out-of-service." ;
    rdfs:subClassOf cim:ProtectiveAction .

cim:ProtectiveActionRegulation a rdfs:Class ;
    rdfs:comment "Protective action to change regulation to Equipment." ;
    rdfs:subClassOf cim:ProtectiveAction .

cim:Pss1 a rdfs:Class ;
    rdfs:comment "Italian PSS with three inputs (speed, frequency, power)." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:Pss1A a rdfs:Class ;
    rdfs:comment "Single input power system stabilizer. It is a modified version in order to allow representation of various vendors' implementations on PSS type 1A." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:Pss2B a rdfs:Class ;
    rdfs:comment "Modified IEEE PSS2B.  Extra lead/lag (or rate) block added at end (up to 4 lead/lags total)." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:Pss2ST a rdfs:Class ;
    rdfs:comment "PTI microprocessor-based stabilizer type 1." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:Pss5 a rdfs:Class ;
    rdfs:comment "Detailed Italian PSS." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssELIN2 a rdfs:Class ;
    rdfs:comment "Power system stabilizer typically associated with ExcELIN2 (though PssIEEE2B or Pss2B can also be used)." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssIEEE1A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type PSS1A power system stabilizer model. PSS1A is the generalized form of a PSS with a single input signal. \r
Reference: IEEE 1A 421.5-2005, 8.1. """ ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssIEEE2B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type PSS2B power system stabilizer model. This stabilizer model is designed to represent a variety of dual-input stabilizers, which normally use combinations of power and speed or frequency to derive the stabilizing signal.\r
Reference: IEEE 2B 421.5-2005, 8.2.""" ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssIEEE3B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type PSS3B power system stabilizer model. The PSS model PSS3B has dual inputs of electrical power and rotor angular frequency deviation. The signals are used to derive an equivalent mechanical power signal.\r
This model has 2 input signals. They have the following fixed types (expressed in terms of InputSignalKind values): the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type.\r
Reference: IEEE 3B 421.5-2005, 8.3. \r
\r
""" ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssIEEE4B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type PSS4B power system stabilizer. The PSS4B model represents a structure based on multiple working frequency bands. Three separate bands, respectively dedicated to the low-, intermediate- and high-frequency modes of oscillations, are used in this delta omega (speed input) PSS.\r
There is an error in the in IEEE 421.5-2005 PSS4B model: the <i>Pe</i> input should read –<i>Pe</i>. This implies that the input <i>Pe</i> needs to be multiplied by -1.\r
Reference: IEEE 4B 421.5-2005, 8.4. \r
Parameter details:\r
This model has 2 input signals. They have the following fixed types (expressed in terms of InputSignalKind values): the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type.\r
""" ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssPTIST1 a rdfs:Class ;
    rdfs:comment "PTI microprocessor-based stabilizer type 1." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssPTIST3 a rdfs:Class ;
    rdfs:comment "PTI microprocessor-based stabilizer type 3." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssRQB a rdfs:Class ;
    rdfs:comment "Power system stabilizer type RQB. This power system stabilizer is intended to be used together with excitation system type ExcRQB, which is primarily used in nuclear or thermal generating units." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssSB4 a rdfs:Class ;
    rdfs:comment "Power sensitive stabilizer model." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssSH a rdfs:Class ;
    rdfs:comment """Siemens<sup>TM</sup> “H infinity” power system stabilizer with generator electrical power input.\r
[Footnote: Siemens "H infinity" power system stabilizers are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.] \r
""" ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssSK a rdfs:Class ;
    rdfs:comment "Slovakian PSS with three inputs." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssSTAB2A a rdfs:Class ;
    rdfs:comment """Power system stabilizer part of an ABB excitation system.\r
[Footnote: ABB excitation systems are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.]\r
""" ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PssWECC a rdfs:Class ;
    rdfs:comment "Dual input power system stabilizer, based on IEEE type 2, with modified output limiter defined by WECC (Western Electricity Coordinating Council, USA)." ;
    rdfs:subClassOf cim:PowerSystemStabilizerDynamics .

cim:PublicX509Certificate a rdfs:Class ;
    rdfs:comment "Used to convey information that will allow matching in order to determine which certificate to use.  Actual certificates are exchanged externally to the CIM exchange." .

cim:PumpingCostSchedule a rdfs:Class ;
    rdfs:comment """The operating cost of a Pump Storage Hydro Unit operating as a hydro pump.\r
\r
This schedule is assocated with the hourly parameters in a resource bid associated with a specific product within the bid.\r
""" ;
    rdfs:subClassOf cim:BidHourlyProductSchedule .

cim:PumpingLevelSchedule a rdfs:Class ;
    rdfs:comment """The fixed operating level of a Pump Storage Hydro Unit operating as a hydro pump. Associated with the energy market product type.\r
\r
This schedule is assocated with the hourly parameters in a resource bid associated with a specific product within the bid.\r
""" ;
    rdfs:subClassOf cim:BidHourlyProductSchedule .

cim:PumpingShutDownCostSchedule a rdfs:Class ;
    rdfs:comment """The cost to shutdown a Pump Storage Hydro Unit (in pump mode) or a pump.\r
\r
This schedule is assocated with the hourly parameters in a resource bid associated with a specific product within the bid.\r
""" ;
    rdfs:subClassOf cim:BidHourlyProductSchedule .

cim:Qlimiter a rdfs:Class .

cim:Qmode a rdfs:Class .

cim:Qregulator a rdfs:Class .

cim:QualificationRequirement a rdfs:Class ;
    rdfs:comment " Certain skills are required and must be certified in order for a person (typically a member of a crew) to be qualified to work on types of equipment." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:Quantity a rdfs:Class ;
    rdfs:comment """Description of quantities needed in the data exchange. \r
The type of the quantity is described either by the role of the association or the type attribute.\r
The quality attribute provides the information about the quality of the quantity (measured, estimated, etc.).""" .

cim:RMRDetermination a rdfs:Class ;
    rdfs:comment """Indicates whether unit is a reliablity must run unit: required to be on to satisfy Grid Code Reliablitiy criteria, load demand, or voltage support.\r
""" .

cim:RMRHeatRateCurve a rdfs:Class ;
    rdfs:comment "Model to support processing of reliability must run units." ;
    rdfs:subClassOf cim:Curve .

cim:RMROperatorInput a rdfs:Class ;
    rdfs:comment "RMR Operator's entry of the RMR requirement per market interval." ;
    rdfs:subClassOf cim:MarketFactors .

cim:RMRStartUpCostCurve a rdfs:Class ;
    rdfs:comment "Model to support processing of reliability must run units." ;
    rdfs:subClassOf cim:Curve .

cim:RMRStartUpEnergyCurve a rdfs:Class ;
    rdfs:comment "Model to support processing of reliability must run units." ;
    rdfs:subClassOf cim:Curve .

cim:RMRStartUpFuelCurve a rdfs:Class ;
    rdfs:comment "Model to support processing of reliability must run units." ;
    rdfs:subClassOf cim:Curve .

cim:RMRStartUpTimeCurve a rdfs:Class ;
    rdfs:comment "Model to support processing of reliability must run units." ;
    rdfs:subClassOf cim:Curve .

cim:RTO a rdfs:Class ;
    rdfs:comment "Regional transmission operator." ;
    rdfs:subClassOf cim:MarketParticipant .

cim:RUCAwardInstruction a rdfs:Class ;
    rdfs:comment """This class models the information about the RUC awards.\r
""" .

cim:RUCZone a rdfs:Class ;
    rdfs:comment "A specialized class of type AggregatedNode type. Defines RUC Zones. A forecast region represents a collection of Nodes for which the Market operator has developed sufficient historical demand and relevant weather data to perform a demand forecast for such area. The Market Operator may further adjust this forecast to ensure that the Reliability Unit Commitment produces adequate local capacity procurement." ;
    rdfs:subClassOf cim:AggregateNode .

cim:RaiseLowerCommand a rdfs:Class ;
    rdfs:comment "An analog control that increases or decreases a set point value with pulses. Unless otherwise specified, one pulse moves the set point by one. " ;
    rdfs:subClassOf cim:AnalogControl .

cim:RampRateCurve a rdfs:Class ;
    rdfs:comment "Ramp rate as a function of resource MW output." ;
    rdfs:subClassOf cim:Curve .

cim:Ratio a rdfs:Class ;
    rdfs:comment """Fraction specified explicitly with a numerator and denominator, which can be used to calculate the quotient.\r
""" .

cim:RatioTapChanger a rdfs:Class ;
    rdfs:comment """A tap changer that changes the voltage ratio impacting the voltage magnitude but not the phase angle across the transformer.\r
\r
Angle sign convention (general): Positive value indicates a positive phase shift from the winding where the tap is located to the other winding (for a two-winding transformer).""" ;
    rdfs:subClassOf cim:TapChanger .

cim:RatioTapChangerTable a rdfs:Class ;
    rdfs:comment "Describes a curve for how the voltage magnitude and impedance varies with the tap step. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RatioTapChangerTablePoint a rdfs:Class ;
    rdfs:comment """Describes each tap step in the ratio tap changer tabular curve.\r
""" ;
    rdfs:subClassOf cim:TapChangerTablePoint .

cim:RationalNumber a rdfs:Class ;
    rdfs:comment """Rational number = 'numerator' / 'denominator'.\r
""" .

cim:Reactance a rdfs:Class ;
    rdfs:comment """Reactance (imaginary part of impedance), at rated frequency.\r
""" .

cim:ReactancePerLength a rdfs:Class ;
    rdfs:comment """Reactance (imaginary part of impedance) per unit of length, at rated frequency.\r
""" .

cim:ReactiveCapabilityCurve a rdfs:Class ;
    rdfs:comment "Reactive power rating envelope versus the synchronous machine's active power, in both the generating and motoring modes. For each active power value there is a corresponding high and low reactive power limit  value. Typically there will be a separate curve for each coolant condition, such as hydrogen pressure.  The Y1 axis values represent reactive minimum and the Y2 axis values represent reactive maximum." ;
    rdfs:subClassOf cim:Curve .

cim:ReactivePower a rdfs:Class ;
    rdfs:comment """Product of RMS value of the voltage and the RMS value of the quadrature component of the current.\r
""" .

cim:Reading a rdfs:Class ;
    rdfs:comment """Specific value measured by a meter or other asset, or calculated by a system. Each Reading is associated with a specific ReadingType.\r
""" ;
    rdfs:subClassOf cim:BaseReading .

cim:ReadingInterharmonic a rdfs:Class ;
    rdfs:comment """Interharmonics are represented as a rational number 'numerator' / 'denominator', and harmonics are represented using the same mechanism and identified by 'denominator'=1.\r
""" .

cim:ReadingQuality a rdfs:Class ;
    rdfs:comment """Quality of a specific reading value or interval reading value. Note that more than one quality may be applicable to a given reading. Typically not used unless problems or unusual conditions occur (i.e., quality for each reading is assumed to be good unless stated otherwise in associated reading quality type). It can also be used with the corresponding reading quality type to indicate that the validation has been performed and succeeded.\r
""" .

cim:ReadingQualityType a rdfs:Class ;
    rdfs:comment "Detailed description for a quality of a reading value, produced by an end device or a system. Values in attributes allow for creation of the recommended codes to be used for identifying reading value quality codes as follows: <systemId>.<category>.<subCategory>." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ReadingType a rdfs:Class ;
    rdfs:comment "Detailed description for a type of a reading value. Values in attributes allow for the creation of recommended codes to be used for identifying reading value types as follows: <macroPeriod>.<aggregate>.<measuringPeriod>.<accumulation>.<flowDirection>.<commodity>.<measurementKind>.<interharmonic.numerator>.<interharmonic.denominator>.<argument.numerator>.<argument.denominator>.<tou>.<cpp>.<consumptionTier>.<phases>.<multiplier>.<unit>.<currency>." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RealEnergy a rdfs:Class ;
    rdfs:comment """Real electrical energy.\r
""" .

cim:Reason a rdfs:Class ;
    rdfs:comment """The motivation of an act.\r
""" .

cim:Receipt a rdfs:Class ;
    rdfs:comment """Record of total receipted payment from customer.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RecloseSequence a rdfs:Class ;
    rdfs:comment "A reclose sequence (open and close) is defined for each possible reclosure of a breaker." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Recloser a rdfs:Class ;
    rdfs:comment """Pole-mounted fault interrupter with built-in phase and ground relays, current transformer (CT), and supplemental controls.\r
""" ;
    rdfs:subClassOf cim:ProtectedSwitch .

cim:RecloserInfo a rdfs:Class ;
    rdfs:comment """Properties of recloser assets.\r
""" ;
    rdfs:subClassOf cim:OldSwitchInfo .

cim:Reconditioning a rdfs:Class ;
    rdfs:comment "Reconditioning information for an asset." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RedLine a rdfs:Class ;
    rdfs:comment "This class is used for handling the accompanying annotations, time stamp, author, etc. of designs, drawings and maps. A red line can be associated with any Location object." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Register a rdfs:Class ;
    rdfs:comment """A device that indicates or records units of the commodity or other quantity measured.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RegisteredControllableLoad a rdfs:Class ;
    rdfs:comment "Temporary holding for load reduction attributes removed from RegisteredLoad. Use for future use case when developing the RegisteredDistributedResource specialized classes." .

cim:RegisteredDistributedResource a rdfs:Class ;
    rdfs:comment "A registered resource that represents a distributed energy resource, such as a micro-generator, fuel cell, photo-voltaic energy source, etc. " ;
    rdfs:subClassOf cim:RegisteredResource .

cim:RegisteredInterTie a rdfs:Class ;
    rdfs:comment """This class represents the inter tie resource.\r
""" ;
    rdfs:subClassOf cim:RegisteredResource .

cim:RegisteredLoad a rdfs:Class ;
    rdfs:comment """Model of a load that is registered to participate in the market.\r
\r
RegisteredLoad is used to model any load that is served by the wholesale market directly. RegisteredLoads may be dispatchable or non-dispatchable and may or may not have bid curves. Examples of RegisteredLoads would include: distribution company load, energy retailer load, large bulk power system connected facility load.\r
\r
Loads that are served indirectly, for example - through an energy retailer or a vertical utility, should be modeled as RegisteredDistributedResources. Examples of RegisteredDistributedResources would include: distribution level storage, distribution level generation and distribution level demand response.""" ;
    rdfs:subClassOf cim:RegisteredResource .

cim:RegularTimePoint a rdfs:Class ;
    rdfs:comment """Time point for a schedule where the time between the consecutive points is constant.\r
""" .

cim:RegulatingLimit a rdfs:Class ;
    rdfs:comment """This class represents the physical characteristic of a generator regarding the regulating limit.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Regulation a rdfs:Class ;
    rdfs:comment "Special requirements and/or regulations may pertain to certain types of assets or work. For example, fire protection and scaffolding." ;
    rdfs:subClassOf cim:WorkDocument .

cim:RegulationSchedule a rdfs:Class ;
    rdfs:comment "A pre-established pattern over time for a controlled variable, e.g., busbar voltage." ;
    rdfs:subClassOf cim:SeasonDayTypeSchedule .

cim:RelativeDisplacement a rdfs:Class ;
    rdfs:comment "Vertical displacement relative to either sealevel, ground or the center of the earth." .

cim:ReliabilityInfo a rdfs:Class ;
    rdfs:comment "Information regarding the experienced and expected reliability of a specific asset, type of asset, or asset model." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RemedialActionScheme a rdfs:Class ;
    rdfs:comment "Remedial Action Scheme (RAS), Special Protection Schemes (SPS), System Protection Schemes (SPS) or System Integrity Protection Schemes (SIPS)." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:RemoteConnectDisconnectInfo a rdfs:Class ;
    rdfs:comment """Details of remote connect and disconnect function.\r
""" .

cim:RemoteControl a rdfs:Class ;
    rdfs:comment "Remote controls are outputs that are sent by the remote unit to actuators in the process." ;
    rdfs:subClassOf cim:RemotePoint .

cim:RemoteInputSignal a rdfs:Class ;
    rdfs:comment "Supports connection to a terminal associated with a remote bus from which an input signal of a specific type is coming." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RemoteSource a rdfs:Class ;
    rdfs:comment "Remote sources are state variables that are telemetered or calculated within the remote unit." ;
    rdfs:subClassOf cim:RemotePoint .

cim:RemoteUnit a rdfs:Class ;
    rdfs:comment "A remote unit can be an RTU, IED, substation control system, control centre, etc. The communication with the remote unit can be through various standard protocols (e.g. IEC 61870, IEC 61850) or non standard protocols (e.g. DNP, RP570, etc.). A remote unit contains remote data points that might be telemetered, collected or calculated. The RemoteUnit class inherits PowerSystemResource. The intention is to allow RemoteUnits to have Measurements. These Measurements can be used to model unit status as operational, out of service, unit failure, etc." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:RepairItem a rdfs:Class ;
    rdfs:comment "Asset component to be repaired or problem area to be corrected." .

cim:RepairWorkTask a rdfs:Class ;
    rdfs:comment "Work task for asset repair. Costs associated with this are considered corrective maintenance (CM) costs." ;
    rdfs:subClassOf cim:WorkTask .

cim:ReportingCapability a rdfs:Class ;
    rdfs:comment "<font color=\"#0f0f0f\">Definition of one set of reporting capabilities for this monitoring station. The associated EnvironmentalValueSets describe the maximum range of possible environmental values the station is capable of returning.  This attribute is intended primarily to assist a utility in managing its stations. </font>" .

cim:ReportingGroup a rdfs:Class ;
    rdfs:comment """A reporting group is used for various ad-hoc groupings used for reporting.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ReportingSuperGroup a rdfs:Class ;
    rdfs:comment "A reporting super group, groups reporting groups for a higher level report." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ReserveDemandCurve a rdfs:Class ;
    rdfs:comment "Reserve demand curve.  Models maximum quantities of reserve required per Market Region and models a reserve demand curve for the minimum quantities of reserve. The ReserveDemandCurve is a relationship between unit operating reserve price in $/MWhr (Y-axis) and unit reserves in MW (X-axis)." ;
    rdfs:subClassOf cim:Curve .

cim:ReserveReq a rdfs:Class ;
    rdfs:comment """Requirements for minimum amount of reserve and/or regulation to be supplied by a set of qualified resources.\r
""" ;
    rdfs:subClassOf cim:ResourceGroupReq .

cim:ReserveReqCurve a rdfs:Class ;
    rdfs:comment """A curve relating  reserve requirement versus time, showing the values of a specific reserve requirement for each unit of the period covered. The  curve can be based on "absolute" time or on "normalized' time. \r
X is time, typically expressed in absolute time\r
Y1 is reserve requirement, typically expressed in MW\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:Reservoir a rdfs:Class ;
    rdfs:comment """A water storage facility within a hydro system, including: ponds, lakes, lagoons, and rivers. The storage is usually behind some type of dam.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:Resistance a rdfs:Class ;
    rdfs:comment """Resistance (real part of impedance).\r
""" .

cim:ResistancePerLength a rdfs:Class ;
    rdfs:comment """Resistance (real part of impedance) per unit of length.\r
""" .

cim:ResourceAwardClearing a rdfs:Class ;
    rdfs:comment """Models details of bid and offer market clearing. Class indicates whether a contingency is active and whether the automatic dispatching system is active for this interval of the market solution.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ResourceAwardInstruction a rdfs:Class ;
    rdfs:comment """Model of market results, instruction for resource.  Contains details of award as attributes.\r
""" .

cim:ResourceCapacity a rdfs:Class ;
    rdfs:comment "This class model the various capacities of a resource. A resource may have numbers of capacities related to operating, ancillary services, energy trade and so forth. Capacities may be defined for active power or reactive power." .

cim:ResourceCertification a rdfs:Class ;
    rdfs:comment "Specifies certification for a resource to participate in a specific markets." .

cim:ResourceClearing a rdfs:Class ;
    rdfs:comment """Model of market results, including cleaing result of resources. Associated with ResourceDispatchResults.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ResourceDeploymentStatus a rdfs:Class .

cim:ResourceDispatchResults a rdfs:Class ;
    rdfs:comment """The ResourceDispatchResults class provides market results that can be provided to a SC. The specific data provided consists of several indicators such as contingency flags, blocked start up, and RMR dispatch. It also provides the projected overall and the regulating status of the resource.\r
""" .

cim:ResourceGroup a rdfs:Class ;
    rdfs:comment """A logical grouping of resources that are used to model location of types of requirements for ancillary services such as spinning reserve zones, regulation zones, etc.  \r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ResourceLoadFollowingInst a rdfs:Class ;
    rdfs:comment """Model of market clearing results for resources that bid to follow load.\r
""" .

cim:ResourceOperationMaintenanceCost a rdfs:Class ;
    rdfs:comment "To model the Operation and Maintenance (O and M) costs of a generation resource." ;
    rdfs:subClassOf cim:Curve .

cim:ResourcePerformanceEvaluation a rdfs:Class ;
    rdfs:comment "Represents an the performance evaluation of a resource deployment. Every resource deployment may have many performance evaluations, using different evaluation metrics or algorithms, or produced by different evaluation authorities." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ResourcePerformanceGlobalFactor a rdfs:Class ;
    rdfs:comment "Global factors are property/value pairs that are used to adjust resource performance values. Example include scale factors (e.g. scale a baseline up or down), adders (positive or negative), etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ResourcePerformanceRating a rdfs:Class ;
    rdfs:comment "Rating of a resource for its demand response performance. e.g. given a set on monthly resource demand response performance evaluations, the resource may be rated with excellent, average, or poor performance for the sample set." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ResourcePerformanceTimeSeriesFactor a rdfs:Class ;
    rdfs:comment "Represents the performance of a resource as time series data for a specified time period, time interval, and evaluation criteria." ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:ResourceStartupCost a rdfs:Class ;
    rdfs:comment """To model the startup costs of a generation resource.\r
""" .

cim:ResourceVerifiableCosts a rdfs:Class ;
    rdfs:comment """This class is defined to describe the verifiable costs associated with a generation resource.\r
""" .

cim:ResponseMethod a rdfs:Class ;
    rdfs:comment "Specifies a category of energy usage that the demand response applies for; e.g. energy from lighting, HVAC, other." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RevisionHistory a rdfs:Class ;
    rdfs:comment "History of changes made to a switching plan step after the switching plan has been approved." .

cim:RightOfWay a rdfs:Class ;
    rdfs:comment " A right-of-way (ROW) is for land where it is lawful to use for a public road, an electric power line, etc. Note that the association to Location, Asset, Organisation, etc. for the Grant is inherited from Agreement, a type of Document." ;
    rdfs:subClassOf cim:Agreement .

cim:RiskScore a rdfs:Class ;
    rdfs:comment "Score that is indicative of the risk associated with one or more assets." ;
    rdfs:subClassOf cim:AggregateScore .

cim:RotationSpeed a rdfs:Class ;
    rdfs:comment """Number of revolutions per second.\r
""" .

cim:Route a rdfs:Class ;
    rdfs:comment """Route that is followed, for example by service crews.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:SCADAInformation a rdfs:Class ;
    rdfs:comment """Contains information about the update from SCADA.\r
""" .

cim:SVC a rdfs:Class ;
    rdfs:comment """SVC asset allows the capacitive and inductive ratings for each phase to be specified individually if required.\r
""" ;
    rdfs:subClassOf cim:ShuntCompensator .

cim:SVCUserDefined a rdfs:Class ;
    rdfs:comment "Static var compensator (SVC) function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:StaticVarCompensatorDynamics .

cim:ScheduledActivePowerLimitValue a rdfs:Class ;
    rdfs:subClassOf cim:ScheduledLimitValue .

cim:ScheduledApparentPowerLimitValue a rdfs:Class ;
    rdfs:comment "A time scheduled value for apparent power limit." ;
    rdfs:subClassOf cim:ScheduledLimitValue .

cim:ScheduledCurrentLimitValue a rdfs:Class ;
    rdfs:comment "A current limit that is scheduled." ;
    rdfs:subClassOf cim:ScheduledLimitValue .

cim:ScheduledEvent a rdfs:Class ;
    rdfs:comment "An event to trigger one or more activities, such as reading a meter, recalculating a bill, requesting work, when generating units must be scheduled for maintenance, when a transformer is scheduled to be refurbished, etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ScheduledEventData a rdfs:Class ;
    rdfs:comment """Schedule parameters for an activity that is to occur, is occurring, or has completed.\r
""" .

cim:ScheduledLimitDependency a rdfs:Class ;
    rdfs:subClassOf cim:LimitDependency .

cim:ScheduledVoltageLimitValue a rdfs:Class ;
    rdfs:comment "A voltage limit value for a scheduled time." ;
    rdfs:subClassOf cim:ScheduledLimitValue .

cim:SchedulingCoordinator a rdfs:Class ;
    rdfs:comment "Market participants could be represented by Scheduling Coordinators (SCs) that are registered with the RTO/ISO. One participant could register multiple SCs with the RTO/ISO. Many market participants can do business with the RTO/ISO using a single SC. One SC could schedule multiple generators. A load scheduling point could be used by multiple SCs. Each SC could schedule load at multiple scheduling points. An inter-tie scheduling point can be used by multiple SCs. Each SC can schedule interchange at multiple inter-tie scheduling points." ;
    rdfs:subClassOf cim:MarketParticipant .

cim:SchedulingCoordinatorUser a rdfs:Class ;
    rdfs:comment "Describing users of a Scheduling Coordinator." .

cim:SchedulingPoint a rdfs:Class ;
    rdfs:comment "Connection to other organizations at the boundary of the ISO/RTO." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Seal a rdfs:Class ;
    rdfs:comment """Physically controls access to AssetContainers.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Season a rdfs:Class ;
    rdfs:comment "A specified time period of the year." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Seconds a rdfs:Class ;
    rdfs:comment """Time, in seconds.\r
""" .

cim:Sectionaliser a rdfs:Class ;
    rdfs:comment """Automatic switch that will lock open to isolate a faulted section. It may, or may not, have load breaking capability. Its primary purpose is to provide fault sectionalising at locations where the fault current is either too high, or too low, for proper coordination of fuses.\r
""" ;
    rdfs:subClassOf cim:Switch .

cim:SecurityConstraintSum a rdfs:Class ;
    rdfs:comment """Typically provided by RTO systems, constraints identified in both base case and critical contingency cases have to be transferred.\r
A constraint has N (&gt;=1) constraint terms. A term is represented by an instance of TerminalConstraintTerm. \r
The constraint expression is:\r
minValue &lt;= c1*x1 + c2*x2 + .... cn*xn + k &lt;= maxValue\r
where:\r
- cn is ConstraintTerm.factor \r
- xn is the flow at the terminal\r
Flow into the associated equipment is positive for the purpose of ConnectivityNode NodeConstraintTerm.\r
\r
k is SecurityConstraintsLinear.resourceMW.\r
The units of k are assumed to be same as the units of the flows, xn.  The constants, cn, are dimensionless.\r
With these conventions, cn and k are all positive for a typical constraint such as "weighted sum of generation shall be less than limit". Furthermore, cn are all 1.0 for a case such as "interface flow shall be less than limit", assuming the terminals are chosen on the importing side of the interface.""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:SecurityConstraints a rdfs:Class ;
    rdfs:comment """Typical for regional transmission operators (RTOs), these constraints include transmission as well as generation group constraints identified in both base case and critical contingency cases.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:SecurityConstraintsClearing a rdfs:Class ;
    rdfs:comment """Binding security constrained clearing results posted for a given settlement period.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:SelfScheduleBreakdown a rdfs:Class ;
    rdfs:comment """Model of Self Schedules Results.  Includes self schedule MW,and type of self schedule for each self schedule type included in total self schedule MW value found in ResourceAwardInstruction.\r
""" .

cim:SensitivityPriceCurve a rdfs:Class ;
    rdfs:comment """Optionally, this curve expresses elasticity of the associated requirement.  For example, used to reduce requirements when clearing price exceeds reasonable values when the supply quantity becomes scarce. For example, a single point value of $1000/MW for a spinning reserve will cause a reduction in the required spinning reserve. \r
X axis is constrained quantity (e.g., MW)\r
Y1 axis is money per constrained quantity\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:Series a rdfs:Class ;
    rdfs:comment "A set of similar physical or conceptual objects defined for the same period or point of time." ;
    rdfs:subClassOf cim:TimeSeries .

cim:SeriesEquipmentDependentLimit a rdfs:Class ;
    rdfs:comment """Limit based on most restrictive series equipment limit.\r
A specification of  of equipment that determines the calculated operational limit values based upon other equipment and their ratings.  The most restrictive limit connected in series within the group is used.   The physical connection based on switch status for example may also impact which elements in the group are considered. Any equipment in the group that are presently connected in series with the equipment of the directly associated operational limit are used.   This provides a means to indicate which potentially series equipment limits are considered for a computed operational limit. The operational limit of the same operational limit type is assumed to be used from the grouped equipment.   It is also possible to make assumptions or calculations regarding how flow might split if the equipment is not simply in series.""" ;
    rdfs:subClassOf cim:LimitDependency .

cim:ServiceCategory a rdfs:Class ;
    rdfs:comment "Category of service provided to the customer." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ServiceGuarantee a rdfs:Class ;
    rdfs:comment """A service guarantee, often imposed by a regulator, defines conditions that, if not satisfied, will result in the utility making a monetary payment to the customer. Note that guarantee's identifier is in the 'name' attribute and the status of the guarantee is in the 'Status.status' attribute.\r
Example service requirements include:\r
1) If power is not restored within 24 hours, customers can claim $50 for residential customers or $100 for commercial and industrial customers. In addition for each extra period of 12 hours the customer's supply has not been activated, the customer can claim $25.\r
2) If a customer has a question about their electricity bill, the utility will investigate and respond to the inquiry within 15 working days. If utility fails to meet its guarantee, utility will automatically pay the customer $50.""" ;
    rdfs:subClassOf cim:Document .

cim:ServiceLocation a rdfs:Class ;
    rdfs:comment "A real estate location, commonly referred to as premises." ;
    rdfs:subClassOf cim:WorkLocation .

cim:ServiceMultiplier a rdfs:Class ;
    rdfs:comment """Multiplier applied at the usage point.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ServiceOrder a rdfs:Class ;
    rdfs:subClassOf cim:WorkOrder .

cim:ServicePoint a rdfs:Class ;
    rdfs:comment "The defined termination points of a transmission path. Service points are defined from the viewpoint of the transmission service. Each service point is contained within (or on the boundary of) an interchange area. A service point is source or destination of a transaction." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ServicePointOutageSummary a rdfs:Class ;
    rdfs:comment "Summary counts of service points affected by an outage. These counts are sometimes referred to as total and critical customer count." .

cim:ServiceRequest a rdfs:Class ;
    rdfs:subClassOf cim:WorkRequest .

cim:ServiceSupplier a rdfs:Class ;
    rdfs:comment "Organisation that provides services to customers." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:SetPoint a rdfs:Class ;
    rdfs:comment "An analog control that issues a set point value." ;
    rdfs:subClassOf cim:AnalogControl .

cim:Settlement a rdfs:Class ;
    rdfs:comment """Specifies a settlement run.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:ShiftPattern a rdfs:Class ;
    rdfs:comment "The patterns of shifts worked by people or crews." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:ShortCircuitTest a rdfs:Class ;
    rdfs:comment "Short-circuit test results determine mesh impedance parameters. They include load losses and leakage impedances. For three-phase windings, the excitation can be a positive sequence (the default) or a zero sequence. There shall be at least one grounded winding." ;
    rdfs:subClassOf cim:TransformerTest .

cim:ShuntCompensatorAction a rdfs:Class ;
    rdfs:subClassOf cim:SwitchingAction .

cim:ShuntCompensatorControl a rdfs:Class ;
    rdfs:comment "Distribution capacitor bank control settings." ;
    rdfs:subClassOf cim:RegulatingControl .

cim:ShuntCompensatorDynamicData a rdfs:Class ;
    rdfs:comment """Optimal Power Flow or State Estimator Filter Bank Data for OTS. This is used for RealTime, Study and Maintenance Users.\r
""" .

cim:ShuntCompensatorInfo a rdfs:Class ;
    rdfs:comment "Properties of shunt capacitor, shunt reactor or switchable bank of shunt capacitor or reactor assets." ;
    rdfs:subClassOf cim:AssetInfo .

cim:ShutdownCurve a rdfs:Class ;
    rdfs:comment """Relationship between the rate in gross active power/minute (Y-axis) at which a unit should be shutdown and its present gross MW output (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:SimpleEndDeviceFunction a rdfs:Class ;
    rdfs:comment """Simple end device function distinguished by 'kind'. Use this class for instances that cannot be represented by another end device function specialisations.\r
""" ;
    rdfs:subClassOf cim:EndDeviceFunction .

cim:Skill a rdfs:Class ;
    rdfs:comment """Proficiency level of a craft, which is required to operate or maintain a particular type of asset and/or perform certain types of work. \r
""" ;
    rdfs:subClassOf cim:Document .

cim:SolarGeneratingUnit a rdfs:Class ;
    rdfs:comment "A solar thermal generating unit, connected to the grid by means of a rotating machine.  This class does not represent photovoltaic (PV) generation." ;
    rdfs:subClassOf cim:GeneratingUnit .

cim:SpaceAnalog a rdfs:Class ;
    rdfs:comment "Analog (float) measuring a space (extra-terrestrial) condition." ;
    rdfs:subClassOf cim:EnvironmentalAnalog .

cim:Specification a rdfs:Class ;
    rdfs:comment "Specification can be used for various purposes relative to an asset, a logical device (PowerSystemResource), location, etc. Examples include documents supplied by manufacturers such as asset installation instructions, asset maintenance instructions, etc." ;
    rdfs:subClassOf cim:Document .

cim:Speed a rdfs:Class ;
    rdfs:comment """Distance per unit of time.\r
""" .

cim:Stage a rdfs:Class ;
    rdfs:comment "Stage of a remedial action scheme." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:StageTrigger a rdfs:Class ;
    rdfs:comment "Condition that is triggered either by TriggerCondition of by gate condition within a stage and has remedial action-s." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:StandardIndustryCode a rdfs:Class ;
    rdfs:comment """The Standard Industrial Classification (SIC) are the codes that identify the type of products/service an industry is involved in, and used for statutory reporting purposes. For example, in the USA these codes are located by the federal government, and then published in a book entitled "The Standard Industrial Classification Manual". The codes are arranged in a hierarchical structure.\r
Note that Residential Service Agreements are not classified according to the SIC codes.""" ;
    rdfs:subClassOf cim:Document .

cim:StartIgnFuelCurve a rdfs:Class ;
    rdfs:comment """The quantity of ignition fuel (Y-axis) used to restart and repay the auxiliary power consumed versus the number of hours (X-axis) the unit was off line.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:StartMainFuelCurve a rdfs:Class ;
    rdfs:comment """The quantity of main fuel (Y-axis) used to restart and repay the auxiliary power consumed versus the number of hours (X-axis) the unit was off line.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:StartRampCurve a rdfs:Class ;
    rdfs:comment "Rate in gross active power per minute (Y-axis) at which a unit can be loaded versus the number of hours (X-axis) the unit was off line." ;
    rdfs:subClassOf cim:Curve .

cim:StartUpCostCurve a rdfs:Class ;
    rdfs:comment """Startup costs and time as a function of down time.  Relationship between unit startup cost (Y1-axis) vs. unit elapsed down time (X-axis). \r
""" ;
    rdfs:subClassOf cim:Curve .

cim:StartUpEnergyCurve a rdfs:Class ;
    rdfs:comment """The energy consumption of a generating resource to complete a start-up from the StartUpEnergyCurve. Definition of the StartUpEnergyCurve includes, xvalue as the cooling time and y1value as the MW value.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:StartUpFuelCurve a rdfs:Class ;
    rdfs:comment """The fuel consumption of a Generating Resource to complete a Start-Up.(x=cooling time) Form Startup Fuel Curve. xAxisData -&gt; cooling time, y1AxisData -&gt; MBtu.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:StartUpTimeCurve a rdfs:Class ;
    rdfs:comment """Startup time curve as a function of down time, where time is specified in minutes.  Relationship between unit startup time (Y1-axis) vs. unit elapsed down time (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:StartupModel a rdfs:Class ;
    rdfs:comment """Unit start up characteristics depending on how long the unit has been off line.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:StaticVarCompensator a rdfs:Class ;
    rdfs:comment """A facility for providing variable and controllable shunt reactive power. The SVC typically consists of a stepdown transformer, filter, thyristor-controlled reactor, and thyristor-switched capacitor arms.\r
\r
The SVC may operate in fixed MVar output mode or in voltage control mode. When in voltage control mode, the output of the SVC will be proportional to the deviation of voltage at the controlled bus from the voltage setpoint.  The SVC characteristic slope defines the proportion.  If the voltage at the controlled bus is equal to the voltage setpoint, the SVC MVar output is zero.""" ;
    rdfs:subClassOf cim:RegulatingCondEq .

cim:StationSupply a rdfs:Class ;
    rdfs:comment "Station supply with load derived from the station output." ;
    rdfs:subClassOf cim:EnergyConsumer .

cim:Status a rdfs:Class ;
    rdfs:comment """Current status information relevant to an entity.\r
""" .

cim:SteamSendoutSchedule a rdfs:Class ;
    rdfs:comment "The cogeneration plant's steam sendout schedule in volume per time unit." ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:SteamTurbine a rdfs:Class ;
    rdfs:comment """Steam turbine.\r
""" ;
    rdfs:subClassOf cim:PrimeMover .

cim:StreetAddress a rdfs:Class ;
    rdfs:comment "General purpose street and postal address information." .

cim:StreetDetail a rdfs:Class ;
    rdfs:comment """Street details, in the context of address.\r
""" .

cim:Streetlight a rdfs:Class ;
    rdfs:comment """Streetlight asset.\r
""" ;
    rdfs:subClassOf cim:Asset .

cim:StringQuantity a rdfs:Class ;
    rdfs:comment "Quantity with string value (when it is not important whether it is an integral or a floating point number) and associated unit information." .

cim:StructureSupport a rdfs:Class ;
    rdfs:comment """Support for structure assets.\r
""" ;
    rdfs:subClassOf cim:Asset .

cim:SubControlArea a rdfs:Class ;
    rdfs:comment "An area defined for the purpose of tracking interchange with surrounding areas via tie points; may or may not serve as a control area." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:SubGeographicalRegion a rdfs:Class ;
    rdfs:comment """A subset of a geographical region of a power system network model.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:SubLoadArea a rdfs:Class ;
    rdfs:comment "The class is the second level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling." ;
    rdfs:subClassOf cim:EnergyArea .

cim:Subcritical a rdfs:Class ;
    rdfs:comment """Once-through subcritical boiler.\r
""" ;
    rdfs:subClassOf cim:FossilSteamSupply .

cim:SubscribePowerCurve a rdfs:Class ;
    rdfs:comment "Price curve for specifying the cost of energy (X) at points in time (y1) according to a prcing structure, which is based on a tariff." ;
    rdfs:subClassOf cim:Curve .

cim:Substation a rdfs:Class ;
    rdfs:comment """A collection of equipment for purposes other than generation or utilization, through which electric energy in bulk is passed for the purposes of switching or modifying its characteristics. \r
""" ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:SubstitutionResourceList a rdfs:Class ;
    rdfs:comment """List of resources that can be substituted for within the bounds of a Contract definition. This class has a precedence and a resource.\r
""" .

cim:Supercritical a rdfs:Class ;
    rdfs:comment """Once-through supercritical boiler.\r
""" ;
    rdfs:subClassOf cim:FossilSteamSupply .

cim:SurgeArrester a rdfs:Class ;
    rdfs:comment "Shunt device, installed on the network, usually in the proximity of electrical equipment in order to protect the said equipment against transient voltage transients caused by lightning or switching activity." ;
    rdfs:subClassOf cim:AuxiliaryEquipment .

cim:SurgeArresterInfo a rdfs:Class ;
    rdfs:comment "Properties of surge arrester." ;
    rdfs:subClassOf cim:AssetInfo .

cim:Susceptance a rdfs:Class ;
    rdfs:comment "Imaginary part of admittance." .

cim:SusceptancePerLength a rdfs:Class ;
    rdfs:comment """Imaginary part of admittance per unit of length.\r
""" .

cim:SvInjection a rdfs:Class ;
    rdfs:comment "The SvInjection reports the calculated bus injection minus the sum of the terminal flows. The terminal flow is positive out from the bus (load sign convention) and bus injection has positive flow into the bus. SvInjection may have the remainder after state estimation or slack after power flow calculation." ;
    rdfs:subClassOf cim:StateVariable .

cim:SvPowerFlow a rdfs:Class ;
    rdfs:comment "State variable for power flow. Load convention is used for flow direction. This means flow out from the TopologicalNode into the equipment is positive." ;
    rdfs:subClassOf cim:StateVariable .

cim:SvShuntCompensatorSections a rdfs:Class ;
    rdfs:comment "State variable for the number of sections in service for a shunt compensator." ;
    rdfs:subClassOf cim:StateVariable .

cim:SvStatus a rdfs:Class ;
    rdfs:comment "State variable for status." ;
    rdfs:subClassOf cim:StateVariable .

cim:SvSwitch a rdfs:Class ;
    rdfs:comment "State variable for switch. " ;
    rdfs:subClassOf cim:StateVariable .

cim:SvTapStep a rdfs:Class ;
    rdfs:comment "State variable for transformer tap step. " ;
    rdfs:subClassOf cim:StateVariable .

cim:SvVoltage a rdfs:Class ;
    rdfs:comment "State variable for voltage." ;
    rdfs:subClassOf cim:StateVariable .

cim:SwitchAction a rdfs:Class ;
    rdfs:comment "Action on switch as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:SwitchOperationSummary a rdfs:Class ;
    rdfs:comment "Up-to-date, of-record summary of switch operation information, distilled from a variety of sources (real-time data or real-time data historian, field inspections, etc.) of use to asset health analytics.  " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:SwitchPhase a rdfs:Class ;
    rdfs:comment """Single phase of a multi-phase switch when its attributes might be different per phase.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:SwitchSchedule a rdfs:Class ;
    rdfs:comment "A schedule of switch positions.  If RegularTimePoint.value1 is 0, the switch is open.  If 1, the switch is closed.  " ;
    rdfs:subClassOf cim:SeasonDayTypeSchedule .

cim:SwitchStatus a rdfs:Class ;
    rdfs:comment """Optimal Power Flow or State Estimator Circuit Breaker Status.\r
""" .

cim:SwitchingEvent a rdfs:Class ;
    rdfs:comment "Event indicating the completion (success or fail) of any switching action (jumper action, cut action, tag action, etc).  The switching action may or may not be a consequential event in response to a request to complete the action. " ;
    rdfs:subClassOf cim:ActivityRecord .

cim:SwitchingOrder a rdfs:Class ;
    rdfs:comment "Transmits a switching plan to a crew in order for the plan to be executed." ;
    rdfs:subClassOf cim:Document .

cim:SwitchingPlan a rdfs:Class ;
    rdfs:comment """A sequence of grouped or atomic steps intended to:\r
- de-energise equipment or part of the network for safe work, and/or\r
- bring back in service previously de-energised equipment or part of the network.""" ;
    rdfs:subClassOf cim:Document .

cim:SwitchingPlanRequest a rdfs:Class ;
    rdfs:comment "A document used to request that a switching plan be created for a particular purpose." ;
    rdfs:subClassOf cim:Document .

cim:SwitchingStep a rdfs:Class ;
    rdfs:comment "Atomic switching step; can be part of a switching step group, or part of a switching plan." .

cim:SwitchingStepGroup a rdfs:Class ;
    rdfs:comment "A logical step, grouping atomic switching steps that are important to distinguish when they may change topology (e.g. placing a jumper between two cuts)." .

cim:SynchrocheckRelay a rdfs:Class ;
    rdfs:comment "A device that operates when two AC circuits are within the desired limits of frequency, phase angle, and voltage, to permit or to cause the paralleling of these two circuits. Used to prevent the paralleling of non-synchronous topological islands." ;
    rdfs:subClassOf cim:ProtectionEquipment .

cim:SynchronousMachine a rdfs:Class ;
    rdfs:comment "An electromechanical device that operates with shaft rotating synchronously with the network. It is a single machine operating either as a generator or synchronous condenser or pump." ;
    rdfs:subClassOf cim:RotatingMachine .

cim:SynchronousMachineEquivalentCircuit a rdfs:Class ;
    rdfs:comment """The electrical equations for all variations of the synchronous models are based on the SynchronousEquivalentCircuit diagram for the direct- and quadrature- axes.\r
Equations for conversion between equivalent circuit and time constant reactance forms:\r
<i>Xd</i> = <i>Xad </i>+<i> Xl</i>\r
<i>X’d</i> = <i>Xl</i> + <i>Xad</i> x <i>Xfd</i> / (<i>Xad</i> + <i>Xfd</i>)\r
<i>X”d</i> = <i>Xl</i> + <i>Xad</i> x <i>Xfd</i> x <i>X1d</i> / (<i>Xad</i> x <i>Xfd</i> + <i>Xad</i> x <i>X1d</i> + <i>Xfd</i> x <i>X1d</i>)\r
<i>Xq</i> = <i>Xaq</i> + <i>Xl</i>\r
<i>X’q</i> = <i>Xl</i> + <i>Xaq</i> x <i>X1q</i> / (<i>Xaq</i> + <i>X1q</i>)\r
<i>X”q</i> = <i>Xl</i> + <i>Xaq</i> x <i>X1q</i> x <i>X2q</i> / (<i>Xaq</i> x <i>X1q</i> + <i>Xaq</i> x <i>X2q</i> + <i>X1q</i> x <i>X2q</i>)\r
<i>T’do</i> = (<i>Xad</i> + <i>Xfd</i>) / (<i>omega</i><i><sub>0</sub></i> x <i>Rfd</i>)\r
<i>T”do</i> = (<i>Xad</i> x <i>Xfd</i> + <i>Xad</i> x <i>X1d</i> + <i>Xfd</i> x <i>X1d</i>) / (<i>omega</i><i><sub>0</sub></i> x <i>R1d</i> x (<i>Xad</i> + <i>Xfd</i>)\r
<i>T’qo</i> = (<i>Xaq</i> + <i>X1q</i>) / (<i>omega</i><i><sub>0</sub></i> x <i>R1q</i>)\r
<i>T”qo</i> = (<i>Xaq</i> x <i>X1q</i> + <i>Xaq</i> x <i>X2q</i> + <i>X1q</i> x <i>X2q</i>) / (<i>omega</i><i><sub>0</sub></i> x <i>R2q</i> x (<i>Xaq</i> + <i>X1q</i>)\r
Same equations using CIM attributes from SynchronousMachineTimeConstantReactance class on left of "=" and SynchronousMachineEquivalentCircuit class on right (except as noted):\r
xDirectSync = xad + RotatingMachineDynamics.statorLeakageReactance\r
xDirectTrans = RotatingMachineDynamics.statorLeakageReactance + xad x xfd / (xad + xfd)\r
xDirectSubtrans = RotatingMachineDynamics.statorLeakageReactance + xad x xfd x x1d / (xad x xfd + xad x x1d + xfd x x1d)\r
xQuadSync = xaq + RotatingMachineDynamics.statorLeakageReactance\r
xQuadTrans = RotatingMachineDynamics.statorLeakageReactance + xaq x x1q / (xaq+ x1q)\r
xQuadSubtrans = RotatingMachineDynamics.statorLeakageReactance + xaq x x1q x x2q / (xaq x x1q + xaq x x2q + x1q x x2q) \r
tpdo = (xad + xfd) / (2 x pi x nominal frequency x rfd)\r
tppdo = (xad x xfd + xad x x1d + xfd x x1d) / (2 x pi x nominal frequency x r1d x (xad + xfd)\r
tpqo = (xaq + x1q) / (2 x pi x nominal frequency x r1q)\r
tppqo = (xaq x x1q + xaq x x2q + x1q x x2q) / (2 x pi x nominal frequency x r2q x (xaq + x1q)\r
These are only valid for a simplified model where "Canay" reactance is zero.""" ;
    rdfs:subClassOf cim:SynchronousMachineDetailed .

cim:SynchronousMachineSimplified a rdfs:Class ;
    rdfs:comment """The simplified model represents a synchronous generator as a constant internal voltage behind an impedance<i> </i>(<i>Rs + jXp</i>) as shown in the Simplified diagram.\r
Since internal voltage is held constant, there is no <i>Efd</i> input and any excitation system model will be ignored.  There is also no <i>Ifd</i> output.\r
This model should not be used for representing a real generator except, perhaps, small generators whose response is insignificant.  \r
The parameters used for the simplified model include:\r
- RotatingMachineDynamics.damping (<i>D</i>);\r
- RotatingMachineDynamics.inertia (<i>H</i>);\r
- RotatingMachineDynamics.statorLeakageReactance (used to exchange <i>jXp </i>for SynchronousMachineSimplified);\r
- RotatingMachineDynamics.statorResistance (<i>Rs</i>).""" ;
    rdfs:subClassOf cim:SynchronousMachineDynamics .

cim:SynchronousMachineTimeConstantReactance a rdfs:Class ;
    rdfs:comment """Synchronous machine detailed modelling types are defined by the combination of the attributes SynchronousMachineTimeConstantReactance.modelType and SynchronousMachineTimeConstantReactance.rotorType.  \r
Parameter details:\r
<ol>\r
	<li>The “p” in the time-related attribute names is a substitution for a “prime” in the usual parameter notation, e.g. tpdo refers to <i>T'do</i>.</li>\r
	<li>The parameters used for models expressed in time constant reactance form include:</li>\r
</ol>\r
- RotatingMachine.ratedS (<i>MVAbase</i>);\r
- RotatingMachineDynamics.damping (<i>D</i>);\r
- RotatingMachineDynamics.inertia (<i>H</i>);\r
- RotatingMachineDynamics.saturationFactor (<i>S1</i>);\r
- RotatingMachineDynamics.saturationFactor120 (<i>S12</i>);\r
- RotatingMachineDynamics.statorLeakageReactance (<i>Xl</i>);\r
- RotatingMachineDynamics.statorResistance (<i>Rs</i>);\r
- SynchronousMachineTimeConstantReactance.ks (<i>Ks</i>);\r
- SynchronousMachineDetailed.saturationFactorQAxis (<i>S1q</i>);\r
- SynchronousMachineDetailed.saturationFactor120QAxis (<i>S12q</i>);\r
- SynchronousMachineDetailed.efdBaseRatio;\r
- SynchronousMachineDetailed.ifdBaseType;\r
- .xDirectSync (<i>Xd</i>);\r
- .xDirectTrans (<i>X'd</i>);\r
- .xDirectSubtrans (<i>X''d</i>);\r
- .xQuadSync (<i>Xq</i>);\r
- .xQuadTrans (<i>X'q</i>);\r
- .xQuadSubtrans (<i>X''q</i>);\r
- .tpdo (<i>T'do</i>);\r
- .tppdo (<i>T''do</i>);\r
- .tpqo (<i>T'qo</i>);\r
- .tppqo (<i>T''qo</i>);\r
- .tc.""" ;
    rdfs:subClassOf cim:SynchronousMachineDetailed .

cim:SynchronousMachineUserDefined a rdfs:Class ;
    rdfs:comment "Synchronous machine whose dynamic behaviour is described by a user-defined model." ;
    rdfs:subClassOf cim:SynchronousMachineDynamics .

cim:SysLoadDistributionFactor a rdfs:Class ;
    rdfs:comment """This class models the system distribution factors. This class needs to be used along with the HostControlArea and the ConnectivityNode to show the distribution of each individual party.\r
""" .

cim:TACArea a rdfs:Class ;
    rdfs:comment "Transmission Access Charge Area. Charges assessed, on behalf of the Participating Transmission Owner, to parties who require access to the controlled grid." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TAPPIStandard a rdfs:Class ;
    rdfs:comment "Standard published by TAPPI. " .

cim:TASE2BilateralTable a rdfs:Class ;
    rdfs:comment "This class describe the sending (providing) side in a bilateral ICCP data exchange. Hence the ICCP bilateral (table) descriptions are created by exchanging ICCP Provider data between the parties." ;
    rdfs:subClassOf cim:BilateralExchangeAgreement .

cim:TREntitlement a rdfs:Class ;
    rdfs:comment """A Transmission Right(TR) can be a chain of TR's or on individual. \r
\r
When a transmission right is not a chain, this is formally the ETC/TOR Entitlement for each ETC/TOR contract with the inclusion of CVR(Converted Rights) as an ETC. This is the sum of all entitlements on all related transmission interfaces for the same TR.\r
\r
When TR is a chain, its entitlement is the minimum of all entitlements for the individual TRs in the chain.""" .

cim:TagAction a rdfs:Class ;
    rdfs:comment "Action on operation tag as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:TailbayLossCurve a rdfs:Class ;
    rdfs:comment "Relationship between tailbay head loss height (Y-axis) and the total discharge into the power station's tailbay volume per time unit (X-axis) . There could be more than one curve depending on the level of the tailbay reservoir or river level." ;
    rdfs:subClassOf cim:Curve .

cim:TapChangerControl a rdfs:Class ;
    rdfs:comment "Describes behaviour specific to tap changers, e.g. how the voltage at the end of a line varies with the load level and compensation of the voltage drop by tap adjustment." ;
    rdfs:subClassOf cim:RegulatingControl .

cim:TapChangerDynamicData a rdfs:Class ;
    rdfs:comment """Optimal Power Flow or State Estimator Phase Shifter Data. This is used for RealTime, Study and Maintenance Users. SE Solution Phase Shifter Measurements from the last run of SE.\r
""" .

cim:TapChangerInfo a rdfs:Class ;
    rdfs:comment """Tap changer data.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:TapSchedule a rdfs:Class ;
    rdfs:comment "A pre-established pattern over time for a tap step." ;
    rdfs:subClassOf cim:SeasonDayTypeSchedule .

cim:TapeShieldCableInfo a rdfs:Class ;
    rdfs:comment "Tape shield cable data." ;
    rdfs:subClassOf cim:CableInfo .

cim:TargetLevelSchedule a rdfs:Class ;
    rdfs:comment """Reservoir water level targets from advanced studies or "rule curves". Typically in one hour increments for up to 10 days.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:Tariff a rdfs:Class ;
    rdfs:comment """Document, approved by the responsible regulatory agency, listing the terms and conditions, including a schedule of prices, under which utility services will be provided. It has a unique number within the state or province. For rate schedules it is frequently allocated by the affiliated Public utilities commission (PUC).\r
""" ;
    rdfs:subClassOf cim:Document .

cim:TariffProfile a rdfs:Class ;
    rdfs:comment "A schedule of charges; structure associated with Tariff that allows the definition of complex tarif structures such as step and time of use when used in conjunction with TimeTariffInterval and Charge. Inherited 'status.value' is defined in the context of the utility's business rules, for example: active, inactive, etc." ;
    rdfs:subClassOf cim:Document .

cim:TelephoneNumber a rdfs:Class ;
    rdfs:comment "Telephone number." .

cim:Temperature a rdfs:Class ;
    rdfs:comment """Value of temperature in degrees Celsius.\r
""" .

cim:TemperatureDependentLimitPoint a rdfs:Class ;
    rdfs:comment "A point on a table of limit verses temperature." .

cim:TemperatureDependentLimitTable a rdfs:Class ;
    rdfs:comment "This is a table lookup that provides limit values corresponding to a temperature input." ;
    rdfs:subClassOf cim:EnvironmentalDependentLimit .

cim:TemperaturePolynomialLimit a rdfs:Class ;
    rdfs:comment "This describes the coefficients of a polynomial function that has temperature as input and calculates limit values as output." ;
    rdfs:subClassOf cim:EnvironmentalDependentLimit .

cim:TenMinAuxiliaryData a rdfs:Class ;
    rdfs:comment """Models 10-Minutes Auxiliary Data.\r
""" .

cim:Tender a rdfs:Class ;
    rdfs:comment """Tender is what is "offered" by the customer towards making a payment and is often more than the required payment (hence the need for 'change'). The payment is thus that part of the Tender that goes towards settlement of a particular transaction.\r
Tender is modelled as an aggregation of Cheque and Card. Both these tender types can exist in a single tender bid thus 'accountHolderName' has to exist separately in each of Cheque and Card as each could have a different account holder name.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TerminalConstraintTerm a rdfs:Class ;
    rdfs:comment """A constraint term associated with a specific terminal on a physical piece of equipment.\r
""" ;
    rdfs:subClassOf cim:ConstraintTerm .

cim:TestDataSet a rdfs:Class ;
    rdfs:comment "Test results, usually obtained by a lab or other independent organisation." ;
    rdfs:subClassOf cim:ProcedureDataSet .

cim:TestStandard a rdfs:Class ;
    rdfs:comment "The precise standard used in executing a lab test, including the standard, and standard version, test method and variant, if needed." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TextDiagramObject a rdfs:Class ;
    rdfs:comment "A diagram object for placing free-text or text derived from an associated domain object." ;
    rdfs:subClassOf cim:DiagramObject .

cim:TieFlow a rdfs:Class ;
    rdfs:comment "Defines the structure (in terms of location and direction) of the net interchange constraint for a control area. This constraint may be used by either AGC or power flow." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TieLine a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TiePoint a rdfs:Class ;
    rdfs:comment """Site of an interface between interchange areas. The tie point can be a network branch (e.g., transmission line or transformer) or a switching device. For transmission lines, the interchange area boundary is usually at a designated point such as the middle of the line. Line end metering is then corrected for line losses.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TimeInterval a rdfs:Class ;
    rdfs:comment """Interval between two times.\r
""" .

cim:TimePoint a rdfs:Class ;
    rdfs:comment "A point in time within a sequence of points in time relative to a time schedule." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TimeTariffInterval a rdfs:Class ;
    rdfs:comment """One of a sequence of time intervals defined in terms of real time. It is typically used in association with TariffProfile to define the intervals in a time of use tariff structure, where startDateTime simultaneously determines the starting point of this interval and the ending point of the previous interval.\r
""" .

cim:Tool a rdfs:Class ;
    rdfs:comment """Tool asset.\r
""" ;
    rdfs:subClassOf cim:WorkAsset .

cim:TopologicalIsland a rdfs:Class ;
    rdfs:comment """An electrically connected subset of the network. Topological islands can change as the current network state changes, e.g. due to: \r
- disconnect switches or breakers changing state in a SCADA/EMS.\r
- manual creation, change or deletion of topological nodes in a planning tool.\r
Only energised TopologicalNode-s shall be part of the topological island.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TopologicalNode a rdfs:Class ;
    rdfs:comment """For a detailed substation model a topological node is a set of connectivity nodes that, in the current network state, are connected together through any type of closed switches, including  jumpers. Topological nodes change as the current network state changes (i.e., switches, breakers, etc. change state).\r
For a planning model, switch statuses are not used to form topological nodes. Instead they are manually created or deleted in a model builder tool. Topological nodes maintained this way are also called "busses".""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Tornado a rdfs:Class ;
    rdfs:comment "A tornado, a violent destructive whirling wind accompanied by a funnel-shaped cloud that progresses in a narrow path over the land." ;
    rdfs:subClassOf cim:AtmosphericPhenomenon .

cim:Tower a rdfs:Class ;
    rdfs:comment """Tower asset. Dimensions of the Tower are specified in associated DimensionsInfo class.\r
When used for planning purposes, a transmission tower carrying two 3-phase circuits will have 2 instances of Connection, each of which will have 3 MountingPoint instances, one for each phase all with coordinates relative to a common origin on the tower. (It may also have a 3rd Connection with a single MountingPoint for the Neutral line).\r
""" ;
    rdfs:subClassOf cim:Structure .

cim:TownDetail a rdfs:Class ;
    rdfs:comment """Town details, in the context of address.\r
""" .

cim:Trade a rdfs:Class ;
    rdfs:comment """Inter Scheduling Coordinator Trades to model financial trades which may impact settlement.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TradeError a rdfs:Class ;
    rdfs:comment """Trade error and warning messages associated with the rule engine processing of the submitted trade.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TradeProduct a rdfs:Class ;
    rdfs:comment """<b>TradeType</b>                                        <b>TradeProduct</b>\r
IST  (InterSC Trade)                          PHY (Physical Energy Trade)\r
IST                                                  APN (Energy Trades at Aggregated Pricing Nodes)\r
IST                                                  CPT (Converted Physical Energy Trade)\r
AST (Ancilliary Services Trade)             RUT (Regulation Up Trade)\r
AST                                                 RDT (Regulation Down Trade)\r
AST                                                 SRT (Spinning Reserve Trade)\r
AST                                                 NRT (Non-Spinning Reserve Trade)\r
UCT (Unit Commitment Trade)            null""" .

cim:TradingHubPrice a rdfs:Class ;
    rdfs:comment """Models prices at Trading Hubs, interval based.\r
""" .

cim:TradingHubValues a rdfs:Class ;
    rdfs:comment """Models prices at Trading Hubs.\r
""" .

cim:Transaction a rdfs:Class ;
    rdfs:comment "The record of details of payment for service or token sale." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransactionBid a rdfs:Class ;
    rdfs:comment """Bilateral or scheduled transactions for energy and ancillary services considered by market clearing process.\r
""" ;
    rdfs:subClassOf cim:Bid .

cim:TransactionBidClearing a rdfs:Class ;
    rdfs:comment """Contains the intervals relavent for the associated TransactionBidResults. For example, Day Ahead cleared results for the transaction bids for each interval of the market day.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:TransactionBidResults a rdfs:Class ;
    rdfs:comment """Contains the cleared results for each TransactionBid submitted to and accepted by the market.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Transactor a rdfs:Class ;
    rdfs:comment "The entity that ultimately executes the transaction and which is in control of the process; typically this is embodied in secure software running on a server that may employ secure hardware encryption devices for secure transaction processing." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransferInterface a rdfs:Class ;
    rdfs:comment """A Transfer Interface is made up of branches such as transmission lines and transformers.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransferInterfaceSolution a rdfs:Class ;
    rdfs:comment """TNA Interface Definitions from OPF for VSA.\r
""" .

cim:TransformerCoreAdmittance a rdfs:Class ;
    rdfs:comment """The transformer core admittance.  Used to specify the core admittance of a transformer in a manner that can be shared among power transformers.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransformerMeshImpedance a rdfs:Class ;
    rdfs:comment """Transformer mesh impedance (Delta-model) between transformer ends.\r
The typical case is that this class describes the impedance between two transformer ends pair-wise, i.e. the cardinalities at both transformer end associations are 1. However, in cases where two or more transformer ends are modelled the cardinalities are larger than 1.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransformerObservation a rdfs:Class ;
    rdfs:comment "Common information captured during transformer inspections and/or diagnostics. Note that some properties may be measured through other means and therefore have measurement values in addition to the observed values recorded here." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransformerStarImpedance a rdfs:Class ;
    rdfs:comment """Transformer star impedance (Pi-model) that accurately reflects impedance for transformers with 2 or 3 windings. For transformers with 4 or more windings, TransformerMeshImpedance class shall be used.\r
For transmission networks use PowerTransformerEnd impedances (r, r0, x, x0, b, b0, g and g0).""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransformerTank a rdfs:Class ;
    rdfs:comment "An assembly of two or more coupled windings that transform electrical power between voltage levels. These windings are bound on a common core and placed in the same tank. Transformer tank can be used to model both single-phase and 3-phase transformers." ;
    rdfs:subClassOf cim:Equipment .

cim:TransformerTankEnd a rdfs:Class ;
    rdfs:comment """Transformer tank end represents an individual winding for unbalanced models or for transformer tanks connected into a bank (and bank is modelled with the PowerTransformer).\r
""" ;
    rdfs:subClassOf cim:TransformerEnd .

cim:TransmissionCapacity a rdfs:Class ;
    rdfs:comment """This class models the transmission (either a transmission interface or a POR/POD pair) capacity including Total Transfer Capacity (TTC), Operating Transfer Capacity (OTC), and Capacity Benefit Margin (CBM).\r
""" .

cim:TransmissionCorridor a rdfs:Class ;
    rdfs:comment """A corridor containing one or more rights of way\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:TransmissionInterfaceRightEntitlement a rdfs:Class ;
    rdfs:comment "This is formally called the branch group ETC/TOR entitlement with the inclusion of CVR as ETC. This could be also used to represent the TR entitlement on a POR/POD." .

cim:TransmissionPath a rdfs:Class ;
    rdfs:comment """An electrical connection, link, or line consisting of one or more parallel transmission elements between two areas of the interconnected electric systems, or portions thereof. TransmissionCorridor and TransmissionRightOfWay refer to legal aspects. The TransmissionPath refers to the segments between a TransmissionProvider's ServicePoints.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransmissionProduct a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransmissionProvider a rdfs:Class ;
    rdfs:comment """Provider of  the transmission capacity (interconnecting wires between Generation and Consumption) required  to fulfill and Energy Transaction's energy exchange. Posts information for transmission paths and AvailableTransmissionCapacities  on a reservation node.  Buys and sells its products and services on the same reservation node.\r
""" ;
    rdfs:subClassOf cim:Organisation .

cim:TransmissionReservation a rdfs:Class ;
    rdfs:comment """A transmission reservation is obtained from the OASIS system to reserve transmission for a specified time period, transmission path and transmission product.\r
""" .

cim:TransmissionRightChain a rdfs:Class ;
    rdfs:comment "Allows chaining of TransmissionContractRights. Many individual contract rights can be included in the definition of a TransmissionRightChain. A TransmissionRightChain is also defined as a TransmissionContractRight itself." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransmissionRightOfWay a rdfs:Class ;
    rdfs:comment """A collection of transmission lines that are close proximity to each other.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:TriggerCondition a rdfs:Class ;
    rdfs:comment "A conditions that can trigger remedial actions." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TropicalCycloneAustralia a rdfs:Class ;
    rdfs:comment "A tropical cyclone, a subtype of cyclone that forms to the east of 90°E in the Southern Hemisphere whose intensity is measured by the Australian tropical cyclone intensity scale." ;
    rdfs:subClassOf cim:Cyclone .

cim:TroubleOrder a rdfs:Class ;
    rdfs:comment "Trouble order sends an incident to a crew to initiate a response to an unplanned outage." ;
    rdfs:subClassOf cim:Document .

cim:TroubleReporter a rdfs:Class ;
    rdfs:comment "Type of Person reporting the Trouble - Customer, First Responder, Passer-by, etc." ;
    rdfs:subClassOf cim:OperationPersonRole .

cim:TroubleSymptoms a rdfs:Class ;
    rdfs:comment "Trouble symptoms reported by person reporting the trouble.  The symptoms provide clues to utility personnel analyzing the ticket to help identify the root cause of the problem." .

cim:TroubleTicket a rdfs:Class ;
    rdfs:subClassOf cim:Document .

cim:Tsunami a rdfs:Class ;
    rdfs:comment "A tsunami (tidal wave), a long high sea wave caused by an earthquake, submarine landslide, or other disturbance." ;
    rdfs:subClassOf cim:HydrosphericPhenomenon .

cim:TurbLCFB1 a rdfs:Class ;
    rdfs:comment "Turbine load controller model developed by WECC.  This model represents a supervisory turbine load controller that acts to maintain turbine power at a set value by continuous adjustment of the turbine governor speed-load reference. This model is intended to represent slow reset 'outer loop' controllers managing the action of the turbine governor." ;
    rdfs:subClassOf cim:TurbineLoadControllerDynamics .

cim:TurbineGovernorUserDefined a rdfs:Class ;
    rdfs:comment "Turbine-governor function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:TurbineLoadControllerUserDefined a rdfs:Class ;
    rdfs:comment "Turbine load controller function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:TurbineLoadControllerDynamics .

cim:TypeAssetCatalogue a rdfs:Class ;
    rdfs:comment "Catalogue of generic types of assets (TypeAsset) that may be used for design purposes. It is not associated with a particular manufacturer." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TypeMaterial a rdfs:Class ;
    rdfs:comment """Documentation for a generic material item that may be used for design, work and other purposes. Any number of MaterialItems manufactured by various vendors may be used to perform this TypeMaterial.\r
Note that class analagous to "AssetModel" is not used for material items. This is because in some cases, for example, a utility sets up a Master material record for a 3 inch long half inch diameter steel bolt and they do not necessarily care what specific supplier is providing the material item. As different vendors are used to supply the part, the Stock Code of the material item can stay the same. In other cases, each time the vendor changes, a new stock code is set up so they can track material used by vendor. Therefore a Material Item "Model" is not typically needed.\r
""" ;
    rdfs:subClassOf cim:WorkDocument .

cim:UKMinistryOfDefenceStandard a rdfs:Class ;
    rdfs:comment "Standard published by United Kingdom Ministry of Defence." .

cim:Umode a rdfs:Class .

cim:UnavailabilityScheduleDependency a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:UnavailabilitySwitchAction a rdfs:Class ;
    rdfs:comment "Relevant switching action for supporting the availability (or unavailability) plans.  This could open or close a switch that is not directly connected to the unavailable equipment ." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:UnavailablitySchedule a rdfs:Class ;
    rdfs:comment "A schedule of unavailability for one or more specified equipment that need to follow the same scheduling periods." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:UnderexcLim2Simplified a rdfs:Class ;
    rdfs:comment "Simplified type UEL2 underexcitation limiter.  This model can be derived from UnderexcLimIEEE2.  The limit characteristic (look –up table) is a single straight-line, the same as UnderexcLimIEEE2 (see Figure 10.4 (p 32), IEEE 421.5-2005 Section 10.2)." ;
    rdfs:subClassOf cim:UnderexcitationLimiterDynamics .

cim:UnderexcLimIEEE1 a rdfs:Class ;
    rdfs:comment """Type UEL1 model which has a circular limit boundary when plotted in terms of machine reactive power vs. real power output.\r
Reference: IEEE UEL1 421.5-2005, 10.1. """ ;
    rdfs:subClassOf cim:UnderexcitationLimiterDynamics .

cim:UnderexcLimIEEE2 a rdfs:Class ;
    rdfs:comment """Type UEL2 underexcitation limiter which has either a straight-line or multi-segment characteristic when plotted in terms of machine reactive power output vs. real power output.\r
Reference: IEEE UEL2 421.5-2005, 10.2  (limit characteristic lookup table shown in Figure 10.4 (p 32)).""" ;
    rdfs:subClassOf cim:UnderexcitationLimiterDynamics .

cim:UnderexcLimX1 a rdfs:Class ;
    rdfs:comment "<font color=\"#0f0f0f\">Allis-Chalmers minimum excitation limiter.</font>" ;
    rdfs:subClassOf cim:UnderexcitationLimiterDynamics .

cim:UnderexcLimX2 a rdfs:Class ;
    rdfs:comment "<font color=\"#0f0f0f\">Westinghouse minimum excitation limiter.</font>" ;
    rdfs:subClassOf cim:UnderexcitationLimiterDynamics .

cim:UnderexcitationLimiterUserDefined a rdfs:Class ;
    rdfs:comment "Underexcitation limiter function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:UnderexcitationLimiterDynamics .

cim:UndergroundStructure a rdfs:Class ;
    rdfs:comment """Underground structure.\r
""" ;
    rdfs:subClassOf cim:Structure .

cim:Unit a rdfs:Class ;
    rdfs:comment """The identification of the unit name for the time series quantities.\r
""" .

cim:UnitInitialConditions a rdfs:Class ;
    rdfs:comment """Resource status at the end of a given clearing period.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:UnplannedOutage a rdfs:Class ;
    rdfs:comment """Document describing the consequence of an unplanned outage in a part of the electrical network. For the purposes of this model, an unplanned outage refers to a state where energy is not delivered; such as, customers out of service, a street light is not served, etc.\r
A unplanned outage may be created upon:\r
- impacts the SAIDI calculation\r
- a breaker trip,\r
- a fault indicator status change,\r
- a meter event indicating customer outage,\r
- a reception of one or more customer trouble calls, or\r
- an operator command, reflecting information obtained from the field crew.\r
Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities, including the relationship to the crew and work.\r
""" ;
    rdfs:subClassOf cim:Outage .

cim:Usage a rdfs:Class ;
    rdfs:comment "The way material and assets are used to perform a certain type of work task. The way is described in text in the inheritied description attribute." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:UsagePointGroup a rdfs:Class ;
    rdfs:comment """Abstraction for management of group communications within a two-way AMR system or the data for a group of related usage points. Commands can be issued to all of the usage points that belong to a usage point group using a defined group address and the underlying AMR communication infrastructure. \r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:UsagePointLocation a rdfs:Class ;
    rdfs:comment """Location of an individual usage point.\r
""" ;
    rdfs:subClassOf cim:Location .

cim:VAdjIEEE a rdfs:Class ;
    rdfs:comment """IEEE voltage adjuster which is used to represent the voltage adjuster in either a power factor or VAr control system.\r
Reference: IEEE 421.5-2005, 11.1.""" ;
    rdfs:subClassOf cim:VoltageAdjusterDynamics .

cim:VCompIEEEType1 a rdfs:Class ;
    rdfs:comment """<font color="#0f0f0f">Terminal voltage transducer and load compensator as defined in IEEE 421.5-2005, 4. This model is common to all excitation system models described in the IEEE Standard. </font>\r
<font color="#0f0f0f">Parameter details:</font>\r
<ol>\r
	<li><font color="#0f0f0f">If <i>Rc</i> and <i>Xc</i> are set to zero, the l</font>oad compensation is not employed and the behaviour is as a simple sensing circuit.</li>\r
</ol>\r
<ol>\r
	<li>If all parameters (<i>Rc</i>, <i>Xc</i> and <i>Tr</i>) are set to zero, the standard model VCompIEEEType1 is bypassed.</li>\r
</ol>\r
Reference: IEEE 421.5-2005 4. """ ;
    rdfs:subClassOf cim:VoltageCompensatorDynamics .

cim:VCompIEEEType2 a rdfs:Class ;
    rdfs:comment """<font color="#0f0f0f">Terminal voltage transducer and load compensator as defined in IEEE 421.5-2005, 4. This model is designed to cover the following types of compensation: </font>\r
<ul>\r
	<li><font color="#0f0f0f">reactive droop;</font></li>\r
	<li><font color="#0f0f0f">transformer-drop or line-drop compensation;</font></li>\r
	<li><font color="#0f0f0f">reactive differential compensation known also as cross-current compensation.</font></li>\r
</ul>\r
<font color="#0f0f0f">Reference: IEEE 421.5-2005, 4.</font>""" ;
    rdfs:subClassOf cim:VoltageCompensatorDynamics .

cim:VDCOL a rdfs:Class .

cim:VSCUserDefined a rdfs:Class ;
    rdfs:comment "Voltage source converter (VSC) function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:VSCDynamics .

cim:VSCtype1 a rdfs:Class ;
    rdfs:subClassOf cim:VSCDynamics .

cim:ValueAliasSet a rdfs:Class ;
    rdfs:comment "Describes the translation of a set of values into a name and is intendend to facilitate custom translations. Each ValueAliasSet has a name, description etc. A specific Measurement may represent a discrete state like Open, Closed, Intermediate etc. This requires a translation from the MeasurementValue.value number to a string, e.g. 0-&gt;\"Invalid\", 1-&gt;\"Open\", 2-&gt;\"Closed\", 3-&gt;\"Intermediate\". Each ValueToAlias member in ValueAliasSet.Value describe a mapping for one particular value to a name." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ValueToAlias a rdfs:Class ;
    rdfs:comment "Describes the translation of one particular value into a name, e.g. 1 as \"Open\"." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Vehicle a rdfs:Class ;
    rdfs:comment """Vehicle asset.\r
""" ;
    rdfs:subClassOf cim:WorkAsset .

cim:Vendor a rdfs:Class ;
    rdfs:comment "The entity that owns the point of sale and contracts with the cashier to receipt payments and vend tokens using the payment system. The vendor has a private contract with and is managed by the merchant which is a type of organisation. The vendor is accountable to the merchant for revenue collected, and the merchant is in turn accountable to the supplier." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:VendorShift a rdfs:Class ;
    rdfs:comment "The operating shift for a vendor during which the vendor may transact against the merchant's account. It aggregates transactions and receipts during the shift and periodically debits a merchant account. The totals in vendor shift should always be the sum of totals aggregated in all cashier shifts that were open under the particular vendor shift." ;
    rdfs:subClassOf cim:Shift .

cim:VerificationAction a rdfs:Class ;
    rdfs:comment "Verification of a switch position or other condition as a switching step" ;
    rdfs:subClassOf cim:SwitchingAction .

cim:Version a rdfs:Class ;
    rdfs:comment "This is the version for a group of devices or objects.  This could be used to track the version for any group of objects or devices over time. For example, for a DERGroup, the requesting system may want to get the details of a specific version of a DERGroup." .

cim:ViolationLimit a rdfs:Class ;
    rdfs:comment """A type of limit that indicates if it is enforced and, through association, the organisation responsible for setting the limit.\r
""" ;
    rdfs:subClassOf cim:Limit .

cim:VisibilityLayer a rdfs:Class ;
    rdfs:comment """Layers are typically used for grouping diagram objects according to themes and scales. Themes are used to display or hide certain information (e.g., lakes, borders), while scales are used for hiding or displaying information depending on the current zoom level (hide text when it is too small to be read, or when it exceeds the screen size). This is also called de-cluttering.\r
CIM based graphics exchange supports an m:n relationship between diagram objects and layers. The importing system shall convert an m:n case into an appropriate 1:n representation if the importing system does not support m:n.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:VolcanicAshCloud a rdfs:Class ;
    rdfs:comment "An ash cloud formed as a result of a volcanic eruption." ;
    rdfs:subClassOf cim:AtmosphericPhenomenon .

cim:Voltage a rdfs:Class ;
    rdfs:comment "Electrical voltage, can be both AC and DC." .

cim:VoltageAdjusterUserDefined a rdfs:Class ;
    rdfs:comment "<font color=\"#0f0f0f\">Voltage adjuster</font> function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:VoltageAdjusterDynamics .

cim:VoltageCompensatorUserDefined a rdfs:Class ;
    rdfs:comment "Voltage compensator function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:VoltageCompensatorDynamics .

cim:VoltageControlZone a rdfs:Class ;
    rdfs:comment "An area of the power system network which is defined for secondary voltage control purposes. A voltage control zone consists of a collection of substations with a designated bus bar section whose voltage will be controlled." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:VoltageLevel a rdfs:Class ;
    rdfs:comment "A collection of equipment at one common system voltage forming a switchgear. The equipment typically consists of breakers, busbars, instrumentation, control, regulation and protection devices as well as assemblies of all these." ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:VoltageLimit a rdfs:Class ;
    rdfs:comment """Operational limit applied to voltage.\r
The use of operational VoltageLimit is preferred instead of limits defined at VoltageLevel. The operational VoltageLimits are used, if present.""" ;
    rdfs:subClassOf cim:OperationalLimit .

cim:VoltagePerReactivePower a rdfs:Class ;
    rdfs:comment """Voltage variation with reactive power.\r
""" .

cim:Volume a rdfs:Class ;
    rdfs:comment """Volume.\r
""" .

cim:VolumeFlowRate a rdfs:Class ;
    rdfs:comment """Volume per time.\r
""" .

cim:VsCapabilityCurve a rdfs:Class ;
    rdfs:comment "The P-Q capability curve for a voltage source converter, with P on X-axis and Qmin and Qmax on Y1-axis and Y2-axis." ;
    rdfs:subClassOf cim:Curve .

cim:VsConverter a rdfs:Class ;
    rdfs:comment "DC side of the voltage source converter (VSC)." ;
    rdfs:subClassOf cim:ACDCConverter .

cim:WEPStandard a rdfs:Class ;
    rdfs:comment "Standard published by Westinghouse - a WEP (Westinghouse Engineering Procedure)." .

cim:WaterLevel a rdfs:Class ;
    rdfs:comment """Reservoir water level referred to a given datum such as mean sea level.\r
""" .

cim:WaveTrap a rdfs:Class ;
    rdfs:comment "Line traps are devices that impede high frequency power line carrier signals yet present a negligible impedance at the main power frequency." ;
    rdfs:subClassOf cim:AuxiliaryEquipment .

cim:WeatherStation a rdfs:Class ;
    rdfs:comment """This represents a source of ambient temperature.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:WheelingCounterParty a rdfs:Class ;
    rdfs:comment "Counter party in a wheeling transaction." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WheelingReferenceSchedule a rdfs:Class ;
    rdfs:comment """A unique identifier of a wheeling transaction. A wheeling transaction is a balanced Energy exchange among Supply and Demand Resources.\r
\r
This schedule is assocated with the hourly parameters in a resource bid.\r
""" ;
    rdfs:subClassOf cim:BidHourlySchedule .

cim:Whirlpool a rdfs:Class ;
    rdfs:comment "A whirlpool, a rapidly rotating mass of water in a river or sea into which objects may be drawn, typically caused by the meeting of conflicting currents." ;
    rdfs:subClassOf cim:HydrosphericPhenomenon .

cim:WindAeroConstIEC a rdfs:Class ;
    rdfs:comment """Constant aerodynamic torque model which assumes that the aerodynamic torque is constant.\r
Reference: IEC 61400-27-1:2015, 5.6.1.1.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindAeroOneDimIEC a rdfs:Class ;
    rdfs:comment """One-dimensional aerodynamic model.  \r
Reference: IEC 61400-27-1:2015, 5.6.1.2.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindAeroTwoDimIEC a rdfs:Class ;
    rdfs:comment """Two-dimensional aerodynamic model.  \r
Reference: IEC 61400-27-1:2015, 5.6.1.3.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContCurrLimIEC a rdfs:Class ;
    rdfs:comment """Current limitation model.  The current limitation model combines the physical limits and the control limits.\r
Reference: IEC 61400-27-1:2015, 5.6.5.8.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContPType3IEC a rdfs:Class ;
    rdfs:comment """P control model type 3.\r
Reference: IEC 61400-27-1:2015, 5.6.5.4.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContPType4aIEC a rdfs:Class ;
    rdfs:comment """P control model type 4A.\r
Reference: IEC 61400-27-1:2015, 5.6.5.5.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContPType4bIEC a rdfs:Class ;
    rdfs:comment """P control model type 4B.\r
Reference: IEC 61400-27-1:2015, 5.6.5.6.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContPitchAngleIEC a rdfs:Class ;
    rdfs:comment """Pitch angle control model.\r
Reference: IEC 61400-27-1:2015, 5.6.5.2.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContQIEC a rdfs:Class ;
    rdfs:comment """Q control model.\r
Reference: IEC 61400-27-1:2015, 5.6.5.7.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContQLimIEC a rdfs:Class ;
    rdfs:comment """Constant Q limitation model.\r
Reference: IEC 61400-27-1:2015, 5.6.5.9.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContQPQULimIEC a rdfs:Class ;
    rdfs:comment """QP and QU limitation model.\r
Reference: IEC 61400-27-1:2015, 5.6.5.10.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindContRotorRIEC a rdfs:Class ;
    rdfs:comment """Rotor resistance control model.\r
Reference: IEC 61400-27-1:2015, 5.6.5.3.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindDynamicsLookupTable a rdfs:Class ;
    rdfs:comment "Look up table for the purpose of wind standard models." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindGenTurbineType1aIEC a rdfs:Class ;
    rdfs:comment """Wind turbine IEC type 1A.\r
Reference: IEC 61400-27-1:2015, 5.5.2.2.""" ;
    rdfs:subClassOf cim:WindTurbineType1or2IEC .

cim:WindGenTurbineType1bIEC a rdfs:Class ;
    rdfs:comment """Wind turbine IEC type 1B.\r
\r
Reference: IEC 61400-27-1:2015, 5.5.2.3.""" ;
    rdfs:subClassOf cim:WindTurbineType1or2IEC .

cim:WindGenTurbineType2IEC a rdfs:Class ;
    rdfs:comment """Wind turbine IEC type 2.\r
\r
Reference: IEC 61400-27-1:2015, 5.5.3.""" ;
    rdfs:subClassOf cim:WindTurbineType1or2IEC .

cim:WindGenType3aIEC a rdfs:Class ;
    rdfs:comment """IEC type 3A generator set model.\r
Reference: IEC 61400-27-1:2015, 5.6.3.2.""" ;
    rdfs:subClassOf cim:WindGenType3IEC .

cim:WindGenType3bIEC a rdfs:Class ;
    rdfs:comment """IEC type 3B generator set model.\r
Reference: IEC 61400-27-1:2015, 5.6.3.3.""" ;
    rdfs:subClassOf cim:WindGenType3IEC .

cim:WindGenType4IEC a rdfs:Class ;
    rdfs:comment """IEC type 4 generator set model.\r
Reference: IEC 61400-27-1:2015, 5.6.3.4.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindGeneratingUnit a rdfs:Class ;
    rdfs:comment "A wind driven generating unit, connected to the grid by means of a rotating machine.  May be used to represent a single turbine or an aggregation.    " ;
    rdfs:subClassOf cim:GeneratingUnit .

cim:WindMechIEC a rdfs:Class ;
    rdfs:comment """Two mass model.\r
Reference: IEC 61400-27-1:2015, 5.6.2.1.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindPitchContPowerIEC a rdfs:Class ;
    rdfs:comment """Pitch control power model.\r
Reference: IEC 61400-27-1:2015, 5.6.5.1.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindPlantFreqPcontrolIEC a rdfs:Class ;
    rdfs:comment """Frequency and active power controller model.\r
Reference: IEC 61400-27-1:2015, Annex D.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindPlantIEC a rdfs:Class ;
    rdfs:comment """Simplified IEC type plant level model. \r
Reference: IEC 61400-27-1:2015, Annex D.""" ;
    rdfs:subClassOf cim:WindPlantDynamics .

cim:WindPlantReactiveControlIEC a rdfs:Class ;
    rdfs:comment """Simplified plant voltage and reactive power control model for use with type 3 and type 4 wind turbine models.\r
Reference: IEC 61400-27-1:2015, Annex D.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindPlantUserDefined a rdfs:Class ;
    rdfs:comment "Wind plant function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:WindPlantDynamics .

cim:WindProtectionIEC a rdfs:Class ;
    rdfs:comment """The grid protection model includes protection against over- and under-voltage, and against over- and under-frequency.\r
Reference: IEC 61400-27-1:2015, 5.6.6.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindRefFrameRotIEC a rdfs:Class ;
    rdfs:comment """Reference frame rotation model.\r
Reference: IEC 61400-27-1:2015, 5.6.3.5.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindTurbineType3IEC a rdfs:Class ;
    rdfs:comment "Parent class supporting relationships to IEC wind turbines type 3 including their control models." ;
    rdfs:subClassOf cim:WindTurbineType3or4IEC .

cim:WindTurbineType4aIEC a rdfs:Class ;
    rdfs:comment """Wind turbine IEC type 4A.\r
Reference: IEC 61400-27-1:2015, 5.5.5.2.""" ;
    rdfs:subClassOf cim:WindTurbineType4IEC .

cim:WindTurbineType4bIEC a rdfs:Class ;
    rdfs:comment """Wind turbine IEC type 4B.\r
Reference: IEC 61400-27-1:2015, 5.5.5.3.""" ;
    rdfs:subClassOf cim:WindTurbineType4IEC .

cim:WindType1or2UserDefined a rdfs:Class ;
    rdfs:comment "Wind type 1 or type 2 function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:WindTurbineType1or2Dynamics .

cim:WindType3or4UserDefined a rdfs:Class ;
    rdfs:comment "Wind type 3 or type 4 function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:WindTurbineType3or4Dynamics .

cim:WindingInsulation a rdfs:Class ;
    rdfs:comment "Winding insulation condition as a result of a test." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WireAssemblyInfo a rdfs:Class ;
    rdfs:comment "Describes the construction of a multi-conductor wire." ;
    rdfs:subClassOf cim:AssetInfo .

cim:WirePhaseInfo a rdfs:Class ;
    rdfs:comment "Information on a wire carrying a single phase." .

cim:WirePosition a rdfs:Class ;
    rdfs:comment """Identification, spacing and configuration of the wires of a conductor with respect to a structure.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WireSegment a rdfs:Class ;
    rdfs:comment "A two terminal and power conducting device of negligible impedance and length represented as zero impedance device that can be used to connect auxiliary equipment to its terminals." ;
    rdfs:subClassOf cim:Conductor .

cim:WireSegmentPhase a rdfs:Class ;
    rdfs:comment "Represents a single wire of an alternating current wire segment." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:WireSpacingInfo a rdfs:Class ;
    rdfs:comment "Wire spacing data that associates multiple wire positions with the line segment, and allows to calculate line segment impedances. Number of phases can be derived from the number of associated wire positions whose phase is not neutral." ;
    rdfs:subClassOf cim:AssetInfo .

cim:Work a rdfs:Class ;
    rdfs:comment "Document used to request, initiate, track and record work." ;
    rdfs:subClassOf cim:BaseWork .

cim:WorkActivityRecord a rdfs:Class ;
    rdfs:comment "Records information about the status of work or work task at a point in time. " ;
    rdfs:subClassOf cim:ActivityRecord .

cim:WorkBillingInfo a rdfs:Class ;
    rdfs:comment """Billing information for work performed for the customer. The history of Work Billing Info, Invoices, and Payments is to be maintained in associated ActivityRecords.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:WorkCostDetail a rdfs:Class ;
    rdfs:comment "A collection of all of the individual cost items collected from multiple sources." ;
    rdfs:subClassOf cim:WorkDocument .

cim:WorkCostSummary a rdfs:Class ;
    rdfs:comment """A roll up by cost type for the entire cost of a work order. For example, total labor.\r
""" ;
    rdfs:subClassOf cim:WorkDocument .

cim:WorkFlowStep a rdfs:Class ;
    rdfs:comment "A pre-defined set of work steps for a given type of work." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:WorkTimeSchedule a rdfs:Class ;
    rdfs:comment "Time schedule specific to work." ;
    rdfs:subClassOf cim:TimeSchedule .

cim:Zone a rdfs:Class ;
    rdfs:comment "Area divided off from other areas. It may be part of the electrical network, a land area where special restrictions apply, weather areas, etc. For weather, it is an area where a set of relatively homogenous weather measurements apply." ;
    rdfs:subClassOf cim:Location .

cim:ACLineSegment a rdfs:Class ;
    rdfs:comment """A wire or combination of wires, with consistent electrical characteristics, building a single electrical system, used to carry alternating current between points in the power system.\r
For symmetrical, transposed three phase lines, it is sufficient to use attributes of the line segment, which describe impedances and admittances for the entire length of the segment.  Additionally impedances can be computed by using length and associated per length impedances.\r
The BaseVoltage at the two ends of ACLineSegments in a Line shall have the same BaseVoltage.nominalVoltage. However, boundary lines may have slightly different BaseVoltage.nominalVoltages and variation is allowed. Larger voltage difference in general requires use of an equivalent branch.""" ;
    rdfs:subClassOf cim:Conductor .

cim:AggregatedPnode a rdfs:Class ;
    rdfs:comment """An aggregated pricing node is a specialized type of pricing node used to model items such as System Zone, Default Price Zone, Custom Price Zone, Control Area, Aggregated Generation, Aggregated Particpating Load, Aggregated Non-Participating Load, Trading Hub, Designated Control Area(DCA) Zone.\r
""" ;
    rdfs:subClassOf cim:Pnode .

cim:AnalogLimit a rdfs:Class ;
    rdfs:comment """Limit values for Analog measurements.\r
""" ;
    rdfs:subClassOf cim:Limit .

cim:AnalogLimitSet a rdfs:Class ;
    rdfs:comment "An AnalogLimitSet specifies a set of Limits that are associated with an Analog measurement." ;
    rdfs:subClassOf cim:LimitSet .

cim:AnalyticScore a rdfs:Class ;
    rdfs:comment "An indicative scoring by an analytic that can be used to characterize the health of or the risk associated with one or more assets.  The analytic score reflects the results of an execution of an analytic against an asset or group of assets." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AssetFunction a rdfs:Class ;
    rdfs:comment """Function performed by an asset.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AuxiliaryObject a rdfs:Class ;
    rdfs:comment """Models Auxiliary Values.\r
""" .

cim:BankAccount a rdfs:Class ;
    rdfs:comment "Bank account." ;
    rdfs:subClassOf cim:Document .

cim:BilateralExchangeAgreement a rdfs:Class ;
    rdfs:comment "This is the representation of the information exchange agreement between peers." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Breaker a rdfs:Class ;
    rdfs:comment "A mechanical switching device capable of making, carrying, and breaking currents under normal circuit conditions and also making, carrying for a specified time, and breaking currents under specified abnormal circuit conditions e.g.  those of short circuit." ;
    rdfs:subClassOf cim:ProtectedSwitch .

cim:CatalogAssetType a rdfs:Class ;
    rdfs:comment "a Assets that may be used for planning, work or design purposes." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CombinedCyclePlant a rdfs:Class ;
    rdfs:comment """A set of combustion turbines and steam turbines where the exhaust heat from the combustion turbines is recovered to make steam for the steam turbines, resulting in greater overall plant efficiency.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:CommunicationLink a rdfs:Class ;
    rdfs:comment "The connection to remote units is through one or more communication links. Reduntant links may exist. The CommunicationLink class inherits PowerSystemResource. The intention is to allow CommunicationLinks to have Measurements. These Measurements can be used to model link status as operational, out of service, unit failure etc." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:ConnectivityNode a rdfs:Class ;
    rdfs:comment "Connectivity nodes are points where terminals of AC conducting equipment are connected together with zero impedance." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Contingency a rdfs:Class ;
    rdfs:comment "An event threatening system reliability, consisting of one or more contingency elements." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ContingencyElement a rdfs:Class ;
    rdfs:comment "An element of a system event to be studied by contingency analysis, representing a change in status of a single piece of equipment. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ControlArea a rdfs:Class ;
    rdfs:comment """A control area is a grouping of generating units and/or loads and a cutset of tie lines (as terminals) which may be used for a variety of purposes including automatic generation control, power flow solution area interchange control specification, and input to load forecasting. All generation and load within the area defined by the terminals on the border are considered in the area interchange control. Note that any number of overlapping control area specifications can be superimposed on the physical model. The following general principles apply to ControlArea:\r
1.  The control area orientation for net interchange is positive for an import, negative for an export.\r
2.  The control area net interchange is determined by summing flows in Terminals. The Terminals are identified by creating a set of TieFlow objects associated with a ControlArea object. Each TieFlow object identifies one Terminal.\r
3.  In a single network model, a tie between two control areas must be modelled in both control area specifications, such that the two representations of the tie flow sum to zero.\r
4.  The normal orientation of Terminal flow is positive for flow into the conducting equipment that owns the Terminal. (i.e. flow from a bus into a device is positive.) However, the orientation of each flow in the control area specification must align with the control area convention, i.e. import is positive. If the orientation of the Terminal flow referenced by a TieFlow is positive into the control area, then this is confirmed by setting TieFlow.positiveFlowIn flag TRUE. If not, the orientation must be reversed by setting the TieFlow.positiveFlowIn flag FALSE.""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:Crew a rdfs:Class ;
    rdfs:comment "Group of people with specific skills, tools, and vehicles." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CrewMember a rdfs:Class ;
    rdfs:comment "Member of a crew." ;
    rdfs:subClassOf cim:OperationPersonRole .

cim:CrossCompoundTurbineGovernorDynamics a rdfs:Class ;
    rdfs:comment "Turbine-governor cross-compound function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:CurveData a rdfs:Class ;
    rdfs:comment "Multi-purpose data points for defining a curve.  The use of this generic class is discouraged if a more specific class can be used to specify the X and Y axis values along with their specific data types." .

cim:DiagramObject a rdfs:Class ;
    rdfs:comment "An object that defines one or more points in a given space. This object can be associated with anything that specializes IdentifiedObject. For single line diagrams such objects typically include such items as analog values, breakers, disconnectors, power transformers, and transmission lines." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EndDevice a rdfs:Class ;
    rdfs:comment """Asset container that performs one or more end device functions. One type of end device is a meter which can perform metering, load management, connect/disconnect, accounting functions, etc. Some end devices, such as ones monitoring and controlling air conditioners, refrigerators, pool pumps may be connected to a meter. All end devices may have communication capability defined by the associated communication function(s). An end device may be owned by a consumer, a service provider, utility or otherwise.\r
There may be a related end device function that identifies a sensor or control point within a metering application or communications systems (e.g., water, gas, electricity).\r
Some devices may use an optical port that conforms to the ANSI C12.18 standard for communications.""" ;
    rdfs:subClassOf cim:AssetContainer .

cim:HeatRateCurve a rdfs:Class ;
    rdfs:comment "Relationship between unit heat rate per active power (Y-axis) and  unit output (X-axis). The heat input is from all fuels." ;
    rdfs:subClassOf cim:Curve .

cim:IPAccessPoint a rdfs:Class ;
    rdfs:comment "Internet Protocol Access Point – used to represent an addressing structure is based upon an Internet Protocol (IP) address." ;
    rdfs:subClassOf cim:CommunicationLink .

cim:MarketActualEvent a rdfs:Class ;
    rdfs:comment "This class represents the actual instance of an event." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MarketDocument a rdfs:Class ;
    rdfs:comment "Electronic document containing the information necessary to satisfy a given business process set of requirements. " ;
    rdfs:subClassOf cim:Document .

cim:MeasurementValueSource a rdfs:Class ;
    rdfs:comment "MeasurementValueSource describes the alternative sources updating a MeasurementValue. User conventions for how to use the MeasurementValueSource attributes are defined in IEC 61970-301." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelAuthoritySet a rdfs:Class ;
    rdfs:comment """A Modeling Authority Set is a group of objects in a network model where the data is supplied and maintained by the same Modeling Authority.\r
This class is typically not included in instance data exchange as this information is tracked by other mechanisms in the exchange.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OperationalRestriction a rdfs:Class ;
    rdfs:comment """A document that can be associated with equipment to describe any sort of restrictions compared with the original manufacturer's specification or with the usual operational practice e.g. temporary maximum loadings, maximum switching current, do not operate if bus couplers are open, etc.\r
In the UK, for example, if a breaker or switch ever mal-operates, this is reported centrally and utilities use their asset systems to identify all the installed devices of the same manufacturer's type. They then apply operational restrictions in the operational systems to warn operators of potential problems. After appropriate inspection and maintenance, the operational restrictions may be removed.""" ;
    rdfs:subClassOf cim:Document .

cim:Operator a rdfs:Class ;
    rdfs:comment "Control room operator." ;
    rdfs:subClassOf cim:OperationPersonRole .

cim:PSRType a rdfs:Class ;
    rdfs:comment "Classifying instances of the same class, e.g. overhead and underground ACLineSegments. This classification mechanism is intended to provide flexibility outside the scope of this document, i.e. provide customisation that is non standard." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Person a rdfs:Class ;
    rdfs:comment "General purpose information for name and other information to contact people." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PowerTransformer a rdfs:Class ;
    rdfs:comment """An electrical device consisting of  two or more coupled windings, with or without a magnetic core, for introducing mutual coupling between electric circuits. Transformers can be used to control voltage and phase shift (active power flow).\r
A power transformer may be composed of separate transformer tanks that need not be identical.\r
A power transformer can be modelled with or without tanks and is intended for use in both balanced and unbalanced representations.   A power transformer typically has two terminals, but may have one (grounding), three or more terminals.\r
The inherited association ConductingEquipment.BaseVoltage should not be used.  The association from TransformerEnd to BaseVoltage should be used instead.""" ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:ProvidedBilateralPoint a rdfs:Class ;
    rdfs:comment "Allows declaration of ICCP points to be provided through a Bilateral Table agreement." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Quality61850 a rdfs:Class ;
    rdfs:comment """Quality flags in this class are as defined in IEC 61850, except for estimatorReplaced, which has been included in this class for convenience.\r
""" .

cim:RegisteredGenerator a rdfs:Class ;
    rdfs:comment "Model of a generator  that is registered to participate in the market." ;
    rdfs:subClassOf cim:RegisteredResource .

cim:ResourceGroupReq a rdfs:Class ;
    rdfs:comment """Ancillary service requirements for a market.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Role a rdfs:Class ;
    rdfs:comment """Enumeration of potential roles that might be played by one object relative to another.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:SafetyDocument a rdfs:Class ;
    rdfs:comment "Document restricting or authorising works on electrical equipment (for example a permit to work, sanction for test, limitation of access, or certificate of isolation), defined based upon organisational practices." ;
    rdfs:subClassOf cim:Document .

cim:SeriesCompensator a rdfs:Class ;
    rdfs:comment """A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device.\r
""" ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:SpacePhenomenon a rdfs:Class ;
    rdfs:comment "An extra-terrestrial phenomenon." ;
    rdfs:subClassOf cim:EnvironmentalPhenomenon .

cim:Specimen a rdfs:Class ;
    rdfs:comment "Sample or specimen of a material (fluid or solid)." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:StaticVarCompensatorDynamics a rdfs:Class ;
    rdfs:comment "Static var compensator whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:StatisticalCalculation a rdfs:Class ;
    rdfs:comment """Description of statistical calculation performed.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:StringMeasurementValue a rdfs:Class ;
    rdfs:comment "StringMeasurementValue represents a measurement value of type string." ;
    rdfs:subClassOf cim:MeasurementValue .

cim:SwitchInfo a rdfs:Class ;
    rdfs:comment """<was Switch data.>\r
Switch datasheet information.""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:TCPAccessPoint a rdfs:Class ;
    rdfs:comment "Allows addressing and behavioural information regarding the use of TCP by ICCP links." ;
    rdfs:subClassOf cim:IPAccessPoint .

cim:Terminal a rdfs:Class ;
    rdfs:comment "An AC electrical connection point to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes." ;
    rdfs:subClassOf cim:ACDCTerminal .

cim:ThermalGeneratingUnit a rdfs:Class ;
    rdfs:comment """A generating unit whose prime mover could be a steam turbine, combustion turbine, or diesel engine.\r
""" ;
    rdfs:subClassOf cim:GeneratingUnit .

cim:TimeSchedule a rdfs:Class ;
    rdfs:comment """Description of anything that changes through time. Time schedule is used to perform a single-valued function of time. Use inherited 'type' attribute to give additional information on this schedule, such as: periodic (hourly, daily, weekly, monthly, etc.), day of the month, by date, calendar (specific times and dates).\r
""" ;
    rdfs:subClassOf cim:Document .

cim:TransformerEndInfo a rdfs:Class ;
    rdfs:comment """Transformer end data.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:TransformerTankInfo a rdfs:Class ;
    rdfs:comment """Set of transformer tank data, from an equipment library.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:UsagePoint a rdfs:Class ;
    rdfs:comment "Logical or physical point in the network to which readings or events may be attributed. Used at the place where a physical or virtual meter may be located; however, it is not required that a meter be present." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:UserAttribute a rdfs:Class ;
    rdfs:comment "Generic name-value pair class, with optional sequence number and units for value; can be used to model parts of information exchange when concrete types are not known in advance." .

cim:WorkRequest a rdfs:Class ;
    rdfs:comment "Document used to plan or initiate work" ;
    rdfs:subClassOf cim:Document .

cim:ACDCConverter a rdfs:Class ;
    rdfs:comment "A unit with valves for three phases, together with unit control equipment, essential protective and switching devices, DC storage capacitors, phase reactors and auxiliaries, if any, used for conversion." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:ACDCTerminal a rdfs:Class ;
    rdfs:comment "An electrical connection point (AC or DC) to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AggregateScore a rdfs:Class ;
    rdfs:comment "An aggregated indicative scoring by an analytic, which is based on other analytic scores, that can be used to characterize the health of or the risk associated with one or more assets." ;
    rdfs:subClassOf cim:AnalyticScore .

cim:Analog a rdfs:Class ;
    rdfs:comment """Analog represents an analog Measurement.\r
""" ;
    rdfs:subClassOf cim:Measurement .

cim:AnalogControl a rdfs:Class ;
    rdfs:comment "An analog control used for supervisory control." ;
    rdfs:subClassOf cim:Control .

cim:BaseReading a rdfs:Class ;
    rdfs:comment """Common representation for reading values. Note that a reading value may have multiple qualities, as produced by various systems ('ReadingQuality.source').\r
""" ;
    rdfs:subClassOf cim:MeasurementValue .

cim:BaseWork a rdfs:Class ;
    rdfs:comment "Common representation for work and work tasks." ;
    rdfs:subClassOf cim:Document .

cim:BilateralExchangeActor a rdfs:Class ;
    rdfs:comment "BilateralExchangeActor describes an actor that provides ICCP data, consumes ICCP data or both. The ICCP data provider lists the data it makes available to an ICCP data consumer.  This data is described by ProvidedBilateralPoints. The relation between an ICCP data provider and a consumer is established by a BilateralExchangeAgreement.  It is up to the ICCP data consumer to select what ProvidedBilateralPoints to use.  The selection made is not described in this information model." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CSCDynamics a rdfs:Class ;
    rdfs:comment "CSC function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:HVDCDynamics .

cim:CableInfo a rdfs:Class ;
    rdfs:comment """Cable data.\r
""" ;
    rdfs:subClassOf cim:WireInfo .

cim:Conductor a rdfs:Class ;
    rdfs:comment "Combination of conducting material with consistent electrical characteristics, building a single electrical system, used to carry current between points in the power system.  " ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:ConnectivityNodeContainer a rdfs:Class ;
    rdfs:comment """A base class for all objects that may contain connectivity nodes or topological nodes.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:Connector a rdfs:Class ;
    rdfs:comment "A conductor, or group of conductors, with negligible impedance, that serve to connect other conducting equipment within a single substation and are modelled with a single logical terminal." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:ConstraintTerm a rdfs:Class ;
    rdfs:comment """A constraint term is one element of a linear constraint.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Cyclone a rdfs:Class ;
    rdfs:comment "A cyclone (or tropical cyclone), a rapidly-rotating storm system characterized by a low-pressure center, strong winds, and a spiral arrangement of thunderstorms that produce heavy rain." ;
    rdfs:subClassOf cim:AtmosphericPhenomenon .

cim:DCBaseTerminal a rdfs:Class ;
    rdfs:comment "An electrical connection point at a piece of DC conducting equipment. DC terminals are connected at one physical DC node that may have multiple DC terminals connected. A DC node is similar to an AC connectivity node. The model requires that DC connections are distinct from AC connections. " ;
    rdfs:subClassOf cim:ACDCTerminal .

cim:DCEquipmentContainer a rdfs:Class ;
    rdfs:comment "A modelling construct to provide a root class for containment of DC as well as AC equipment. The class differ from the EquipmentContaner for AC in that it may also contain DCNode-s. Hence it can contain both AC and DC equipment." ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:DCSwitch a rdfs:Class ;
    rdfs:comment "A switch within the DC system." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DataSet a rdfs:Class ;
    rdfs:comment """A generic container of a version of instance data. The MRID can be used in an audit trail, not in reusable script intended to work with new versions of data.\r
A dataset could be serialized multiple times and in multiple technologies, yet retain the same identity.""" .

cim:Discrete a rdfs:Class ;
    rdfs:comment "Discrete represents a discrete Measurement, i.e. a Measurement representing discrete values, e.g. a Breaker position." ;
    rdfs:subClassOf cim:Measurement .

cim:EarthFaultCompensator a rdfs:Class ;
    rdfs:comment "A conducting equipment used to represent a connection to ground which is typically used to compensate earth faults.   An earth fault compensator device modelled with a single terminal implies a second terminal solidly connected to ground.  If two terminals are modelled, the ground is not assumed and normal connection rules apply." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:EnergyArea a rdfs:Class ;
    rdfs:comment "Describes an area having energy production or consumption.  Specializations are intended to support the load allocation function as typically required in energy management systems or planning studies to allocate hypothesized load levels to individual load points for power flow analysis.  Often the energy area can be linked to both measured and forecast load levels." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EnergyComponent a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EnvironmentalDependentLimit a rdfs:Class ;
    rdfs:comment "This is a environmental based limit dependency model for calculating operational limits." ;
    rdfs:subClassOf cim:LimitDependency .

cim:EnvironmentalInformation a rdfs:Class ;
    rdfs:comment "Abstract class (with concrete child classes of Observation and Forecast) that groups phenomenon and/or environmental value sets. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Fault a rdfs:Class ;
    rdfs:comment "Abnormal condition causing current flow through conducting equipment, such as caused by equipment failure or short circuits from objects not typically modelled (for example, a tree falling on a line)." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:FrameworkPart a rdfs:Class ;
    rdfs:comment "The type of alternate model frame.  For example, it could be generator group used to represent generators in state estimator, planning, planning dynamics, short circuit, or real-time dynamics etc., but does not specifically represent any one alternative model. This need to know what objects to be removed in the realization of any one alternate model." ;
    rdfs:subClassOf cim:ModelAuthoritySet .

cim:HVDCDynamics a rdfs:Class ;
    rdfs:comment "HVDC whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:Hazard a rdfs:Class ;
    rdfs:comment "An object or a condition that is a danger for causing loss or perils to an asset and/or people." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:IOPoint a rdfs:Class ;
    rdfs:comment "The class describe a measurement or control value. The purpose is to enable having attributes and associations common for measurement and control." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:LimitSet a rdfs:Class ;
    rdfs:comment "Specifies a set of Limits that are associated with a Measurement. A Measurement may have several LimitSets corresponding to seasonal or other changing conditions. The condition is captured in the name and description attributes. The same LimitSet may be used for several Measurements. In particular percentage limits are used this way." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Line a rdfs:Class ;
    rdfs:comment "Contains equipment beyond a substation belonging to a power transmission line. " ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:LoadGroup a rdfs:Class ;
    rdfs:comment "The class is the third level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Market a rdfs:Class ;
    rdfs:comment "Market (e.g. Day Ahead Market, Real Time Market) with a description of the Market operation control parameters." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MarketParticipant a rdfs:Class ;
    rdfs:comment "An identification of a party acting in a electricity market business process. This class is used to identify organizations that can participate in market management and/or market operations." ;
    rdfs:subClassOf cim:Organisation .

cim:MeasurementValueQuality a rdfs:Class ;
    rdfs:comment "Measurement quality flags. Bits 0-10 are defined for substation automation in IEC 61850-7-3. Bits 11-15 are reserved for future expansion by that document. Bits 16-31 are reserved for EMS applications." ;
    rdfs:subClassOf cim:Quality61850 .

cim:MechanicalLoadDynamics a rdfs:Class ;
    rdfs:comment "Mechanical load function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:ModelOperationArg a rdfs:Class ;
    rdfs:comment "Describes the role a dataset plays in a model operation.   The role is applicable only in the context of a single operation." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelOperationArgDescription a rdfs:Class ;
    rdfs:comment "The type of custom operation dataset role for an operation description." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ModelToBeDeleted a rdfs:Class ;
    rdfs:comment "A Model is a collection of Datasets." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:NetworkModelProjectComponent a rdfs:Class ;
    rdfs:comment "Abstract class for both a network model project and network model change." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:NetworkModelProjectComponent2 a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:NetworkModelProjectRelationship a rdfs:Class ;
    rdfs:comment "A relationship that assists humans and software building cases by assembling project changes in the correct sequence.  This class may be specialized to create specific types of relationships." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OldSwitchInfo a rdfs:Class ;
    rdfs:comment """Properties of switch assets.\r
""" ;
    rdfs:subClassOf cim:SwitchInfo .

cim:Outage a rdfs:Class ;
    rdfs:comment """Document describing details of an active or planned outage in a part of the electrical network.\r
A non-planned outage may be created upon:\r
- a breaker trip,\r
- a fault indicator status change,\r
- a meter event indicating customer outage,\r
- a reception of one or more customer trouble calls, or\r
- an operator command, reflecting information obtained from the field crew.\r
Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities, including the relationship to the crew and work.\r
A planned outage may be created upon:\r
- a request for service, maintenance or construction work in the field, or\r
- an operator-defined outage for what-if/contingency network analysis.""" ;
    rdfs:subClassOf cim:Document .

cim:PerLengthImpedance a rdfs:Class ;
    rdfs:comment """Common type for per-length impedance electrical catalogues.\r
""" ;
    rdfs:subClassOf cim:PerLengthLineParameter .

cim:PerLengthLineParameter a rdfs:Class ;
    rdfs:comment "Common type for per-length electrical catalogues describing line parameters." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PersonRole a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PhaseTapChangerNonLinear a rdfs:Class ;
    rdfs:comment "The non-linear phase tap changer describes the non-linear behaviour of a phase tap changer. This is a base class for the symmetrical and asymmetrical phase tap changer models. The details of these models can be found in IEC 61970-301." ;
    rdfs:subClassOf cim:PhaseTapChanger .

cim:Pnode a rdfs:Class ;
    rdfs:comment "A pricing node is directly associated with a connectivity node.  It is a pricing location for which market participants submit their bids, offers, buy/sell CRRs, and settle. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ProtectionEquipment a rdfs:Class ;
    rdfs:comment "An electrical device designed to respond to input conditions in a prescribed manner and after specified conditions are met to cause contact operation or similar abrupt change in associated electric control circuits, or simply to display the detected condition. Protection equipment is associated with conducting equipment and usually operate circuit breakers." ;
    rdfs:subClassOf cim:Equipment .

cim:RegulatingControl a rdfs:Class ;
    rdfs:comment """Specifies a set of equipment that works together to control a power system quantity such as voltage or flow. \r
Remote bus voltage control is possible by specifying the controlled terminal located at some place remote from the controlling equipment.\r
The specified terminal shall be associated with the connectivity node of the controlled point.  The most specific subtype of RegulatingControl shall be used in case such equipment participate in the control, e.g. TapChangerControl for tap changers.\r
For flow control, load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment.\r
The attribute minAllowedTargetValue and maxAllowedTargetValue are required in the following cases:\r
- For a power generating module operated in power factor control mode to specify maximum and minimum power factor values;\r
- Whenever it is necessary to have an off center target voltage for the tap changer regulator. For instance, due to long cables to off shore wind farms and the need to have a simpler setup at the off shore transformer platform, the voltage is controlled from the land at the connection point for the off shore wind farm. Since there usually is a voltage rise along the cable, there is typical and overvoltage of up 3-4 kV compared to the on shore station. Thus in normal operation the tap changer on the on shore station is operated with a target set point, which is in the lower parts of the dead band.\r
The attributes minAllowedTargetValue and maxAllowedTargetValue are not related to the attribute targetDeadband and thus they are not treated as an alternative of the targetDeadband. They are needed due to limitations in the local substation controller. The attribute targetDeadband is used to prevent the power flow from move the tap position in circles (hunting) that is to be used regardless of the attributes minAllowedTargetValue and maxAllowedTargetValue.""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:RemotePoint a rdfs:Class ;
    rdfs:comment "For an RTU, remote points correspond to telemetered values or control outputs. Other units (e.g. control centres) usually also contain calculated values." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RotatingMachine a rdfs:Class ;
    rdfs:comment "A rotating machine which may be used as a generator or motor." ;
    rdfs:subClassOf cim:RegulatingCondEq .

cim:RotatingMachineDynamics a rdfs:Class ;
    rdfs:comment "Abstract parent class for all synchronous and asynchronous machine standard models." ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:Shift a rdfs:Class ;
    rdfs:comment """Generally referring to a period of operation or work performed. Whether the shift is open/closed can be derived from attributes 'activityInterval.start' and 'activityInterval.end'.\r
The grand total for receipts (i.e., cumulative total of all actual receipted amounts during this shift; bankable + non-bankable; excludes rounding error totals) can be derived from receipt:\r
=sum('Receipt.receiptAmount'); includes bankable and non-bankable receipts.\r
It also has to be reconciled against:\r
=sum('receiptsGrandTotalBankable' + 'receiptsGrandTotalNonBankable')\r
and against receipt summary:\r
=sum('ReceiptSummary.receiptsTotal').\r
The attributes with "GrandTotal" defined in this class may need to be used when the source data is periodically flushed from the system and then these cannot be derived.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ShuntCompensatorPhase a rdfs:Class ;
    rdfs:comment "Single phase of a multi-phase shunt compensator when its attributes might be different per phase." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:StringMeasurement a rdfs:Class ;
    rdfs:comment "StringMeasurement represents a measurement with values of type string." ;
    rdfs:subClassOf cim:Measurement .

cim:SynchronousMachineDetailed a rdfs:Class ;
    rdfs:comment """All synchronous machine detailed types use a subset of the same data parameters and input/output variables.  \r
The several variations differ in the following ways:\r
- the number of  equivalent windings that are included;\r
- the way in which saturation is incorporated into the model;\r
- whether or not “subtransient saliency” (<i>X''q</i> not = <i>X''d</i>) is represented.\r
It is not necessary for each simulation tool to have separate models for each of the model types.  The same model can often be used for several types by alternative logic within the model.  Also, differences in saturation representation might not result in significant model performance differences so model substitutions are often acceptable. """ ;
    rdfs:subClassOf cim:SynchronousMachineDynamics .

cim:TapChangerTablePoint a rdfs:Class ;
    rdfs:comment "Describes each tap step in the tabular curve." .

cim:TimeSeries a rdfs:Class ;
    rdfs:comment "A set of regular time-ordered measurements or values of quantitative nature of an individual or collective phenomenon taken at successive, in most cases equidistant, periods / points of time." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TransformerEnd a rdfs:Class ;
    rdfs:comment "A conducting connection point of a power transformer. It corresponds to a physical transformer winding terminal.  In earlier CIM versions, the TransformerWinding class served a similar purpose, but this class is more flexible because it associates to terminal but is not a specialization of ConductingEquipment." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TurbineLoadControllerDynamics a rdfs:Class ;
    rdfs:comment "Turbine load controller function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:VSCDynamics a rdfs:Class ;
    rdfs:comment "VSC function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:HVDCDynamics .

cim:VoltageAdjusterDynamics a rdfs:Class ;
    rdfs:comment "Voltage adjuster function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:WindGenType3IEC a rdfs:Class ;
    rdfs:comment "Parent class supporting relationships to IEC wind turbines type 3 generator models of IEC type 3A and 3B." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WindPlantDynamics a rdfs:Class ;
    rdfs:comment "Parent class supporting relationships to wind turbines type 3 and type 4 and wind plant IEC and user-defined wind plants including their control models." ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:WindTurbineType1or2Dynamics a rdfs:Class ;
    rdfs:comment """Parent class supporting relationships to wind turbines type 1 and type 2 and their control models.  Generator model for wind turbine of type 1 or type 2 is a standard asynchronous generator model.\r
""" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:WindTurbineType3or4Dynamics a rdfs:Class ;
    rdfs:comment "Parent class supporting relationships to wind turbines type 3 and type 4 and wind plant including their control models." ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:WindTurbineType3or4IEC a rdfs:Class ;
    rdfs:comment "Parent class supporting relationships to IEC wind turbines type 3 and type 4 including their control models." ;
    rdfs:subClassOf cim:WindTurbineType3or4Dynamics .

cim:WindTurbineType4IEC a rdfs:Class ;
    rdfs:comment "Parent class supporting relationships to IEC wind turbines type 4 including their control models." ;
    rdfs:subClassOf cim:WindTurbineType3or4IEC .

cim:WireInfo a rdfs:Class ;
    rdfs:comment """Wire data that can be specified per line segment phase, or for the line segment as a whole in case its phases all have the same wire characteristics.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:WorkAsset a rdfs:Class ;
    rdfs:comment "Asset used to perform work." ;
    rdfs:subClassOf cim:Asset .

cim:WorkOrder a rdfs:Class ;
    rdfs:subClassOf cim:Document .

cim:AsynchronousMachineDynamics a rdfs:Class ;
    rdfs:comment """Asynchronous machine whose behaviour is described by reference to a standard model expressed in either time constant reactance form or equivalent circuit form <font color="#0f0f0f">or by definition of a user-defined model.</font>\r
Parameter details:\r
<ol>\r
	<li>Asynchronous machine parameters such as <i>Xl, Xs,</i> etc. are actually used as inductances in the model, but are commonly referred to as reactances since, at nominal frequency, the PU values are the same. However, some references use the symbol <i>L</i> instead of <i>X</i>.</li>\r
</ol>""" ;
    rdfs:subClassOf cim:RotatingMachineDynamics .

cim:BasicIntervalSchedule a rdfs:Class ;
    rdfs:comment "Schedule of values at points in time." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BidHourlyProductSchedule a rdfs:Class ;
    rdfs:comment """Containment for bid parameters that are dependent on a market product type.\r
""" ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:BidHourlySchedule a rdfs:Class ;
    rdfs:comment """Containment for bid hourly parameters that are not product dependent.\r
""" ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:Control a rdfs:Class ;
    rdfs:comment """Control is used for supervisory/device control. It represents control outputs that are used to change the state in a process, e.g. close or open breaker, a set point value or a raise lower command.\r
""" ;
    rdfs:subClassOf cim:IOPoint .

cim:EndDeviceAction a rdfs:Class ;
    rdfs:comment """Action/command performed by an end device on a device other than the end device.\r
""" .

cim:EndDeviceFunction a rdfs:Class ;
    rdfs:comment """Function performed by an end device such as a meter, communication equipment, controllers, etc.\r
""" ;
    rdfs:subClassOf cim:AssetFunction .

cim:EnergyConnection a rdfs:Class ;
    rdfs:comment "A connection of energy generation or consumption on the power system model." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:EnergyConsumer a rdfs:Class ;
    rdfs:comment """Generic user of energy - a  point of consumption on the power system model.\r
EnergyConsumer.pfixed, .qfixed, .pfixedPct and .qfixedPct have meaning only if there is no LoadResponseCharacteristic associated with EnergyConsumer or if LoadResponseCharacteristic.exponentModel is set to False.""" ;
    rdfs:subClassOf cim:EnergyConnection .

cim:EquivalentEquipment a rdfs:Class ;
    rdfs:comment "The class represents equivalent objects that are the result of a network reduction. The class is the base for equivalent objects of different types." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:HydrosphericPhenomenon a rdfs:Class ;
    rdfs:comment "A hydrospheric phenomenon." ;
    rdfs:subClassOf cim:EnvironmentalPhenomenon .

cim:Limit a rdfs:Class ;
    rdfs:comment "Specifies one limit value for a Measurement. A Measurement typically has several limits that are kept together by the LimitSet class. The actual meaning and use of a Limit instance (i.e., if it is an alarm or warning limit or if it is a high or low limit) is not captured in the Limit class. However the name of a Limit instance may indicate both meaning and use." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Location a rdfs:Class ;
    rdfs:comment """The place, scene, or point of something where someone or something has been, is, and/or will be at a given moment in time. It can be defined with one or more position points (coordinates) in a given coordinate system.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OperationPersonRole a rdfs:Class ;
    rdfs:comment "Person role in the context of utility operations." ;
    rdfs:subClassOf cim:PersonRole .

cim:PFVArControllerType1Dynamics a rdfs:Class ;
    rdfs:comment "Power factor or VAr controller type 1 function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:PhaseTapChanger a rdfs:Class ;
    rdfs:comment "A transformer phase shifting tap model that controls the phase angle difference across the power transformer and potentially the active power flow through the power transformer.  This phase tap model may also impact the voltage magnitude." ;
    rdfs:subClassOf cim:TapChanger .

cim:PowerElectronicsUnit a rdfs:Class ;
    rdfs:comment "A generating unit or battery or aggregation that connects to the AC network using power electronics rather than rotating machines." ;
    rdfs:subClassOf cim:Equipment .

cim:PrimeMover a rdfs:Class ;
    rdfs:comment "The machine used to develop mechanical energy used to drive a generator." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:ProtectedSwitch a rdfs:Class ;
    rdfs:comment "A ProtectedSwitch is a switching device that can be operated by ProtectionEquipment." ;
    rdfs:subClassOf cim:Switch .

cim:ProtectiveAction a rdfs:Class ;
    rdfs:comment "A protective action for supporting the integrity of the power system." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ResourceBid a rdfs:Class ;
    rdfs:comment "Energy bid for generation, load, or virtual type for the whole of the market-trading period (i.e., one day in day ahead market or one hour in the real time market)." ;
    rdfs:subClassOf cim:Bid .

cim:Sensor a rdfs:Class ;
    rdfs:comment """This class describe devices that transform a measured quantity into signals that can be presented at displays, used in control or be recorded.\r
""" ;
    rdfs:subClassOf cim:AuxiliaryEquipment .

cim:SteamSupply a rdfs:Class ;
    rdfs:comment """Steam supply for steam turbine.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:Structure a rdfs:Class ;
    rdfs:comment """Construction holding assets such as conductors, transformers, switchgear, etc. Where applicable, number of conductors can be derived from the number of associated wire spacing instances.\r
""" ;
    rdfs:subClassOf cim:AssetContainer .

cim:SynchronousMachineDynamics a rdfs:Class ;
    rdfs:comment """Synchronous machine whose behaviour is described by reference to a standard model expressed in one of the following forms:\r
- simplified (or classical), where a group of generators or motors is not modelled in detail;\r
- detailed, in equivalent circuit form;\r
- detailed, in time constant reactance form; or\r
<font color="#0f0f0f">- by definition of a user-defined model.</font>\r
<font color="#0f0f0f">It is a common practice to represent small generators by a negative load rather than by a dynamic generator model when performing dynamics simulations. In this case, a SynchronousMachine in the static model is not represented by anything in the dynamics model, instead it is treated as an ordinary load.</font>\r
<font color="#0f0f0f">Parameter details:</font>\r
<ol>\r
	<li><font color="#0f0f0f">Synchronous machine parameters such as <i>Xl, Xd, Xp</i> etc. are actually used as inductances in the models,</font> but are commonly referred to as reactances since, at nominal frequency, the PU values are the same. However, some references use the symbol <i>L</i> instead of <i>X</i>.</li>\r
</ol>""" ;
    rdfs:subClassOf cim:RotatingMachineDynamics .

cim:TapChanger a rdfs:Class ;
    rdfs:comment "Mechanism for changing transformer winding tap positions." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:TransformerTest a rdfs:Class ;
    rdfs:comment """Test result for transformer ends, such as short-circuit, open-circuit (excitation) or no-load test.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:VoltageCompensatorDynamics a rdfs:Class ;
    rdfs:comment "Voltage compensator function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:WindTurbineType1or2IEC a rdfs:Class ;
    rdfs:comment """Parent class supporting relationships to IEC wind turbines type 1 and type 2 including their control models.\r
Generator model for wind turbine of IEC type 1 or type 2 is a standard asynchronous generator model.\r
Reference: IEC 61400-27-1:2015, 5.5.2 and 5.5.3.""" ;
    rdfs:subClassOf cim:WindTurbineType1or2Dynamics .

cim:WorkLocation a rdfs:Class ;
    rdfs:comment "Information about a particular location for various forms of work." ;
    rdfs:subClassOf cim:Location .

cim:AggregateNode a rdfs:Class ;
    rdfs:comment """An aggregated node can define a typed grouping further defined by the AnodeType enumeratuion. Types range from System Zone/Regions to Market Energy Regions to Aggregated Loads and Aggregated Generators.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AssetDiscrete a rdfs:Class ;
    rdfs:comment """Definition of type of discrete useful in asset domain.\r
""" ;
    rdfs:subClassOf cim:Discrete .

cim:AtmosphericPhenomenon a rdfs:Class ;
    rdfs:comment "An atmospheric phenomenon with a base and altitude providing the vertical coverage (combined with the Location to provide three dimensional space)." ;
    rdfs:subClassOf cim:EnvironmentalPhenomenon .

cim:AuxiliaryEquipment a rdfs:Class ;
    rdfs:comment """AuxiliaryEquipment describe equipment that is not performing any primary functions but support for the equipment performing the primary function.\r
AuxiliaryEquipment is attached to primary equipment via an association with Terminal.""" ;
    rdfs:subClassOf cim:Equipment .

cim:Bid a rdfs:Class ;
    rdfs:comment """Represents both bids to purchase and offers to sell energy or ancillary services in an RTO-sponsored market.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:ChangeSetMember a rdfs:Class ;
    rdfs:comment "A CRUD-style data object." .

cim:DiscontinuousExcitationControlDynamics a rdfs:Class ;
    rdfs:comment "Discontinuous excitation control function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model</font>." ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:DocumentPersonRole a rdfs:Class ;
    rdfs:comment "Person role with respect to documents." ;
    rdfs:subClassOf cim:PersonRole .

cim:EnvironmentalAnalog a rdfs:Class ;
    rdfs:comment "Analog (float) measurement of relevance in the environmental domain." ;
    rdfs:subClassOf cim:Analog .

cim:EnvironmentalPhenomenon a rdfs:Class ;
    rdfs:comment "The actual or forecast characteristics of an environmental phenomenon at a specific point in time (or during a specific time interval) that may have both a center and area/line location. " .

cim:FossilSteamSupply a rdfs:Class ;
    rdfs:comment "Fossil fuelled boiler (e.g., coal, oil, gas)." ;
    rdfs:subClassOf cim:SteamSupply .

cim:GeosphericPhenomenon a rdfs:Class ;
    rdfs:comment "A geospheric phenomenon." ;
    rdfs:subClassOf cim:EnvironmentalPhenomenon .

cim:LimitDependency a rdfs:Class ;
    rdfs:comment "A limit calculation model used to compute an operational limit based on external input such as temperature. These are intended to be shared among operational limits with the same calculation form that apply to a piece of equipment.." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:LoadDynamics a rdfs:Class ;
    rdfs:comment """Load whose behaviour is described by reference to a standard model <font color="#0f0f0f">or by definition of a user-defined model.</font>\r
A standard feature of dynamic load behaviour modelling is the ability to associate the same behaviour to multiple energy consumers by means of a single load definition.  The load model is always applied to individual bus loads (energy consumers).""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:OperationalLimit a rdfs:Class ;
    rdfs:comment """A value and normal value associated with a specific kind of limit. \r
The sub class value and normalValue attributes vary inversely to the associated OperationalLimitType.acceptableDuration (acceptableDuration for short).  \r
If a particular piece of equipment has multiple operational limits of the same kind (apparent power, current, etc.), the limit with the greatest acceptableDuration shall have the smallest limit value and the limit with the smallest acceptableDuration shall have the largest limit value.  Note: A large current can only be allowed to flow through a piece of equipment for a short duration without causing damage, but a lesser current can be allowed to flow for a longer duration. """ ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:PFVArControllerType2Dynamics a rdfs:Class ;
    rdfs:comment "Power factor or VAr controller type 2 function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:Profile a rdfs:Class ;
    rdfs:comment """A profile is a simpler curve type.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RegisteredResource a rdfs:Class ;
    rdfs:comment "A resource that is registered through the market participant registration system. Examples include generating unit, load, and non-physical generator or load." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:ScheduledLimitValue a rdfs:Class ;
    rdfs:comment "A limit that is applicable during a scheduled time period." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ShuntCompensator a rdfs:Class ;
    rdfs:comment "A shunt capacitor or reactor or switchable bank of shunt capacitors or reactors. A section of a shunt compensator is an individual capacitor or reactor. A negative value for bPerSection indicates that the compensator is a reactor. ShuntCompensator is a single terminal device.  Ground is implied." ;
    rdfs:subClassOf cim:RegulatingCondEq .

cim:WorkTask a rdfs:Class ;
    rdfs:comment "A task within a set of work." ;
    rdfs:subClassOf cim:BaseWork .

cim:AssetContainer a rdfs:Class ;
    rdfs:comment "Asset that is aggregation of other assets such as conductors, transformers, switchgear, land, fences, buildings, equipment, vehicles, etc." ;
    rdfs:subClassOf cim:Asset .

cim:AssetOrganisationRole a rdfs:Class ;
    rdfs:comment "Role an organisation plays with respect to asset." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:GateInputPin a rdfs:Class ;
    rdfs:comment "Input pin for a logical gate. The condition described in the input pin will give a logical true or false. Result from measurement and calculation are converted to a true or false." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Measurement a rdfs:Class ;
    rdfs:comment """A Measurement represents any measured, calculated or non-measured non-calculated quantity. Any piece of equipment may contain Measurements, e.g. a substation may have temperature measurements and door open indications, a transformer may have oil temperature and tank pressure measurements, a bay may contain a number of power flow measurements and a Breaker may contain a switch status measurement. \r
The PSR - Measurement association is intended to capture this use of Measurement and is included in the naming hierarchy based on EquipmentContainer. The naming hierarchy typically has Measurements as leaves, e.g. Substation-VoltageLevel-Bay-Switch-Measurement.\r
Some Measurements represent quantities related to a particular sensor location in the network, e.g. a voltage transformer (VT) or potential transformer (PT) at a busbar or a current transformer (CT) at the bar between a breaker and an isolator. The sensing position is not captured in the PSR - Measurement association. Instead it is captured by the Measurement - Terminal association that is used to define the sensing location in the network topology. The location is defined by the connection of the Terminal to ConductingEquipment. \r
If both a Terminal and PSR are associated, and the PSR is of type ConductingEquipment, the associated Terminal should belong to that ConductingEquipment instance.\r
When the sensor location is needed both Measurement-PSR and Measurement-Terminal are used. The Measurement-Terminal association is never used alone.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MeasurementValue a rdfs:Class ;
    rdfs:comment """The current state for a measurement. A state value is an instance of a measurement from a specific source. Measurements can be associated with many state values, each representing a different source for the measurement.\r
""" ;
    rdfs:subClassOf cim:IOPoint .

cim:OverexcitationLimiterDynamics a rdfs:Class ;
    rdfs:comment "Overexcitation limiter function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:ProcedureDataSet a rdfs:Class ;
    rdfs:comment "A data set recorded each time a procedure is executed. Observed results are captured in associated measurement values and/or values for properties relevant to the type of procedure performed." ;
    rdfs:subClassOf cim:Document .

cim:SeasonDayTypeSchedule a rdfs:Class ;
    rdfs:comment """A time schedule covering a 24 hour period, with curve data for a specific type of season and day.\r
""" ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:GeneratingUnit a rdfs:Class ;
    rdfs:comment "A single or set of synchronous machines for converting mechanical power into alternating-current power. For example, individual machines within a set may be defined for scheduling purposes while a single control signal is derived for the set. In this case there would be a GeneratingUnit for each member of the set and an additional GeneratingUnit corresponding to the set." ;
    rdfs:subClassOf cim:Equipment .

cim:RegulatingCondEq a rdfs:Class ;
    rdfs:comment "A type of conducting equipment that can regulate a quantity (i.e. voltage or flow) at a specific point in the network. " ;
    rdfs:subClassOf cim:EnergyConnection .

cim:UnderexcitationLimiterDynamics a rdfs:Class ;
    rdfs:comment "Underexcitation limiter function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:DCConductingEquipment a rdfs:Class ;
    rdfs:comment "The parts of the DC power system that are designed to carry current or that are conductively connected through DC terminals." ;
    rdfs:subClassOf cim:Equipment .

cim:EquipmentContainer a rdfs:Class ;
    rdfs:comment "A modelling construct to provide a root class for containing equipment. " ;
    rdfs:subClassOf cim:ConnectivityNodeContainer .

cim:Organisation a rdfs:Class ;
    rdfs:comment "Organisation that might have roles as utility, contractor, supplier, manufacturer, customer, etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:StateVariable a rdfs:Class ;
    rdfs:comment "An abstract class for state variables." .

cim:Switch a rdfs:Class ;
    rdfs:comment "A generic device designed to close, or open, or both, one or more electric circuits.  All switches are two terminal devices including grounding switches. The ACDCTerminal.connected at the two sides of the switch shall not be considered for assessing switch connectivity, i.e. only Switch.open, .normalOpen and .locked are relevant." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:AssetAnalog a rdfs:Class ;
    rdfs:comment """Definition of type of analog useful in asset domain.\r
""" ;
    rdfs:subClassOf cim:Analog .

cim:Equipment a rdfs:Class ;
    rdfs:comment "The parts of a power system that are physical devices, electronic or mechanical." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:Agreement a rdfs:Class ;
    rdfs:comment """Formal agreement between two parties defining the terms and conditions for a set of services. The specifics of the services are, in turn, defined via one or more service agreements.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:ActivityRecord a rdfs:Class ;
    rdfs:comment "Records activity for an entity at a point in time; activity may be for an event that has already occurred or for a planned activity." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Asset a rdfs:Class ;
    rdfs:comment "Tangible resource of the utility, including power system equipment, various end devices, cabinets, buildings, etc. For electrical network equipment, the role of the asset is defined through PowerSystemResource and its subclasses, defined mainly in the Wires model (refer to IEC61970-301 and model package IEC61970::Wires). Asset description places emphasis on the physical characteristics of the equipment fulfilling that role." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:RegularIntervalSchedule a rdfs:Class ;
    rdfs:comment """The schedule has time points where the time between them is constant.\r
""" ;
    rdfs:subClassOf cim:BasicIntervalSchedule .

cim:ConductingEquipment a rdfs:Class ;
    rdfs:comment "The parts of the AC power system that are designed to carry current or that are conductively connected through terminals." ;
    rdfs:subClassOf cim:Equipment .

cim:WorkDocument a rdfs:Class ;
    rdfs:comment "Shadow class for Document, to isolate subclassing from this package. If any subclass gets normative and needs inheritance, it will inherit directly from Document." ;
    rdfs:subClassOf cim:Document .

cim:OrganisationRole a rdfs:Class ;
    rdfs:comment """Identifies a way in which an organisation may participate in the utility enterprise (e.g., customer, manufacturer, etc).\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:SwitchingAction a rdfs:Class ;
    rdfs:comment "Atomic switching action." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ErpIdentifiedObject a rdfs:Class ;
    rdfs:comment "Shadow class for IdentifiedObject, to isolate subclassing from this package. If any subclass gets normative and needs inheritance, it will inherit directly from IdentifiedObject." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DynamicsFunctionBlock a rdfs:Class ;
    rdfs:comment "Abstract parent class for all Dynamics function blocks." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ErpDocument a rdfs:Class ;
    rdfs:comment "Shadow class for Document, to isolate subclassing from this package. If any subclass gets normative and needs inheritance, it will inherit directly from Document." ;
    rdfs:subClassOf cim:Document .

cim:PowerSystemStabilizerDynamics a rdfs:Class ;
    rdfs:comment "Power system stabilizer function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:AssetInfo a rdfs:Class ;
    rdfs:comment """Set of attributes of an asset, representing typical datasheet information of a physical device that can be instantiated and shared in different data exchange contexts:\r
- as attributes of an asset instance (installed or in stock)\r
- as attributes of an asset model (product by a manufacturer)\r
- as attributes of a type asset (generic type of an asset as used in designs/extension planning).""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:WorkIdentifiedObject a rdfs:Class ;
    rdfs:comment "Shadow class for IdentifiedObject, to isolate subclassing from this package. If any subclass gets normative and needs inheritance, it will inherit directly from IdentifiedObject." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MarketFactors a rdfs:Class ;
    rdfs:comment "Aggregation of market information relative for a specific time interval." ;
    rdfs:subClassOf cim:Document .

cim:PowerSystemResource a rdfs:Class ;
    rdfs:comment "A power system resource (PSR) can be an item of equipment such as a switch, an equipment container containing many individual items of equipment such as a substation, or an organisational entity such as sub-control area. Power system resources can have measurements associated." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:TurbineGovernorDynamics a rdfs:Class ;
    rdfs:comment "Turbine-governor function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:Curve a rdfs:Class ;
    rdfs:comment """A multi-purpose curve or functional relationship between an independent variable (X-axis) and dependent (Y-axis) variables. \r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Document a rdfs:Class ;
    rdfs:comment "Parent class for different groupings of information collected and managed as a part of a business process. It will frequently contain references to other objects, such as assets, people and power system resources." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ExcitationSystemDynamics a rdfs:Class ;
    rdfs:comment "Excitation system function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" ;
    rdfs:subClassOf cim:DynamicsFunctionBlock .

cim:IdentifiedObject a rdfs:Class ;
    rdfs:comment "This is a root class to provide common identification for all classes needing identification and naming attributes." .

cim:Terminal.ConnectivityNode a rdf:Property ;
    rdfs:domain cim:Terminal ;
    rdfs:range cim:ConnectivityNode .

cim:VoltageLevel.BaseVoltage a rdf:Property ;
    rdfs:domain cim:VoltageLevel ;
    rdfs:range cim:BaseVoltage .

cim:Substation.Region a rdf:Property ;
    rdfs:domain cim:Substation ;
    rdfs:range cim:SubGeographicalRegion .
