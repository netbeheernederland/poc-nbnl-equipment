@prefix cim: <https://cim.ucaiug.io/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <https://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://localhost:8000/cim17.rdfs.ttl> a owl:Ontology .

cim:ACDCConverterDCTerminal a rdfs:Class ;
    rdfs:comment "A DC electrical connection point at the AC/DC converter. The AC/DC converter is electrically connected also to the AC side. The AC connection is inherited from the AC conducting equipment in the same way as any other AC equipment. The AC/DC converter DC terminal is separate from generic DC terminal to restrict the connection with the AC side to AC/DC converter and so that no other DC conducting equipment can be connected to the AC side." ;
    rdfs:subClassOf cim:DCBaseTerminal .

cim:ACLineSegmentPhase a rdfs:Class ;
    rdfs:comment """Represents a single wire of an alternating current line segment.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:ASRequirements a rdfs:Class ;
    rdfs:comment """Models Ancillary Service Requirements.  Describes interval for which the requirement is applicable.\r
""" .

cim:ASTMStandard a rdfs:Class ;
    rdfs:comment "Standard published by ASTM (ASTM International)." .

cim:AcceptanceTest a rdfs:Class ;
    rdfs:comment """Acceptance test for assets.\r
""" .

cim:AccessPermit a rdfs:Class ;
    rdfs:comment """A permit is sometimes needed to provide legal access to land or equipment. For example, local authority permission for road works.\r
""" ;
    rdfs:subClassOf cim:WorkDocument .

cim:AccountMovement a rdfs:Class ;
    rdfs:comment """Credit/debit movements for an account.\r
""" .

cim:AccountNotification a rdfs:Class ;
    rdfs:comment "Notifications for move-in, move-out, delinquencies, etc." .

cim:AccountingUnit a rdfs:Class ;
    rdfs:comment "Unit for accounting; use either 'energyUnit' or 'currencyUnit' to specify the unit for 'value'." .

cim:Accumulator a rdfs:Class ;
    rdfs:comment "Accumulator represents an accumulated (counted) Measurement, e.g. an energy value." ;
    rdfs:subClassOf cim:Measurement .

cim:AccumulatorLimit a rdfs:Class ;
    rdfs:comment """Limit values for Accumulator measurements.\r
""" ;
    rdfs:subClassOf cim:Limit .

cim:AccumulatorLimitSet a rdfs:Class ;
    rdfs:comment """An AccumulatorLimitSet specifies a set of Limits that are associated with an Accumulator measurement.\r
""" ;
    rdfs:subClassOf cim:LimitSet .

cim:AccumulatorReset a rdfs:Class ;
    rdfs:comment "This command resets the counter value to zero." ;
    rdfs:subClassOf cim:Control .

cim:AccumulatorValue a rdfs:Class ;
    rdfs:comment """AccumulatorValue represents an accumulated (counted) MeasurementValue.\r
""" ;
    rdfs:subClassOf cim:MeasurementValue .

cim:AceTariffType a rdfs:Class ;
    rdfs:comment "The Area Control Error tariff type that is applied or used." .

cim:ActionRequest a rdfs:Class ;
    rdfs:comment "Action request against an existing Trade." .

cim:ActivePower a rdfs:Class ;
    rdfs:comment "Product of RMS value of the voltage and the RMS value of the in-phase component of the current." .

cim:ActivePowerChangeRate a rdfs:Class ;
    rdfs:comment """Rate of change of active power per time.\r
""" .

cim:ActivePowerLimit a rdfs:Class ;
    rdfs:comment "Limit on active power flow." ;
    rdfs:subClassOf cim:OperationalLimit .

cim:ActivePowerPerCurrentFlow a rdfs:Class ;
    rdfs:comment "Active power variation with current flow." .

cim:ActivePowerPerFrequency a rdfs:Class ;
    rdfs:comment "Active power variation with frequency." .

cim:AdjacentCASet a rdfs:Class ;
    rdfs:comment "Groups Adjacent Control Areas." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Admittance a rdfs:Class ;
    rdfs:comment """Ratio of current to voltage.\r
""" .

cim:AirCompressor a rdfs:Class ;
    rdfs:comment """Combustion turbine air compressor which is an integral part of a compressed air energy storage (CAES) plant.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:AlertTypeList a rdfs:Class ;
    rdfs:comment """A named list of alert types.\r
Note:  the name of the list is reflected in the .name attribute (inherited from IdentifiedObject).""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AllocationResult a rdfs:Class ;
    rdfs:comment """Models Market clearing results.  Indicates market horizon, interval based. Used by a market quality system for billing and settlement purposes.\r
""" .

cim:AllocationResultValues a rdfs:Class ;
    rdfs:comment """Models Market clearing results in terms of price and MW values.\r
""" .

cim:AltGeneratingUnitMeas a rdfs:Class ;
    rdfs:comment "A prioritized measurement to be used for the generating unit in the control area specification." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AltTieMeas a rdfs:Class ;
    rdfs:comment "A prioritized measurement to be used for the tie flow as part of the control area specification." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AlternateModel a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AlternateModelGroup a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AnalogMeasurementValueQuality a rdfs:Class ;
    rdfs:comment "Measurement quality flags for Analog Values." ;
    rdfs:subClassOf cim:MeasurementValueQuality .

cim:AnalogValue a rdfs:Class ;
    rdfs:comment "AnalogValue represents an analog MeasurementValue." ;
    rdfs:subClassOf cim:MeasurementValue .

cim:Analytic a rdfs:Class ;
    rdfs:comment "An algorithm or calculation for making an assessment about an asset or asset grouping for lifecycle decision making." ;
    rdfs:subClassOf cim:Document .

cim:AncillaryServiceClearing a rdfs:Class ;
    rdfs:comment """Model of results of market clearing with respect to  Ancillary Service products.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:AngleDegrees a rdfs:Class ;
    rdfs:comment """Measurement of angle in degrees.\r
""" .

cim:AngleRadians a rdfs:Class ;
    rdfs:comment """Phase angle in radians.\r
""" .

cim:AnnotatedProjectDependency a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ApparentPower a rdfs:Class ;
    rdfs:comment """Product of the RMS value of the voltage and the RMS value of the current.\r
""" .

cim:ApparentPowerLimit a rdfs:Class ;
    rdfs:comment "Apparent power limit." ;
    rdfs:subClassOf cim:OperationalLimit .

cim:Appointment a rdfs:Class ;
    rdfs:comment "Meeting time and location." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Approver a rdfs:Class ;
    rdfs:comment "Person who accepted/signed or rejected the document." ;
    rdfs:subClassOf cim:DocumentPersonRole .

cim:Area a rdfs:Class ;
    rdfs:comment "Area." .

cim:AreaLoadBid a rdfs:Class ;
    rdfs:comment """AreaLoadBid is not submitted by a market participant into the Markets. Instead, it is simply an aggregation of all LoadBids contained wtihin a specific SubControlArea. This entity should inherit from Bid for representation of the timeframe (startTime, stopTime) and the market type.\r
""" ;
    rdfs:subClassOf cim:Bid .

cim:AreaLoadCurve a rdfs:Class ;
    rdfs:comment """Area load curve definition.\r
""" ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:AreaReserveSpec a rdfs:Class ;
    rdfs:comment """The control area's reserve specification.\r
""" .

cim:AssemblyDescription a rdfs:Class ;
    rdfs:comment "A description for how to assemble model parts for a specific purpose." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AssemblyManifest a rdfs:Class ;
    rdfs:comment "A collection of model parts when combined form a case or part of a case." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AssetDeployment a rdfs:Class ;
    rdfs:comment "Deployment of asset deployment in a power system resource role." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AssetGroup a rdfs:Class ;
    rdfs:comment "A grouping of assets created for a purpose such as fleet analytics, inventory or compliance management." ;
    rdfs:subClassOf cim:Document .

cim:AssetHealthEvent a rdfs:Class ;
    rdfs:comment "An asset health-related event that is created by an analytic. The event is a record of a change in asset health." ;
    rdfs:subClassOf cim:ActivityRecord .

cim:AssetLocationHazard a rdfs:Class ;
    rdfs:comment "Potential hazard related to the location of an asset. Examples are trees growing under overhead power lines, a park being located by a substation (i.e., children climb fence to recover a ball), a lake near an overhead distribution line (fishing pole/line contacting power lines), dangerous neighbour, etc." ;
    rdfs:subClassOf cim:Hazard .

cim:AssetModelCatalogue a rdfs:Class ;
    rdfs:comment "Catalogue of available types of products and materials that are used to build or install, maintain or operate an Asset. Each catalogue item is for a specific product (AssetModel) available from a specific supplier." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:AssetModelCatalogueItem a rdfs:Class ;
    rdfs:comment "Provides pricing and other relevant information about a specific manufacturer's product (i.e., AssetModel), and its price from a given supplier. A single AssetModel may be availble from multiple suppliers. Note that manufacturer and supplier are both types of organisation, which the association is inherited from Document." ;
    rdfs:subClassOf cim:Document .

cim:AssetOwner a rdfs:Class ;
    rdfs:comment """Owner of the asset.\r
""" ;
    rdfs:subClassOf cim:AssetOrganisationRole .

cim:AssetPropertyCurve a rdfs:Class ;
    rdfs:comment "An Asset Property that is described through curves rather than as a data point. The relationship is to be defined between an independent variable (X-axis) and one or two dependent variables (Y1-axis and Y2-axis)." ;
    rdfs:subClassOf cim:Curve .

cim:AssetStringMeasurement a rdfs:Class ;
    rdfs:comment """Definition of type of string measurement useful in asset domain.\r
""" ;
    rdfs:subClassOf cim:StringMeasurement .

cim:AssetTemperaturePressureAnalog a rdfs:Class ;
    rdfs:comment """Temperature or pressure type of asset analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:AssetTestLab a rdfs:Class ;
    rdfs:comment "Test lab that performs various types of testing related to assets." ;
    rdfs:subClassOf cim:AssetOrganisationRole .

cim:AssetTestSampleTaker a rdfs:Class ;
    rdfs:comment "Identity of person/organization that took sample." ;
    rdfs:subClassOf cim:AssetOrganisationRole .

cim:AssetUser a rdfs:Class ;
    rdfs:comment """Organisation that is a user of the asset.\r
""" ;
    rdfs:subClassOf cim:AssetOrganisationRole .

cim:Assignment a rdfs:Class ;
    rdfs:comment "An assignment is given to an ErpPerson, Crew, Organisation, Equipment Item, Tool, etc. and may be used to perform Work, WorkTasks, Procedures, etc. TimeSchedules may be set up directly for Assignments or indirectly via the associated WorkTask. Note that these associations are all inherited through the recursive relationship on Document." ;
    rdfs:subClassOf cim:WorkDocument .

cim:AsynchronousMachine a rdfs:Class ;
    rdfs:comment "A rotating machine whose shaft rotates asynchronously with the electrical field.  Also known as an induction machine with no external connection to the rotor windings, e.g. squirrel-cage induction machine." ;
    rdfs:subClassOf cim:RotatingMachine .

cim:AsynchronousMachineEquivalentCircuit a rdfs:Class ;
    rdfs:comment """The electrical equations of all variations of the asynchronous model are based on the AsynchronousEquivalentCircuit diagram for the direct- and quadrature- axes, with two equivalent rotor windings in each axis.  \r
Equations for conversion between equivalent circuit and time constant reactance forms:\r
<i>Xs</i> = <i>Xm</i> + <i>Xl</i>\r
<i>X'</i> = <i>Xl</i> + <i>Xm</i> x <i>Xlr1 </i>/ (<i>Xm </i>+ <i>Xlr1</i>)\r
<i>X''</i> = <i>Xl</i> + <i>Xm</i> x <i>Xlr1</i> x <i>Xlr2</i> / (<i>Xm</i> x <i>Xlr1</i> + <i>Xm</i> x <i>Xlr2</i> + <i>Xlr1</i> x <i>Xlr2</i>)\r
<i>T'o</i> = (<i>Xm</i> + <i>Xlr1</i>) / (<i>omega</i><i><sub>0</sub></i> x <i>Rr1</i>)\r
<i>T''o</i> = (<i>Xm</i> x <i>Xlr1</i> + <i>Xm</i> x <i>Xlr2</i> + <i>Xlr1</i> x <i>Xlr2</i>) / (<i>omega</i><i><sub>0</sub></i> x <i>Rr2</i> x (<i>Xm</i> + <i>Xlr1</i>)\r
Same equations using CIM attributes from AsynchronousMachineTimeConstantReactance class on left of "=" and AsynchronousMachineEquivalentCircuit class on right (except as noted):\r
xs = xm + RotatingMachineDynamics.statorLeakageReactance\r
xp = RotatingMachineDynamics.statorLeakageReactance + xm x xlr1 / (xm + xlr1)\r
xpp = RotatingMachineDynamics.statorLeakageReactance + xm x xlr1 x xlr2 / (xm x xlr1 + xm x xlr2 + xlr1 x xlr2)\r
tpo = (xm + xlr1) / (2 x pi x nominal frequency x rr1)\r
tppo = (xm x xlr1 + xm x xlr2 + xlr1 x xlr2) / (2 x pi x nominal frequency x rr2 x (xm + xlr1).""" ;
    rdfs:subClassOf cim:AsynchronousMachineDynamics .

cim:AsynchronousMachineTimeConstantReactance a rdfs:Class ;
    rdfs:comment """Parameter details:\r
<ol>\r
	<li>If <i>X'' </i>=<i> X'</i>, a single cage (one equivalent rotor winding per axis) is modelled.</li>\r
	<li>The “<i>p</i>” in the attribute names is a substitution for a “prime” in the usual parameter notation, e.g. <i>tpo</i> refers to <i>T'o</i>.</li>\r
</ol>\r
The parameters used for models expressed in time constant reactance form include:\r
- RotatingMachine.ratedS (<i>MVAbase</i>);\r
- RotatingMachineDynamics.damping (<i>D</i>);\r
- RotatingMachineDynamics.inertia (<i>H</i>);\r
- RotatingMachineDynamics.saturationFactor (<i>S1</i>);\r
- RotatingMachineDynamics.saturationFactor120 (<i>S12</i>);\r
- RotatingMachineDynamics.statorLeakageReactance (<i>Xl</i>);\r
- RotatingMachineDynamics.statorResistance (<i>Rs</i>);\r
- .xs (<i>Xs</i>);\r
- .xp (<i>X'</i>);\r
- .xpp (<i>X''</i>);\r
- .tpo (<i>T'o</i>);\r
- .tppo (<i>T''o</i>).""" ;
    rdfs:subClassOf cim:AsynchronousMachineDynamics .

cim:AsynchronousMachineUserDefined a rdfs:Class ;
    rdfs:comment "Asynchronous machine whose dynamic behaviour is described by a user-defined model." ;
    rdfs:subClassOf cim:AsynchronousMachineDynamics .

cim:AtmosphericAnalog a rdfs:Class ;
    rdfs:comment "Analog (float) measuring an atmospheric condition." ;
    rdfs:subClassOf cim:EnvironmentalAnalog .

cim:AttributeInstanceComponent a rdfs:Class ;
    rdfs:comment "A class used to provide information about an attribute. " .

cim:AttributeProperty a rdfs:Class ;
    rdfs:comment """Property for a particular attribute that contains name and value.\r
""" .

cim:Auction a rdfs:Class ;
    rdfs:comment "A class providing the identification and type of an auction." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Author a rdfs:Class ;
    rdfs:comment "Person who created document or activity record." ;
    rdfs:subClassOf cim:DocumentPersonRole .

cim:AuxiliaryAccount a rdfs:Class ;
    rdfs:comment """Variable and dynamic part of auxiliary agreement, generally representing the current state of the account related to the outstanding balance defined in auxiliary agreement.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:AuxiliaryAgreement a rdfs:Class ;
    rdfs:comment """An ad-hoc auxiliary account agreement associated with a customer agreement, not part of the customer's account, but typically subject to formal agreement between customer and supplier (utility). Typically this is used to collect revenue owed by the customer for other services or arrears accrued with the utility for other services. It is typically linked to a prepaid token purchase transaction, thus forcing the customer to make a payment towards settlement of the auxiliary account balance whenever the customer needs to purchase a prepaid token for electricity.\r
The present status of the auxiliary agreement can be defined in the context of the utility's business rules, for example: enabled, disabled, pending, over recovered, under recovered, written off, etc.""" ;
    rdfs:subClassOf cim:Agreement .

cim:AuxiliaryCost a rdfs:Class ;
    rdfs:comment """Models Market clearing results for Auxiliary costs.\r
""" .

cim:AuxiliaryValues a rdfs:Class ;
    rdfs:comment """Models Auxiliary Values.\r
""" ;
    rdfs:subClassOf cim:AuxiliaryObject .

cim:AvailablityPlan a rdfs:Class ;
    rdfs:comment "The collection of all the availability schedules for a given time range.  Only one availability plan shall be valid for the same period. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BWRSteamSupply a rdfs:Class ;
    rdfs:comment """Boiling water reactor used as a steam supply to a steam turbine.\r
""" ;
    rdfs:subClassOf cim:SteamSupply .

cim:Bank a rdfs:Class ;
    rdfs:comment "Organisation that is a commercial bank, agency, or other institution that offers a similar service." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:BankAccountDetail a rdfs:Class ;
    rdfs:comment "Details of a bank account." .

cim:BaseCaseConstraintLimit a rdfs:Class ;
    rdfs:comment """Possibly time-varying max MW or MVA and optionally Min MW limit or MVA limit (Y1 and Y2, respectively) assigned to a contingency analysis base case. Use CurveSchedule XAxisUnits to specify MW or MVA. To be used only if the BaseCaseConstraintLimit differs from the DefaultConstraintLimit.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:BaseFrequency a rdfs:Class ;
    rdfs:comment "The BaseFrequency class describes a base frequency for a power system network. In case of multiple power networks with different frequencies, e.g. 50 Hz or 60 Hz each network will have its own base frequency class. Hence it is assumed that power system objects having different base frequencies appear in separate documents where each document has a single base frequency instance." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BasePower a rdfs:Class ;
    rdfs:comment "The BasePower class defines the base power used in the per unit calculations." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BaseVoltage a rdfs:Class ;
    rdfs:comment "Defines a system base voltage which is referenced. " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BatteryUnit a rdfs:Class ;
    rdfs:comment "An electrochemical energy storage device." ;
    rdfs:subClassOf cim:PowerElectronicsUnit .

cim:Bay a rdfs:Class ;
    rdfs:comment """A collection of power system resources (within a given substation) including conducting equipment, protection relays, measurements, and telemetry.  A bay typically represents a physical grouping related to modularization of equipment.\r
""" ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:Bearing a rdfs:Class ;
    rdfs:comment "The bearing in degrees (with 360 degrees being True North).  Measured in degrees clockwise from True North.  0 degrees indicates no direction being given." .

cim:BidDistributionFactor a rdfs:Class ;
    rdfs:comment """This class allows SC to input different time intervals for distribution factors.\r
""" .

cim:BidError a rdfs:Class ;
    rdfs:comment """This class represent the error information for a bid that is detected during bid validation.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BidPriceCap a rdfs:Class ;
    rdfs:comment """This class represent the bid price cap.\r
""" .

cim:BidPriceCurve a rdfs:Class ;
    rdfs:comment """Relationship between unit operating price in $/hour (Y-axis) and unit output in MW (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:BidPriceSchedule a rdfs:Class ;
    rdfs:comment """Defines bid schedules to allow a product bid to use specified bid price curves for different time intervals.\r
""" ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:BidSelfSched a rdfs:Class ;
    rdfs:comment "Defines self schedule values to be used for specified time intervals." ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:BidSet a rdfs:Class ;
    rdfs:comment """As set of mutually exclusive bids for which a maximum of one may be scheduled.\r
Of these generating bids, only one generating bid can be scheduled at a time.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BidTimeSeries a rdfs:Class ;
    rdfs:comment "The formal specification of specific characteristics related to a bid." ;
    rdfs:subClassOf cim:TimeSeries .

cim:BilateralTransaction a rdfs:Class ;
    rdfs:comment """Bilateral transaction\r
""" .

cim:BillDeterminant a rdfs:Class ;
    rdfs:comment """Models various charges to support billing and settlement.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:BlockDispatchComponent a rdfs:Class ;
    rdfs:subClassOf cim:EnergyComponent .

cim:BlockDispatchInstruction a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BlockDispatchOrder a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BlockingFunction a rdfs:Class .

cim:BranchEndFlow a rdfs:Class ;
    rdfs:comment """Dynamic flows and ratings associated with a branch end.\r
""" .

cim:BranchGroup a rdfs:Class ;
    rdfs:comment """A group of branch terminals whose directed flow summation is to be monitored. A branch group need not form a cutset of the network.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BranchGroupTerminal a rdfs:Class ;
    rdfs:comment "A specific directed terminal flow for a branch group." .

cim:BreakerInfo a rdfs:Class ;
    rdfs:comment """Properties of breaker assets.\r
""" ;
    rdfs:subClassOf cim:OldSwitchInfo .

cim:BusNameMarker a rdfs:Class ;
    rdfs:comment "Used to apply user standard names to TopologicalNodes. Associated with one or more terminals that are normally connected with the bus name.    The associated terminals are normally connected by non-retained switches. For a ring bus station configuration, all BusbarSection terminals in the ring are typically associated.   For a breaker and a half scheme, both BusbarSections would normally be associated.  For a ring bus, all BusbarSections would normally be associated.  For a \"straight\" busbar configuration, normally only the main terminal at the BusbarSection would be associated.  " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BusbarSection a rdfs:Class ;
    rdfs:comment """A conductor, or group of conductors, with negligible impedance, that serve to connect other conducting equipment within a single substation. \r
Voltage measurements are typically obtained from voltage transformers that are connected to busbar sections. A bus bar section may have many physical terminals but for analysis is modelled with exactly one logical terminal.""" ;
    rdfs:subClassOf cim:Connector .

cim:BusbarSectionInfo a rdfs:Class ;
    rdfs:comment """Busbar section data.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:Bushing a rdfs:Class ;
    rdfs:comment "Bushing asset." ;
    rdfs:subClassOf cim:Asset .

cim:BushingInfo a rdfs:Class ;
    rdfs:comment "Bushing datasheet information." ;
    rdfs:subClassOf cim:AssetInfo .

cim:BushingInsulationPF a rdfs:Class ;
    rdfs:comment """Bushing insulation power factor condition as a result of a test.\r
Typical status values are: Acceptable, Minor Deterioration or Moisture Absorption, Major Deterioration or Moisture Absorption, Failed.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:BusinessCase a rdfs:Class ;
    rdfs:comment "Business justification for capital expenditures, usually addressing operations and maintenance costs as well." ;
    rdfs:subClassOf cim:WorkDocument .

cim:BusinessPlan a rdfs:Class ;
    rdfs:comment "A BusinessPlan is an organized sequence of predetermined actions required to complete a future organizational objective. It is a type of document that typically references a schedule, physical and/or logical resources (assets and/or PowerSystemResources), locations, etc." ;
    rdfs:subClassOf cim:Document .

cim:BusinessRole a rdfs:Class ;
    rdfs:comment """A business role that this organisation plays. A single organisation typically performs many functions, each one described as a role.\r
""" ;
    rdfs:subClassOf cim:OrganisationRole .

cim:CAESPlant a rdfs:Class ;
    rdfs:comment """Compressed air energy storage plant.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:CCAinverter a rdfs:Class .

cim:CCArectifierControl a rdfs:Class .

cim:CIGREStandard a rdfs:Class ;
    rdfs:comment "Standard published by CIGRE (Council on Large Electric Systems)." .

cim:CRRMarket a rdfs:Class ;
    rdfs:comment """Model that describes the Congestion Revenue Rights Auction Market.\r
""" ;
    rdfs:subClassOf cim:Market .

cim:CRROrgRole a rdfs:Class ;
    rdfs:comment "Identifies a way in which an organisation may participate with a defined Congestion Revenue Right (CRR)." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:CRRSegment a rdfs:Class ;
    rdfs:comment """CRRSegment represents a segment of a CRR in a particular time frame. \r
\r
The segment class contains amount, clearing price, start date and time, end date and time.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CSCUserDefined a rdfs:Class ;
    rdfs:comment "Current source converter (CSC) function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:CSCDynamics .

cim:CSCtype1 a rdfs:Class ;
    rdfs:subClassOf cim:CSCDynamics .

cim:CTTempActivePowerCurve a rdfs:Class ;
    rdfs:comment """Relationship between the combustion turbine's power output rating in gross active power (X-axis) and the ambient air temperature (Y-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:CUAllowableAction a rdfs:Class ;
    rdfs:comment "Allowed actions: Install, Remove, Transfer, Abandon, etc." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:CUContractorItem a rdfs:Class ;
    rdfs:comment "Compatible unit contractor item." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:CUGroup a rdfs:Class ;
    rdfs:comment "A Compatible Unit Group identifies a set of compatible units which may be jointly utilized for estimating and designating jobs." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:CULaborCode a rdfs:Class ;
    rdfs:comment "Labor code associated with various compatible unit labor items." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:CULaborItem a rdfs:Class ;
    rdfs:comment "Compatible unit labor item." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:CUMaterialItem a rdfs:Class ;
    rdfs:comment "Compatible unit of a consumable supply item. For example, nuts, bolts, brackets, glue, etc." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:CUWorkEquipmentItem a rdfs:Class ;
    rdfs:comment "Compatible unit for various types of WorkEquipmentAssets, including vehicles." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:Cabinet a rdfs:Class ;
    rdfs:comment "Enclosure that offers protection to the equipment it contains and/or safety to people/animals outside it." ;
    rdfs:subClassOf cim:AssetContainer .

cim:CalculationMethodHierarchy a rdfs:Class ;
    rdfs:comment """The hierarchy of calculation methods used to derive this measurement.\r
.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CalculationMethodOrder a rdfs:Class ;
    rdfs:comment """The order of this calculation method in a hierarchy of calculation methods.\r
""" .

cim:Capability a rdfs:Class ;
    rdfs:comment """Capabilities of a crew.\r
""" ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:Capacitance a rdfs:Class ;
    rdfs:comment """Capacitive part of reactance (imaginary part of impedance), at rated frequency.\r
""" .

cim:CapacitancePerLength a rdfs:Class ;
    rdfs:comment "Capacitance per unit of length." .

cim:Card a rdfs:Class ;
    rdfs:comment """Documentation of the tender when it is a type of card (credit, debit, etc).\r
""" .

cim:Cashier a rdfs:Class ;
    rdfs:comment "The operator of the point of sale for the duration of CashierShift. Cashier is under the exclusive management control of Vendor." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CashierShift a rdfs:Class ;
    rdfs:comment "The operating shift for a cashier, during which the cashier may transact against the cashier shift, subject to vendor shift being open." ;
    rdfs:subClassOf cim:Shift .

cim:ChangeSet a rdfs:Class ;
    rdfs:comment "Describes a set of changes that can be applied in different situations.   A given registered target object  MRID may only be referenced once by the contained change set members." ;
    rdfs:subClassOf cim:DataSet .

cim:Channel a rdfs:Class ;
    rdfs:comment """A single path for the collection or reporting of register values over a period of time. For example, a register which measures forward energy can have two channels, one providing bulk quantity readings and the other providing interval readings of a fixed interval size.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Charge a rdfs:Class ;
    rdfs:comment "A charge element associated with other entities such as tariff structures, auxiliary agreements or other charge elements. The total charge amount applicable to this instance of charge is the sum of fixed and variable portion." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ChargeComponent a rdfs:Class ;
    rdfs:comment """A Charge Component is a list of configurable charge quality items to feed into settlement calculation and/or bill determinants.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ChargeGroup a rdfs:Class ;
    rdfs:comment """Charge Group is the grouping of Charge Types for settlement invoicing purpose.  Examples such as Ancillary Services, Interests, etc.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ChargeProfile a rdfs:Class ;
    rdfs:comment """A type of profile for financial charges.\r
""" ;
    rdfs:subClassOf cim:Profile .

cim:ChargeProfileData a rdfs:Class ;
    rdfs:comment """Model of various charges associated with an energy profile to support billing and settlement.\r
""" .

cim:ChargeType a rdfs:Class ;
    rdfs:comment """Charge Type is the basic level configuration for settlement to process specific charges for invoicing purpose. Examples such as: Day Ahead Spinning Reserve Default Invoice Interest Charge, etc.\r
""" ;
    rdfs:subClassOf cim:Document .

cim:Cheque a rdfs:Class ;
    rdfs:comment """The actual tender when it is a type of cheque.\r
""" .

cim:Circuit a rdfs:Class ;
    rdfs:subClassOf cim:Line .

cim:Clamp a rdfs:Class ;
    rdfs:comment """A Clamp is a galvanic connection at a line segment where other equipment is connected. A Clamp does not cut the line segment. \r
A Clamp is ConductingEquipment and has one Terminal with an associated ConnectivityNode. Any other ConductingEquipment can be connected to the Clamp ConnectivityNode.\r
""" ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:ClampAction a rdfs:Class ;
    rdfs:comment "Action on Clamp as a switching step" ;
    rdfs:subClassOf cim:SwitchingAction .

cim:Classification a rdfs:Class ;
    rdfs:comment "Classification of level.  Specify as 1..n, with 1 being the most detailed, highest priority, etc as described on the attribute using this data type." .

cim:ClassificationCondition a rdfs:Class ;
    rdfs:comment "A classification condition used to define preconditions that must be met by a phenomena classification." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ClearanceAction a rdfs:Class ;
    rdfs:comment "Action on clearance document as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:ClearanceDocument a rdfs:Class ;
    rdfs:comment "Safety document used to authorise work on conducting equipment in the field. Tagged equipment is not allowed to be operated." ;
    rdfs:subClassOf cim:SafetyDocument .

cim:CloudCondition a rdfs:Class ;
    rdfs:comment "A classified cloud phenomenon with a type." ;
    rdfs:subClassOf cim:AtmosphericPhenomenon .

cim:CnodeDistributionFactor a rdfs:Class ;
    rdfs:comment """Participation factors per Cnode.  Used to calculate "participation" of Cnode in an AggregateNode. Each Cnode associated to an AggregateNode would be assigned a participation factor for its participation within the AggregateNode. \r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CogenerationPlant a rdfs:Class ;
    rdfs:comment """A set of thermal generating units for the production of electrical energy and process steam (usually from the output of the steam turbines). The steam sendout is typically used for industrial purposes or for municipal heating and cooling.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:ComFunction a rdfs:Class ;
    rdfs:comment "Communication function of communication equipment or a device such as a meter. " ;
    rdfs:subClassOf cim:EndDeviceFunction .

cim:ComMedia a rdfs:Class ;
    rdfs:comment """Communication media such as fibre optic cable, power-line, telephone, etc.\r
""" ;
    rdfs:subClassOf cim:Asset .

cim:ComModule a rdfs:Class ;
    rdfs:comment """An asset having communications capabilities that can be paired with a meter or other end device to provide the device with communication ability, through associated communication function. An end device that has communications capabilities through embedded hardware can use that function directly (without the communication module), or combine embedded communication function with additional communication functions provided through an external communication module (e.g. zigbee).\r
""" ;
    rdfs:subClassOf cim:Asset .

cim:CombinedCycleConfiguration a rdfs:Class ;
    rdfs:comment """Configuration options for combined cycle units.\r
For example, a Combined Cycle with (CT1, CT2, ST1) will have (CT1, ST1) and (CT2, ST1) configurations as part of(1CT + 1STlogicalconfiguration).""" ;
    rdfs:subClassOf cim:RegisteredGenerator .

cim:CombinedCycleConfigurationMember a rdfs:Class ;
    rdfs:comment "Configuration Member of CCP Configuration." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CombinedCycleLogicalConfiguration a rdfs:Class ;
    rdfs:comment """Logical Configuration of a Combined Cycle plant.\r
\r
Operating Combined Cycle Plant (CCP) configurations are represented as Logical CCP Resources. Logical representation shall be used for Market applications to optimize and control Market Operations. Logical representation is also necessary for controlling the number of CCP configurations and to temper performance issues that may otherwise occur. \r
\r
For example,(2CT configuration),(1CT + 1ST configuration) are examples of logical configuration, without specifying the specific CT and ST participating in the configuration.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CombinedCycleTransitionState a rdfs:Class ;
    rdfs:comment "Defines the available from and to Transition States for the Combine Cycle Configurations." .

cim:CombustionTurbine a rdfs:Class ;
    rdfs:comment "A prime mover that is typically fuelled by gas or light oil." ;
    rdfs:subClassOf cim:PrimeMover .

cim:Command a rdfs:Class ;
    rdfs:comment "A Command is a discrete control used for supervisory control." ;
    rdfs:subClassOf cim:Control .

cim:CommitmentClearing a rdfs:Class ;
    rdfs:comment """Models results of market clearing which call for commitment of units.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:Commitments a rdfs:Class ;
    rdfs:comment """Provides the necessary information (on a resource basis) to capture the Startup/Shutdown commitment results. This information is relevant to all markets.\r
""" .

cim:CommodityDefinition a rdfs:Class ;
    rdfs:comment "Commodities in the context of IEC 62325 are MarketProducts (energy, regulation, reserve, etc) traded at a specific location, which in this case is a Pnode (either a specific pricing node or a pricing area or zone defined as a collection of pricing nodes).  The CommodityDefinition is a container for these two parameters, plus the unit of measure and the currency in which the Commodity is traded.  Each CommodityDefinition should be relatively static; defined once and rarely changed." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CommodityPrice a rdfs:Class ;
    rdfs:comment "The CommodityPrice class is used to define the price of a commodity during a given time interval.  The interval may be long, e.g. a year, or very short, e.g. 5 minutes.  There will be many instances of the CommodityPrice class for each instance of the CommodityDefinition to which it is associated.  Note that there may be more than once price associated with a given interval and these variances are described by the association (or associations) with the PriceDescriptor class." .

cim:CompatibleUnit a rdfs:Class ;
    rdfs:comment "A pre-planned job model containing labor, material, and accounting requirements for standardized job planning." ;
    rdfs:subClassOf cim:WorkDocument .

cim:CompleteModelToBeDeleted a rdfs:Class ;
    rdfs:comment "A complete model can be used in applications to perform meaningful calculations, e.g. a study case in offline tools or a real time model in a SCADA/EMS." ;
    rdfs:subClassOf cim:ModelToBeDeleted .

cim:ComplianceEvent a rdfs:Class ;
    rdfs:comment """Compliance events are used for reporting regulatory or contract compliance issues and/or variances. These might be created as a consequence of local business processes and associated rules. It is anticipated that this class will be customised extensively to meet local implementation needs.\r
Use inherited 'type' to indicate that, for example, expected performance will not be met or reported as mandated.\r
""" ;
    rdfs:subClassOf cim:ActivityRecord .

cim:CompositeSwitch a rdfs:Class ;
    rdfs:comment """A model of a set of individual Switches normally enclosed within the same cabinet and possibly with interlocks that restrict the combination of switch positions. These are typically found in medium voltage distribution networks. \r
A CompositeSwitch could represent a Ring-Main-Unit (RMU), or pad-mounted switchgear, with primitive internal devices such as an internal bus-bar plus 3 or 4 internal switches each of which may individually be open or closed. A CompositeSwitch and a set of contained Switches can also be used to represent a multi-position switch e.g. a switch that can connect a circuit to Ground, Open or Busbar.""" ;
    rdfs:subClassOf cim:Equipment .

cim:CompositeSwitchInfo a rdfs:Class ;
    rdfs:comment """Properties of a composite switch.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:ConcentricNeutralCableInfo a rdfs:Class ;
    rdfs:comment "Concentric neutral cable data." ;
    rdfs:subClassOf cim:CableInfo .

cim:ConditionFactor a rdfs:Class ;
    rdfs:comment "This is to specify the various condition factors for a design that may alter the cost estimate or the allocation." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:Conductance a rdfs:Class ;
    rdfs:comment """Factor by which voltage must be multiplied to give corresponding power lost from a circuit. Real part of admittance.\r
""" .

cim:ConductancePerLength a rdfs:Class ;
    rdfs:comment """Real part of admittance per unit of length.\r
""" .

cim:ConfigurationEvent a rdfs:Class ;
    rdfs:comment """Used to report details on creation, change or deletion of an entity or its configuration.\r
""" ;
    rdfs:subClassOf cim:ActivityRecord .

cim:ConformLoad a rdfs:Class ;
    rdfs:comment "ConformLoad represent loads that follow a daily load change pattern where the pattern can be used to scale the load with a system load." ;
    rdfs:subClassOf cim:EnergyConsumer .

cim:ConformLoadGroup a rdfs:Class ;
    rdfs:comment "A group of loads conforming to an allocation pattern. " ;
    rdfs:subClassOf cim:LoadGroup .

cim:ConformLoadSchedule a rdfs:Class ;
    rdfs:comment "A curve of load  versus time (X-axis) showing the active power values (Y1-axis) and reactive power (Y2-axis) for each unit of the period covered. This curve represents a typical pattern of load over the time period for a given day type and season." ;
    rdfs:subClassOf cim:SeasonDayTypeSchedule .

cim:CongestionArea a rdfs:Class ;
    rdfs:comment """Designated Congestion Area Definition (DCA).\r
""" ;
    rdfs:subClassOf cim:AggregatedPnode .

cim:CongestionRevenueRight a rdfs:Class ;
    rdfs:comment """Congestion Revenue Rights (CRR) class that is inherited from a Document class.\r
\r
A CRR is a financial concept that is used to hedge congestion charges.\r
\r
The CRR is usually settled based on the Locational Marginal Prices (LMPs) that are calculated in the day-ahead market. These LMPs are determined by the Day-ahead resource schedules/bids. CRRs will not hedge against marginal losses. If the congestion component of LMP at the sink is greater than at the source, then the CRR owner is entitled to receive a portion of congestion revenues. If the congestion component at the sink is less than at the source, then an obligation-type CRR owner will be charged, but an option-type CRR owner will not.""" ;
    rdfs:subClassOf cim:Document .

cim:ConnectDisconnectFunction a rdfs:Class ;
    rdfs:comment """A function that will disconnect and reconnect the customer's load under defined conditions.\r
""" ;
    rdfs:subClassOf cim:EndDeviceFunction .

cim:ConstraintClearing a rdfs:Class ;
    rdfs:comment """Groups all items associated with Binding Constraints and Constraint Violations per interval and market.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ConstraintDuration a rdfs:Class ;
    rdfs:comment "Duration constraint to activate, to put in operation, to deactivate, ... a given event." .

cim:ConstraintResults a rdfs:Class ;
    rdfs:comment """Provides the Market results for the constraint processing for either the DAM or RTM. The data includes the constraint type (binding or violated), the solved value for the constraint, and the associated shadow price.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ConsumptionTariffInterval a rdfs:Class ;
    rdfs:comment "One of a sequence of intervals defined in terms of consumption quantity of a service such as electricity, water, gas, etc. It is typically used in association with TariffProfile to define the steps or blocks in a step tariff structure, where startValue simultaneously defines the entry value of this step and the closing value of the previous step. Where consumption is >= startValue it falls within this interval and where consumption is < startValue it falls within the previous interval." .

cim:ContingencyConstraintLimit a rdfs:Class ;
    rdfs:comment """Possibly time-varying max MW or MVA and optionally Min MW limit or MVA limit (Y1 and Y2, respectively) assigned to a constraint for a specific contingency. Use CurveSchedule XAxisUnits to specify MW or MVA.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:ContingencyEquipment a rdfs:Class ;
    rdfs:comment "Equipment whose in service status is to change, such as a power transformer or AC line segment." ;
    rdfs:subClassOf cim:ContingencyElement .

cim:ContractDistributionFactor a rdfs:Class ;
    rdfs:comment """Distribution among resources at the sink point or source point.\r
""" .

cim:ContractRight a rdfs:Class ;
    rdfs:comment "Provides definition of Transmission Ownership Right and Existing Transmission Contract identifiers for use by SCUC. RMR contract hosting: Startup lead time, Contract Service Limits, Max Service Hours, Max MWhs, Max Start-ups, Ramp Rate, Max Net Dependable Capacity, Min Capacity and Unit Substitution for DAM/RTM to retrieve." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ContractorItem a rdfs:Class ;
    rdfs:comment "Contractor information for work task." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:ControlAction a rdfs:Class ;
    rdfs:comment "Control executed as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:ControlAreaDesignation a rdfs:Class ;
    rdfs:comment "Indicates Control Area associated with self-schedule." .

cim:ControlAreaGeneratingUnit a rdfs:Class ;
    rdfs:comment "A control area generating unit. This class is needed so that alternate control area definitions may include the same generating unit.   It should be noted that only one instance within a control area should reference a specific generating unit." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ControlAreaOperator a rdfs:Class ;
    rdfs:comment """Operates the Control Area. Approves and implements energy transactions. Verifies both Inter-Control Area and Intra-Control Area transactions for the power system  before granting approval (and implementing) the transactions.\r
""" ;
    rdfs:subClassOf cim:Organisation .

cim:ControlAreaSolutionData a rdfs:Class ;
    rdfs:comment """State Estimator Solution Pool Interchange and Losses.\r
""" .

cim:ControlledAppliance a rdfs:Class ;
    rdfs:comment """Appliance controlled with a PAN device control.\r
""" .

cim:CoolingPowerRating a rdfs:Class ;
    rdfs:comment """There are often stages of power which are associated with stages of cooling. For instance, a transformer may be rated 121kV on the primary, 15kV on the secondary and 4kV on the tertiary winding. These are voltage ratings and the power ratings are generally the same for all three windings and independent of the voltage ratings, there are instances where the tertiary may have a lower power rating.\r
For example, for three stages, the power rating may be 15/20/25 MVA and the cooling is OA/FA/FOA. The 15 MVA rating goes with the OA cooling (Oil and Air cooling). This is called the self cooled rating as there are no external cooling enhancements. The 20 MVA rating goes with the FA cooling (Forced Air cooling), this means that when the fans are running and thus enhancing the cooling characteristics, the transformer can operate at a power level of 20 MVA. The 25 MVA rating goes with the FOA cooling (Forced Oil and Air cooling), this means that when the fans and pumps are running and thus enhancing the cooling characteristics even more than before, the transformer can operate at a power level of 25 MVA. This 15/20/25 MVA does not state how the power is split between the various windings. It may be 25 MVA input on the primary, 25 MVA output on the secondary and 0 MVA output on the tertiary. It may also operate at 25 MVA input on the primary, 17 MVA output on the secondary and 8 MVA output on the tertiary.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CoordinateSystem a rdfs:Class ;
    rdfs:comment """Coordinate reference system.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CostPerEnergyUnit a rdfs:Class ;
    rdfs:comment """Cost, in units of currency, per quantity of electrical energy generated.\r
""" .

cim:CostPerHeatUnit a rdfs:Class ;
    rdfs:comment """Cost, in units of currency, per quantity of heat generated.\r
""" .

cim:CostPerVolume a rdfs:Class ;
    rdfs:comment """Cost per unit volume.\r
""" .

cim:CostRate a rdfs:Class ;
    rdfs:comment "Cost, in units of currency, per elapsed time." .

cim:CostType a rdfs:Class ;
    rdfs:comment "A categorization for resources, often costs, in accounting transactions. Examples include: material components, building in service, coal sales, overhead, etc." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:Craft a rdfs:Class ;
    rdfs:comment """Craft of a person or a crew. Examples include overhead electric, underground electric, high pressure gas, etc. This ensures necessary knowledge and skills before being allowed to perform certain types of work.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CrewType a rdfs:Class ;
    rdfs:comment "Custom description of the type of crew. This may be used to determine the type of work the crew can be assigned to. Examples include repair, tree trimming, switching, etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CsConverter a rdfs:Class ;
    rdfs:comment """DC side of the current source converter (CSC).\r
The firing angle controls the dc voltage at the converter, both for rectifier and inverter. The difference between the dc voltages of the rectifier and inverter determines the dc current. The extinction angle is used to limit the dc voltage at the inverter, if needed, and is not used in active power control. The firing angle, transformer tap position and number of connected filters are the primary means to control a current source dc line. Higher level controls are built on top, e.g. dc voltage, dc current and active power. From a steady state perspective it is sufficient to specify the wanted active power transfer (ACDCConverter.targetPpcc) and the control functions will set the dc voltage, dc current, firing angle, transformer tap position and number of connected filters to meet this. Therefore attributes targetAlpha and targetGamma are not applicable in this case.\r
The reactive power consumed by the converter is a function of the firing angle, transformer tap position and number of connected filter, which can be approximated with half of the active power. The losses is a function of the dc voltage and dc current.\r
The attributes minAlpha and maxAlpha define the range of firing angles for rectifier operation between which no discrete tap changer action takes place. The range is typically 10-18 degrees.\r
The attributes minGamma and maxGamma define the range of extinction angles for inverter operation between which no discrete tap changer action takes place. The range is typically 17-20 degrees.""" ;
    rdfs:subClassOf cim:ACDCConverter .

cim:CurrentEmergencyScheduledInterchange a rdfs:Class ;
    rdfs:comment """Control area emergency schedules\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CurrentFlow a rdfs:Class ;
    rdfs:comment "Electrical current with sign convention: positive flow is out of the conducting equipment into the connectivity node. Can be both AC and DC." .

cim:CurrentLimit a rdfs:Class ;
    rdfs:comment "Operational limit on current. " ;
    rdfs:subClassOf cim:OperationalLimit .

cim:CurrentRelay a rdfs:Class ;
    rdfs:comment "A device that checks current flow values in any direction or designated direction." ;
    rdfs:subClassOf cim:ProtectionEquipment .

cim:CurrentScheduledInterchange a rdfs:Class ;
    rdfs:comment """Control area current net tie (scheduled interchange) sent to real time dispatch.\r
""" .

cim:CurrentState a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:CurrentTransformer a rdfs:Class ;
    rdfs:comment "Instrument transformer used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as current transducer for the purpose of metering or protection. A typical secondary current rating would be 5A." ;
    rdfs:subClassOf cim:Sensor .

cim:CurrentTransformerInfo a rdfs:Class ;
    rdfs:comment """Properties of current transformer asset.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:CurtailmentProfile a rdfs:Class ;
    rdfs:comment """Curtailing entity must be providing at least one service to the EnergyTransaction. The CurtailmentProfile must be completely contained within the EnergyProfile timeframe for this EnergyTransaction.\r
""" ;
    rdfs:subClassOf cim:Profile .

cim:Customer a rdfs:Class ;
    rdfs:comment "Organisation receiving services from service supplier." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:CustomerAccount a rdfs:Class ;
    rdfs:comment "Assignment of a group of products and services purchased by the customer through a customer agreement, used as a mechanism for customer billing and payment. It contains common information from the various types of customer agreements to create billings (invoices) for a customer and receive payment." ;
    rdfs:subClassOf cim:Document .

cim:CustomerAgreement a rdfs:Class ;
    rdfs:comment "Agreement between the customer and the service supplier to pay for service at a specific service location. It records certain billing information about the type of service provided at the service location and is used during charge creation to determine the type of service." ;
    rdfs:subClassOf cim:Agreement .

cim:CustomerBillingInfo a rdfs:Class ;
    rdfs:comment """The creation of the monthly customer billing statements is the method employed to notify Customers of charges, adjustments and credits applied to their account for Services and Products. The actuall billing occurs through an ErpInvoice. The CustomerBillingInfo includes information from the payment, collection, meter reading, installed meter, service, site, customer, customer account, customer agreement, services and pricing subject areas. Each component price shows up as a separate line item on the ErpInvoice.\r
The Customer Billing Statement may include collection and account messages, marketing/civic event messages and bill inserts.\r
One Customer Billing Statement is produced for all Agreements under a CustomerAccount per billing cycle date defined in 'CustomerAccount.billingCycle'.\r
The history of CustomerBillingInfo, Invoices and Payments is to be maintained in associated ActivityRecords.""" ;
    rdfs:subClassOf cim:Document .

cim:CustomerConsumer a rdfs:Class ;
    rdfs:comment """The energy buyer in the energy marketplace.\r
""" ;
    rdfs:subClassOf cim:Organisation .

cim:CustomerNotification a rdfs:Class ;
    rdfs:comment "Conditions for notifying the customer about the changes in the status of their service (e.g., outage restore, estimated restoration time, tariff or service level change, etc.)" .

cim:Cut a rdfs:Class ;
    rdfs:comment """A cut separates a line segment into two parts. The cut appears as a switch inserted between these two parts and connects them together. As the cut is normally open there is no galvanic connection between the two line segment parts. But it is possible to close the cut to get galvanic connection.\r
The cut terminals are oriented towards the line segment terminals with the same sequence number. Hence the cut terminal with sequence number equal to 1 is oriented to the line segment's terminal with sequence number equal to 1.\r
The cut terminals also act as connection points for jumpers and other equipment, e.g. a mobile generator. To enable this, connectivity nodes are placed at the cut terminals. Once the connectivity nodes are in place any conducting equipment can be connected at them.\r
""" ;
    rdfs:subClassOf cim:Switch .

cim:CutAction a rdfs:Class ;
    rdfs:comment "Action on cut as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:DCBreaker a rdfs:Class ;
    rdfs:comment "A breaker within a DC system. " ;
    rdfs:subClassOf cim:DCSwitch .

cim:DCBusbar a rdfs:Class ;
    rdfs:comment "A busbar within a DC system." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DCChopper a rdfs:Class ;
    rdfs:comment "Low resistance equipment used in the internal DC circuit to balance voltages. It has typically positive and negative pole terminals and a ground." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DCConverterUnit a rdfs:Class ;
    rdfs:comment "Indivisible operative unit comprising all equipment between the point of common coupling on the AC side and the point of common coupling – DC side, essentially one or more converters, together with one or more converter transformers, converter control equipment, essential protective and switching devices and auxiliaries, if any, used for conversion." ;
    rdfs:subClassOf cim:DCEquipmentContainer .

cim:DCDisconnector a rdfs:Class ;
    rdfs:comment "A disconnector within a DC system." ;
    rdfs:subClassOf cim:DCSwitch .

cim:DCGround a rdfs:Class ;
    rdfs:comment "A ground within a DC system." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DCLine a rdfs:Class ;
    rdfs:comment "Overhead lines and/or cables connecting two or more HVDC substations." ;
    rdfs:subClassOf cim:DCEquipmentContainer .

cim:DCLineSegment a rdfs:Class ;
    rdfs:comment "A wire or combination of wires not insulated from one another, with consistent electrical characteristics, used to carry direct current between points in the DC region of the power system." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DCNode a rdfs:Class ;
    rdfs:comment "DC nodes are points where terminals of DC conducting equipment are connected together with zero impedance." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DCSeriesDevice a rdfs:Class ;
    rdfs:comment "A series device within the DC system, typically a reactor used for filtering or smoothing.  Needed for transient and short circuit studies." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DCShunt a rdfs:Class ;
    rdfs:comment "A shunt device within the DC system, typically used for filtering.  Needed for transient and short circuit studies." ;
    rdfs:subClassOf cim:DCConductingEquipment .

cim:DCTerminal a rdfs:Class ;
    rdfs:comment "An electrical connection point to generic DC conducting equipment." ;
    rdfs:subClassOf cim:DCBaseTerminal .

cim:DCTopologicalIsland a rdfs:Class ;
    rdfs:comment """An electrically connected subset of the network. DC topological islands can change as the current network state changes, e.g. due to: \r
- disconnect switches or breakers changing state in a SCADA/EMS.\r
- manual creation, change or deletion of topological nodes in a planning tool.\r
Only energised TopologicalNode-s shall be part of the topological island.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DCTopologicalNode a rdfs:Class ;
    rdfs:comment "DC bus." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DCvoltageControl a rdfs:Class ;
    rdfs:comment "DC voltage control used for voltage regulation." .

cim:DERCurveData a rdfs:Class ;
    rdfs:comment """The DER curve data class provides the nominal, maximum and minimum values for a DER Monitorable parameter for a series of time intervals defined by the DER DispatchSchedule.\r
""" .

cim:DERFunction a rdfs:Class ;
    rdfs:comment """Specifies the list of functions that are supported.\r
\r
""" .

cim:DERGroupDispatch a rdfs:Class ;
    rdfs:comment """Specifies the capabilities of the DER Group that are to be dispatched according to a schedule.  Each dispatch identifies a DER Group and the specific monitorable parameter to be dispatched over a specific time interval.\r
\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DERGroupForecast a rdfs:Class ;
    rdfs:comment """Specifies the forecasted values of the DERMonitorableParameters for a DER Group over a specific time interval.\r
\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DERMonitorableParameter a rdfs:Class ;
    rdfs:comment """To define the DER monitorable parameters that will be forecasted and dispatched for a DER Group.  Each parameter is represented as a Y Value at a point in time or on a curve as a function of time, which is represented on the X axis.\r
\r
""" .

cim:DINStandard a rdfs:Class ;
    rdfs:comment "Standard published by DIN (German Institute of Standards)." .

cim:Damping a rdfs:Class ;
    rdfs:comment "Per-unit active power variation with frequency referenced on the system apparent power base. Typical values are in the range 1,0 - 2,0." .

cim:DatasetArg a rdfs:Class ;
    rdfs:comment "A model operation argument referencing a dataset instance." ;
    rdfs:subClassOf cim:ModelOperationArg .

cim:DatasetArgDescription a rdfs:Class ;
    rdfs:subClassOf cim:ModelOperationArgDescription .

cim:DateAndOrTime a rdfs:Class ;
    rdfs:comment "The date and/or the time." .

cim:DateInterval a rdfs:Class ;
    rdfs:comment """Interval between two dates.\r
""" .

cim:DateTimeInterval a rdfs:Class ;
    rdfs:comment "Interval between two date and time points, where the interval includes the start time but excludes end time.  " .

cim:DayType a rdfs:Class ;
    rdfs:comment """Group of similar days.   For example it could be used to represent weekdays, weekend, or holidays.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DecimalQuantity a rdfs:Class ;
    rdfs:comment "Quantity with decimal value and associated unit or currency information." .

cim:DefaultBid a rdfs:Class ;
    rdfs:comment """DefaultBid is a generic class to hold Default Energy Bid, Default Startup Bid, and Default Minimum Load Bid:\r
\r
Default Energy Bid\r
A Default Energy Bid is a monotonically increasing staircase function consisting at maximum 10 economic bid segments, or 10 ($/MW, MW) pairs. There are three methods for determining the Default Energy Bid:\r
<ul>\r
	<li>Cost Based: derived from the Heat Rate or Average Cost multiplied by the Gas Price Index plus 10%.</li>\r
	<li>LMP Based: a weighted average of LMPs in the preceding 90 days.</li>\r
	<li>Negotiated: an amount negotiated with the designated Independent Entity.</li>\r
</ul>\r
\r
Default Startup Bid\r
A Default Startup Bid (DSUB) shall be calculated for each RMR unit based on the Startup Cost stored in the Master File and the applicable GPI and EPI.\r
\r
Default Minimum Load Bid\r
A Default Minimum Load Bid (DMLB) shall be calculated for each RMR unit based on the Minimum Load Cost stored in the Master File and the applicable GPI.""" ;
    rdfs:subClassOf cim:Bid .

cim:DefaultBidCurve a rdfs:Class ;
    rdfs:comment """Default bid curve for default energy bid curve and default startup curves (cost and time).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:DefaultBidCurveData a rdfs:Class ;
    rdfs:comment """Curve data for default bid curve and startup cost curve.\r
""" ;
    rdfs:subClassOf cim:CurveData .

cim:DefaultConstraintLimit a rdfs:Class ;
    rdfs:comment """Possibly time-varying max MW or MVA and optionally Min MW limit or MVA limit (Y1 and Y2, respectively) applied as a default value if no specific constraint limits are specified for a contingency analysis. Use CurveSchedule XAxisUnits to specify MW or MVA.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:Delay a rdfs:Class ;
    rdfs:comment "All the measurements are filtered by a first lag element with a time constant TM." .

cim:DemandResponseProgram a rdfs:Class ;
    rdfs:comment "Demand response program." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DeploymentDate a rdfs:Class ;
    rdfs:comment "Dates for deployment events of an asset.  May have multiple deployment type dates for this device and a compound type allows a query to return multiple dates." .

cim:Design a rdfs:Class ;
    rdfs:comment """A design for consideration by customers, potential customers, or internal work.\r
Note that the Version of design is the revision attribute that is inherited from Document.""" ;
    rdfs:subClassOf cim:WorkDocument .

cim:DesignLocation a rdfs:Class ;
    rdfs:comment "A logical part of the design (e.g., pole and all equipment on a pole). This includes points and spans." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:DesignLocationCU a rdfs:Class ;
    rdfs:comment "Compatible unit at a given design location." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:DiagnosisDataSet a rdfs:Class ;
    rdfs:comment "The result of a problem (typically an asset failure) diagnosis. Contains complete information like what might be received from a lab doing forensic analysis of a failed asset. " ;
    rdfs:subClassOf cim:ProcedureDataSet .

cim:Diagram a rdfs:Class ;
    rdfs:comment "The diagram being exchanged. The coordinate system is a standard Cartesian coordinate system and the orientation attribute defines the orientation. The initial view related attributes can be used to specify an initial view with the x,y coordinates of the diagonal points." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DiagramObjectGluePoint a rdfs:Class ;
    rdfs:comment """This is used for grouping diagram object points from different diagram objects that are considered to be glued together in a diagram even if they are not at the exact same coordinates.\r
""" .

cim:DiagramObjectPoint a rdfs:Class ;
    rdfs:comment """A point in a given space defined by 3 coordinates and associated to a diagram object.  The coordinates may be positive or negative as the origin does not have to be in the corner of a diagram.  \r
""" .

cim:DiagramObjectStyle a rdfs:Class ;
    rdfs:comment "A reference to a style used by the originating system for a diagram object.  A diagram object style describes information such as line thickness, shape such as circle or rectangle etc, and colour." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DiagramStyle a rdfs:Class ;
    rdfs:comment "The diagram style refers to a style used by the originating system for a diagram.  A diagram style describes information such as schematic, geographic, etc." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DifferentialModel a rdfs:Class ;
    rdfs:comment "A set of statements describing the changes in the network model. The statement is defined in the incremental model. " .

cim:DimensionsInfo a rdfs:Class ;
    rdfs:comment "As applicable, the basic linear, area, or volume dimensions of an asset, asset type (AssetModel) or other type of object (such as land area). Units and multipliers are specified per dimension." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DiscExcContIEEEDEC1A a rdfs:Class ;
    rdfs:comment """IEEE type DEC1A discontinuous excitation control model that boosts generator excitation to a level higher than that demanded by the voltage regulator and stabilizer immediately following a system fault.\r
Reference: IEEE 421.5-2005, 12.2. """ ;
    rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics .

cim:DiscExcContIEEEDEC2A a rdfs:Class ;
    rdfs:comment """IEEE type DEC2A model for discontinuous excitation control. This system provides transient excitation boosting via an open-loop control as initiated by a trigger signal generated remotely.\r
Reference: IEEE 421.5-2005 12.3. """ ;
    rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics .

cim:DiscExcContIEEEDEC3A a rdfs:Class ;
    rdfs:comment """IEEE type DEC3A model. In some systems, the stabilizer output is disconnected from the regulator immediately following a severe fault to prevent the stabilizer from competing with action of voltage regulator during the first swing.\r
Reference: IEEE 421.5-2005 12.4. """ ;
    rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics .

cim:DisconnectingCircuitBreaker a rdfs:Class ;
    rdfs:comment "A circuit breaking device including disconnecting function, eliminating the need for separate disconnectors." ;
    rdfs:subClassOf cim:Breaker .

cim:Disconnector a rdfs:Class ;
    rdfs:comment "A manually operated or motor operated mechanical switching device used for changing the connections in a circuit, or for isolating a circuit or equipment from a source of power. It is required to open or close circuits when negligible current is broken or made. " ;
    rdfs:subClassOf cim:Switch .

cim:DiscontinuousExcitationControlUserDefined a rdfs:Class ;
    rdfs:comment "Discontinuous excitation control function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics .

cim:DiscreteMeasurementValueQuality a rdfs:Class ;
    rdfs:comment "Measurement quality flags for Discrete Values." ;
    rdfs:subClassOf cim:MeasurementValueQuality .

cim:DiscreteValue a rdfs:Class ;
    rdfs:comment "DiscreteValue represents a discrete MeasurementValue." ;
    rdfs:subClassOf cim:MeasurementValue .

cim:DispatchInstReply a rdfs:Class ;
    rdfs:comment """Response from registered resource acknowledging receipt of dispatch instructions.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DispatchSchedule a rdfs:Class ;
    rdfs:comment """Specifies the characteristics of the time schedule over which DERMonitorableParameters are dispatched.\r
\r
""" .

cim:Displacement a rdfs:Class ;
    rdfs:comment "Unit of displacement relative to a reference position, hence can be negative." .

cim:DistributedResourceActualEvent a rdfs:Class ;
    rdfs:comment "A demand response event is created when there is a need to call upon resources to respond to demand adjustment requests. These events are created by ISO/RTO system operations and managed  by a demand response management system (DRMS). These events may or may not be coordinated with the Market Events and a defined Energy Market. The event will call for the deployment of a number of registered resources, or for deployment of resources within a zone (an organizational area within the power system that contains a number of resources)." ;
    rdfs:subClassOf cim:MarketActualEvent .

cim:DistributionFactorSet a rdfs:Class ;
    rdfs:comment """A containing class that groups all the distribution factors within a market.   \r
This is calculated daily for DA factors and hourly for RT factors.\r
""" .

cim:DobleStandard a rdfs:Class ;
    rdfs:comment "Standard published by Doble." .

cim:DocumentOrganisationRole a rdfs:Class ;
    rdfs:comment """Role an organisation plays with respect to documents.\r
""" ;
    rdfs:subClassOf cim:OrganisationRole .

cim:Domain a rdfs:Class ;
    rdfs:comment """An area of activity defined within the energy market.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:DopInstruction a rdfs:Class ;
    rdfs:comment """Provides the necessary information (on a resource basis) to capture the Dispatch Operating Point (DOP) results on a Dispatch interval. This information is only relevant to the RT interval market.\r
""" .

cim:DotInstruction a rdfs:Class ;
    rdfs:comment """Provides the necessary information (on a resource basis) to capture the Dispatch Operating Target (DOT) results on a Dispatch interval. This information is only relevant to the RT interval market.\r
""" .

cim:DrumBoiler a rdfs:Class ;
    rdfs:comment """Drum boiler.\r
""" ;
    rdfs:subClassOf cim:FossilSteamSupply .

cim:DuctBank a rdfs:Class ;
    rdfs:comment """A duct contains individual wires in the layout as specified with associated wire spacing instances; number of them gives the number of conductors in this duct.\r
""" ;
    rdfs:subClassOf cim:AssetContainer .

cim:Due a rdfs:Class ;
    rdfs:comment "Details on amounts due for an account." .

cim:DynamicSchedule a rdfs:Class ;
    rdfs:comment """A continuously variable component of a control area's MW net interchange schedule. Dynamic schedules are sent and received by control areas.\r
""" ;
    rdfs:subClassOf cim:BasicIntervalSchedule .

cim:EPAStandard a rdfs:Class ;
    rdfs:comment "Standard published by EPA (United States Environmental Protection Agency)." .

cim:Earthquake a rdfs:Class ;
    rdfs:comment "An earthquake." ;
    rdfs:subClassOf cim:GeosphericPhenomenon .

cim:Editor a rdfs:Class ;
    rdfs:comment "Person who modified the document." ;
    rdfs:subClassOf cim:DocumentPersonRole .

cim:ElectronicAddress a rdfs:Class ;
    rdfs:comment "Electronic address information." .

cim:Emission a rdfs:Class ;
    rdfs:comment """Quantity of emission per fuel heat content.\r
""" .

cim:EmissionAccount a rdfs:Class ;
    rdfs:comment """Accounts for tracking emissions usage and credits for thermal generating units. A unit may have zero or more emission accounts, and will typically have one for tracking usage and one for tracking credits.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:EmissionCurve a rdfs:Class ;
    rdfs:comment """Relationship between the unit's emission rate in units of mass per hour (Y-axis) and output active power (X-axis) for a given type of emission. This curve applies when only one type of fuel is being burned.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:EndDeviceCapability a rdfs:Class ;
    rdfs:comment """Inherent capabilities of an end device (i.e., the functions it supports).\r
""" .

cim:EndDeviceControl a rdfs:Class ;
    rdfs:comment """Instructs an end device (or an end device group) to perform a specified action.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EndDeviceControlType a rdfs:Class ;
    rdfs:comment "Detailed description for a control produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device controls as follows: <type>.<domain>.<subDomain>.<eventOrAction>." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EndDeviceEvent a rdfs:Class ;
    rdfs:comment "Event detected by a device function associated with the end device." ;
    rdfs:subClassOf cim:ActivityRecord .

cim:EndDeviceEventDetail a rdfs:Class ;
    rdfs:comment """Name-value pair, specific to end device events.\r
""" .

cim:EndDeviceEventType a rdfs:Class ;
    rdfs:comment "Detailed description for an event produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device events as follows: <type>.<domain>.<subDomain>.<eventOrAction>." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EndDeviceGroup a rdfs:Class ;
    rdfs:comment "Abstraction for management of group communications within a two-way AMR system or the data for a group of related end devices. Commands can be issued to all of the end devices that belong to the group using a defined group address and the underlying AMR communication infrastructure. A DERGroup and a PANDeviceGroup is an EndDeviceGroup." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EndDeviceInfo a rdfs:Class ;
    rdfs:comment """End device data.\r
""" ;
    rdfs:subClassOf cim:AssetInfo .

cim:EndDeviceTiming a rdfs:Class ;
    rdfs:comment """Timing for the control actions of end devices.\r
""" .

cim:EnergyConsumerAction a rdfs:Class ;
    rdfs:comment "Action to connect or disconnect the Energy Consumer from its Terminal" ;
    rdfs:subClassOf cim:SwitchingAction .

cim:EnergyConsumerPhase a rdfs:Class ;
    rdfs:comment """A single phase of an energy consumer.\r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:EnergyGroup a rdfs:Class ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:EnergyMarket a rdfs:Class ;
    rdfs:comment "Energy and Ancillary Market (e.g. Energy, Spinning Reserve, Non-Spinning Reserve) with a description of the Market operation control parameters." ;
    rdfs:subClassOf cim:Market .

cim:EnergyPriceCurve a rdfs:Class ;
    rdfs:comment """Relationship between a price in $(or other monetary unit) /hour (Y-axis) and a MW value (X-axis). \r
""" .

cim:EnergyPriceIndex a rdfs:Class ;
    rdfs:comment "An Energy Price Index for each Resource is valid for a period (e.g. daily) that is identified by a Valid Period Start Time and a Valid Period End Time. An Energy Price Index is in $/MWh." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EnergyProduct a rdfs:Class ;
    rdfs:comment """An EnergyProduct is offered commercially as a ContractOrTariff.\r
""" ;
    rdfs:subClassOf cim:Agreement .

cim:EnergyProfile a rdfs:Class ;
    rdfs:comment "Specifies the start time, stop time, level for an EnergyTransaction." ;
    rdfs:subClassOf cim:Profile .

cim:EnergySchedulingType a rdfs:Class ;
    rdfs:comment "Used to define the type of generation for scheduling purposes." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EnergySource a rdfs:Class ;
    rdfs:comment "A generic equivalent for an energy supplier on a transmission or distribution voltage level." ;
    rdfs:subClassOf cim:EnergyConnection .

cim:EnergySourceAction a rdfs:Class ;
    rdfs:comment "Action on energy source as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:EnergySourcePhase a rdfs:Class ;
    rdfs:comment "Represents the single phase information of an unbalanced energy source." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:EnergyTransaction a rdfs:Class ;
    rdfs:comment "Specifies the schedule for energy transfers between interchange areas that are necessary to satisfy the associated interchange transaction." ;
    rdfs:subClassOf cim:Document .

cim:EnergyTypeReference a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EnvironmentalAlert a rdfs:Class ;
    rdfs:comment "An environmental alert issued by a provider or system." ;
    rdfs:subClassOf cim:ActivityRecord .

cim:EnvironmentalCodedValue a rdfs:Class ;
    rdfs:comment "An environmental value described using a coded value. A triplicate of enumerated values representing intensity, coverage, type of weather is used. These may be concatenated into the string value." ;
    rdfs:subClassOf cim:StringMeasurementValue .

cim:EnvironmentalDataAuthority a rdfs:Class ;
    rdfs:comment "An entity defining classifications or categories of environmental information, like phenomena or alerts." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:EnvironmentalDataProvider a rdfs:Class ;
    rdfs:comment "Entity providing environmental data.  Could be an observed weather data provider, an entity providing forecasts, an authority providing alerts, etc." ;
    rdfs:subClassOf cim:OrganisationRole .

cim:EnvironmentalDiscrete a rdfs:Class ;
    rdfs:comment "Discrete (integer) measurement of relevance in the environmental domain." ;
    rdfs:subClassOf cim:Discrete .

cim:EnvironmentalEvent a rdfs:Class ;
    rdfs:comment """An environmental event to which one or more forecasts or observations may be tied and which may relate to or affect one or more assets.\r
This class is intended to be used as a means of grouping forecasts and/or observations and could be used for a variety of purposes, including:\r
<ul>\r
	<li>to define a 'named' event like Hurricane Katrina and allow the historic (or forecast) values for phenomena and measurements (precipitation, temperature) across time to be  associated with it</li>\r
	<li>to identify assets that were (or are forecast to be) affected by a phenomenon or set of measurements</li>\r
</ul>""" ;
    rdfs:subClassOf cim:ActivityRecord .

cim:EnvironmentalLocationType a rdfs:Class ;
    rdfs:comment "Type of environmental location. Used when an environmental alert or phenomenon has multiple locations associated with it." .

cim:EnvironmentalMonitoringStation a rdfs:Class ;
    rdfs:comment "An environmental monitoring station, examples of which could be a weather station or a seismic monitoring station.  " ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EnvironmentalStringMeasurement a rdfs:Class ;
    rdfs:comment "String measurement of relevance in the environmental domain." ;
    rdfs:subClassOf cim:StringMeasurement .

cim:EquipmentFault a rdfs:Class ;
    rdfs:comment "A fault applied at the terminal, external to the equipment. This class is not used to specify faults internal to the equipment." ;
    rdfs:subClassOf cim:Fault .

cim:EquipmentLimitSeriesComponent a rdfs:Class ;
    rdfs:comment "This represents one instance of an equipment that contributes to the calculation of an operational limit." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EquipmentUnavailabilitySchedule a rdfs:Class ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:EquivalentBranch a rdfs:Class ;
    rdfs:comment "The class represents equivalent branches. In cases where a transformer phase shift is modelled and the EquivalentBranch is spanning the same nodes, the impedance quantities for the EquivalentBranch shall consider the needed phase shift." ;
    rdfs:subClassOf cim:EquivalentEquipment .

cim:EquivalentInjection a rdfs:Class ;
    rdfs:comment "This class represents equivalent injections (generation or load).  Voltage regulation is allowed only at the point of connection." ;
    rdfs:subClassOf cim:EquivalentEquipment .

cim:EquivalentNetwork a rdfs:Class ;
    rdfs:comment "A class that groups electrical equivalents, including internal nodes, of a network that has been reduced. The ConnectivityNodes contained in the equivalent are intended to reflect internal nodes of the equivalent. The boundary Connectivity nodes where the equivalent connects outside itself are not contained by the equivalent." ;
    rdfs:subClassOf cim:ConnectivityNodeContainer .

cim:EquivalentShunt a rdfs:Class ;
    rdfs:comment "The class represents equivalent shunts." ;
    rdfs:subClassOf cim:EquivalentEquipment .

cim:ErpBOM a rdfs:Class ;
    rdfs:comment """Information that generally describes the Bill of Material Structure and its contents for a utility.\r
\r
This is used by ERP systems to transfer Bill of Material information between two business applications.""" ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpBankAccount a rdfs:Class ;
    rdfs:comment """Relationship under a particular name, usually evidenced by a deposit against which withdrawals can be made. Types of bank accounts include: demand, time, custodial, joint, trustee, corporate, special, and regular accounts.\r
A statement of transactions during a fiscal period and the resulting balance is maintained on each account.\r
For Payment metering, the account is associated with Bank and Supplier, reflecting details of the bank account used for depositing revenue collected by TokenVendor. The name of the account holder should be specified in 'name' attribute.""" ;
    rdfs:subClassOf cim:BankAccount .

cim:ErpBomItemData a rdfs:Class ;
    rdfs:comment "An individual item on a bill of materials." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpChartOfAccounts a rdfs:Class ;
    rdfs:comment "Accounting structure of a business. Each account represents a financial aspect of a business, such as its Accounts Payable, or the value of its inventory, or its office supply expenses." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpCompetency a rdfs:Class ;
    rdfs:comment "Information that describes aptitudes of a utility employee. Unlike Skills that an ErpPerson must be certified to perform before undertaking certain type of assignments (to be able to perfrom a Craft), ErpCompetency has more to do with typical Human Resource (HR) matters such as schooling, training, etc." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpEngChangeOrder a rdfs:Class ;
    rdfs:comment "General Utility Engineering Change Order information." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpInventory a rdfs:Class ;
    rdfs:comment "Utility inventory-related information about an item or part (and not for description of the item and its attributes). It is used by ERP applications to enable the synchronization of Inventory data that exists on separate Item Master databases. This data is not the master data that describes the attributes of the item such as dimensions, weight, or unit of measure - it describes the item as it exists at a specific location." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpInventoryCount a rdfs:Class ;
    rdfs:comment """This is related to Inventory physical counts organized by AssetModel. Note that a count of a type of asset can be accomplished by the association inherited by AssetModel (from Document) to Asset.\r
It enables ERP applications to transfer an inventory count between ERP and the actual physical inventory location. This count may be a cycle count or a physical count.""" ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpInvoice a rdfs:Class ;
    rdfs:comment """A roll up of invoice line items. The whole invoice has a due date and amount to be paid, with information such as customer, banks etc. being obtained through associations. The invoice roll up is based on individual line items that each contain amounts and descriptions for specific services or products.\r
""" ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpInvoiceLineItem a rdfs:Class ;
    rdfs:comment "An individual line item on an invoice." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpIssueInventory a rdfs:Class ;
    rdfs:comment "Can be used to request an application to process an issue or request information about an issue." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpItemMaster a rdfs:Class ;
    rdfs:comment """Any unique purchased part for manufactured product tracked by ERP systems for a utility.\r
Item, as used by the OAG, refers to the basic information about an item, including its attributes, cost, and locations. It does not include item quantities. Compare to the Inventory, which includes all quantities and other location-specific information.""" ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpJournal a rdfs:Class ;
    rdfs:comment """Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal, which is like a diary of instructions, advising which account to be charged and by how much.\r
A journal represents a change in the balances of a business's financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice, paying a vendor, transferring inventory, or paying employees.""" ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpJournalEntry a rdfs:Class ;
    rdfs:comment """Details of an individual entry in a journal, which is to be posted to a ledger on the posting date.\r
""" ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpLedBudLineItem a rdfs:Class ;
    rdfs:comment "Individual entry of a given Ledger Budget, typically containing information such as amount, accounting date, accounting period, and is associated with the applicable general ledger account." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpLedger a rdfs:Class ;
    rdfs:comment "In accounting transactions, a ledger is a book containing accounts to which debits and credits are posted from journals, where transactions are initially recorded. Journal entries are periodically posted to the ledger. Ledger Actual represents actual amounts by account within ledger within company or business area. Actual amounts may be generated in a source application and then loaded to a specific ledger within the enterprise general ledger or budget application." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpLedgerBudget a rdfs:Class ;
    rdfs:comment "Information for utility Ledger Budgets. They support the transfer budget amounts between all possible source applications throughout an enterprise and a general ledger or budget application." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpLedgerEntry a rdfs:Class ;
    rdfs:comment "Details of an individual entry in a ledger, which was posted from a journal on the posted date." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpPOLineItem a rdfs:Class ;
    rdfs:comment "Of an ErpPurchaseOrder, this is an individually ordered item or product along with the quantity, price and other descriptive information." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpPayable a rdfs:Class ;
    rdfs:comment "A transaction that represents an invoice from a supplier. A payable (or voucher) is an open item, approved and ready for payment, in the Accounts Payable ledger." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpPayableLineItem a rdfs:Class ;
    rdfs:comment "Of an ErpPayable, a line item references an ErpInvoiceLineitem or other source such as credit memos." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpPayment a rdfs:Class ;
    rdfs:comment "Payment infromation and status for any individual line item of an ErpInvoice (e.g., when payment is from a customer). ErpPayable is also updated when payment is to a supplier and ErpReceivable is updated when payment is from a customer. Multiple payments can be made against a single line item and an individual payment can apply to more that one line item." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpPersonnel a rdfs:Class ;
    rdfs:comment "Information that applies to the basic data about a utility person, used by ERP applications to transfer Personnel data for a worker." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpProjectAccounting a rdfs:Class ;
    rdfs:comment "Utility Project Accounting information, used by ERP applications to enable all relevant sub-systems that submit single sided transactions to transfer information with a Project Accounting Application. This would include, but not necessarily be limited to: Accounts Payable, Accounts Receivable, Budget, Order Management, Purchasing, Time and Labor, Travel and Expense." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpPurchaseOrder a rdfs:Class ;
    rdfs:comment "A document that communicates an order to purchase goods from a buyer to a supplier. The PurchaseOrder carries information to and from the buyer and supplier. It is a legally binding document once both Parties agree to the contents and the specified terms and conditions of the order." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpQuote a rdfs:Class ;
    rdfs:comment "Document describing the prices of goods or services provided by a supplier. It includes the terms of the purchase, delivery proposals, identification of goods or services ordered, as well as their quantities." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpQuoteLineItem a rdfs:Class ;
    rdfs:comment "Of an ErpQuote, the item or product quoted along with quantity, price and other descriptive information." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpRecDelvLineItem a rdfs:Class ;
    rdfs:comment "Of an ErpReceiveDelivery, this is an individually received good or service by the Organisation receiving goods or services. It may be used to indicate receipt of goods in conjunction with a purchase order line item." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpRecLineItem a rdfs:Class ;
    rdfs:comment "Individual entry of an ErpReceivable, it is a particular transaction representing an invoice, credit memo or debit memo to a customer." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpReceivable a rdfs:Class ;
    rdfs:comment "Transaction representing an invoice, credit memo or debit memo to a customer. It is an open (unpaid) item in the Accounts Receivable ledger." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpReceiveDelivery a rdfs:Class ;
    rdfs:comment "Transaction for an Organisation receiving goods or services that may be used to indicate receipt of goods in conjunction with a purchase order. A receivable is an open (unpaid) item in the Accounts Receivable ledger." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpReqLineItem a rdfs:Class ;
    rdfs:comment """Information that describes a requested item and its attributes.\r
""" ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpRequisition a rdfs:Class ;
    rdfs:comment "General information that applies to a utility requisition that is a request for the purchase of goods or services. Typically, a requisition leads to the creation of a purchase order to a specific supplier." ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpSalesOrder a rdfs:Class ;
    rdfs:comment """General purpose Sales Order is used for utility service orders, etc.\r
As used by the OAG, the SalesOrder is a step beyond a PurchaseOrder in that the receiving entity of the order also communicates SalesInformoration about the Order along with the Order itself.""" ;
    rdfs:subClassOf cim:ErpDocument .

cim:ErpSiteLevelData a rdfs:Class ;
    rdfs:comment "For a utility, general information that describes physical locations of organizations or the location codes and their meanings. This enables ERP applications to ensure that the physical location identifiers are synchronized between the business applications." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpTimeEntry a rdfs:Class ;
    rdfs:comment "An individual entry on an ErpTimeSheet." ;
    rdfs:subClassOf cim:ErpIdentifiedObject .

cim:ErpTimeSheet a rdfs:Class ;
    rdfs:comment "Time sheet for employees and contractors. Note that ErpTimeSheet inherits the relationship to ErpPerson from Document." ;
    rdfs:subClassOf cim:ErpDocument .

cim:EstimatedRestorationTime a rdfs:Class ;
    rdfs:comment "The Estimated Restoration Time (ERT) for a single outage" .

cim:ExPostLoss a rdfs:Class ;
    rdfs:comment """Model of ex-post calcultion of MW losses.  \r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ExPostLossResults a rdfs:Class ;
    rdfs:comment """Model results of ex-post calculation of MW losses. Summarizes loss in two categories losses on the the extra high voltage transmission and total losses. Calculated for each subcontrol area.\r
""" .

cim:ExPostMarketRegion a rdfs:Class ;
    rdfs:comment """Model of ex-post calculation of cleared MW on a regional basis.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ExPostMarketRegionResults a rdfs:Class ;
    rdfs:comment """Model of expost calculation of cleared MW on a region basis.  Includes cleared price.\r
""" .

cim:ExPostPricing a rdfs:Class ;
    rdfs:comment """Model of ex-post pricing of nodes.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ExPostPricingResults a rdfs:Class ;
    rdfs:comment """Model of ex-post pricing of nodes.  Includes LMP information, pnode based.\r
""" .

cim:ExPostResource a rdfs:Class ;
    rdfs:comment """Model of ex-post pricing of resources.  \r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:ExPostResourceResults a rdfs:Class ;
    rdfs:comment """Model of ex-post pricing of resources contains components of LMPs: energy, congestion, loss. Resource based.\r
""" .

cim:ExcAC1A a rdfs:Class ;
    rdfs:comment "Modified IEEE AC1A alternator-supplied rectifier excitation system with different rate feedback source." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAC2A a rdfs:Class ;
    rdfs:comment "Modified IEEE AC2A alternator-supplied rectifier excitation system with different field current limit." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAC3A a rdfs:Class ;
    rdfs:comment "Modified IEEE AC3A alternator-supplied rectifier excitation system with different field current limit." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAC4A a rdfs:Class ;
    rdfs:comment "Modified IEEE AC4A alternator-supplied rectifier excitation system with different minimum controller output." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAC5A a rdfs:Class ;
    rdfs:comment "Modified IEEE AC5A alternator-supplied rectifier excitation system with different minimum controller output." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAC6A a rdfs:Class ;
    rdfs:comment "Modified IEEE AC6A alternator-supplied rectifier excitation system with speed input." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAC8B a rdfs:Class ;
    rdfs:comment "Modified IEEE AC8B alternator-supplied rectifier excitation system with speed input and input limiter." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcANS a rdfs:Class ;
    rdfs:comment "Italian excitation system. It represents static field voltage or excitation current feedback excitation system." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAVR1 a rdfs:Class ;
    rdfs:comment "Italian excitation system corresponding to IEEE (1968) type 1 model. It represents an exciter dynamo and electromechanical regulator." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAVR2 a rdfs:Class ;
    rdfs:comment "Italian excitation system corresponding to IEEE (1968) type 2 model. It represents an alternator and rotating diodes and electromechanic voltage regulators." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAVR3 a rdfs:Class ;
    rdfs:comment "Italian excitation system. It represents an exciter dynamo and electric regulator. " ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAVR4 a rdfs:Class ;
    rdfs:comment "Italian excitation system. It represents a static exciter and electric voltage regulator." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAVR5 a rdfs:Class ;
    rdfs:comment "Manual excitation control with field circuit resistance. This model can be used as a very simple representation of manual voltage control." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcAVR7 a rdfs:Class ;
    rdfs:comment "IVO excitation system." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcBBC a rdfs:Class ;
    rdfs:comment "Transformer fed static excitation system (static with ABB regulator). This model represents a static excitation system in which a gated thyristor bridge fed by a transformer at the main generator terminals feeds the main generator directly." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcCZ a rdfs:Class ;
    rdfs:comment "Czech proportion/integral exciter." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcDC1A a rdfs:Class ;
    rdfs:comment "Modified IEEE DC1A direct current commutator exciter with speed input and without underexcitation limiters (UEL) inputs." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcDC2A a rdfs:Class ;
    rdfs:comment "Modified IEEE DC2A direct current commutator exciter with speed input, one more leg block in feedback loop and without underexcitation limiters (UEL) inputs.  DC type 2 excitation system model with added speed multiplier, added lead-lag, and voltage-dependent limits." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcDC3A a rdfs:Class ;
    rdfs:comment "Modified IEEE DC3A direct current commutator exciter with speed input, and deadband.  DC old type 4." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcDC3A1 a rdfs:Class ;
    rdfs:comment "Modified old IEEE type 3 excitation system." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcELIN1 a rdfs:Class ;
    rdfs:comment "Static PI transformer fed excitation system ELIN (VATECH) - simplified model.  This model represents an all-static excitation system. A PI voltage controller establishes a desired field current set point for a proportional current controller. The integrator of the PI controller has a follow-up input to match its signal to the present field current.  A power system stabilizer with power input is included in the model." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcELIN2 a rdfs:Class ;
    rdfs:comment "Detailed excitation system ELIN (VATECH).  This model represents an all-static excitation system. A PI voltage controller establishes a desired field current set point for a proportional current controller. The integrator of the PI controller has a follow-up input to match its signal to the present field current.  Power system stabilizer models used in conjunction with this excitation system model: PssELIN2, PssIEEE2B, Pss2B." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcHU a rdfs:Class ;
    rdfs:comment "Hungarian excitation system, with built-in voltage transducer." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC1A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC1A model. The model represents the field-controlled alternator-rectifier excitation systems designated type AC1A. These excitation systems consist of an alternator main exciter with non-controlled rectifiers.\r
Reference: IEEE 421.5-2005, 6.1.""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC2A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC2A model. The model represents a high initial response field-controlled alternator-rectifier excitation system. The alternator main exciter is used with non-controlled rectifiers. The type AC2A model is similar to that of type AC1A except for the inclusion of exciter time constant compensation and exciter field current limiting elements.\r
Reference: IEEE 421.5-2005, 6.2.""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC3A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC3A model. The model represents the field-controlled alternator-rectifier excitation systems designated type AC3A. These excitation systems include an alternator main exciter with non-controlled rectifiers. The exciter employs self-excitation, and the voltage regulator power is derived from the exciter output voltage.  Therefore, this system has an additional nonlinearity, simulated by the use of a multiplier whose inputs are the voltage regulator command signal, <i>Va</i>, and the exciter output voltage, <i>Efd</i>, times <i>K</i><i><sub>R</sub></i>.  This model is applicable to excitation systems employing static voltage regulators.\r
Reference: IEEE 421.5-2005, 6.3.""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC4A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC4A model. The model represents type AC4A alternator-supplied controlled-rectifier excitation system which is quite different from the other types of AC systems. This high initial response excitation system utilizes a full thyristor bridge in the exciter output circuit.  The voltage regulator controls the firing of the thyristor bridges. The exciter alternator uses an independent voltage regulator to control its output voltage to a constant value. These effects are not modelled; however, transient loading effects on the exciter alternator are included.\r
Reference: IEEE 421.5-2005, 6.4.""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC5A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC5A model. The model represents a simplified model for brushless excitation systems. The regulator is supplied from a source, such as a permanent magnet generator, which is not affected by system disturbances.  Unlike other AC models, this model uses loaded rather than open circuit exciter saturation data in the same way as it is used for the DC models.  Because the model has been widely implemented by the industry, it is sometimes used to represent other types of systems when either detailed data for them are not available or simplified models are required.\r
Reference: IEEE 421.5-2005, 6.5.""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC6A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC6A model. The model represents field-controlled alternator-rectifier excitation systems with system-supplied electronic voltage regulators.  The maximum output of the regulator, <i>V</i><i><sub>R</sub></i>, is a function of terminal voltage, <i>V</i><i><sub>T</sub></i>. The field current limiter included in the original model AC6A remains in the 2005 update.\r
Reference: IEEE 421.5-2005, 6.6. \r
\r
""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC7B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC7B model. The model represents excitation systems which consist of an AC alternator with either stationary or rotating rectifiers to produce the DC field requirements. It is an upgrade to earlier AC excitation systems, which replace only the controls but retain the AC alternator and diode rectifier bridge.\r
Reference: IEEE 421.5-2005, 6.7. Note, however, that in IEEE 421.5-2005, the [1 / <i>sT</i><i><sub>E</sub></i>] block is shown as [1 / (1 + <i>sT</i><i><sub>E</sub></i>)], which is incorrect.""" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEAC8B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type AC8B model. This model represents a PID voltage regulator with either a brushless exciter or DC exciter. The AVR in this model consists of PID control, with separate constants for the proportional (<i>K</i><i><sub>PR</sub></i>), integral (<i>K</i><i><sub>IR</sub></i>), and derivative (<i>K</i><i><sub>DR</sub></i>) gains. The representation of the brushless exciter (<i>T</i><i><sub>E</sub></i>, <i>K</i><i><sub>E</sub></i>, <i>S</i><i><sub>E</sub></i>, <i>K</i><i><sub>C</sub></i>, <i>K</i><i><sub>D</sub></i>) is similar to the model type AC2A. The type AC8B model can be used to represent static voltage regulators applied to brushless excitation systems. Digitally based voltage regulators feeding DC rotating main exciters can be represented with the AC type AC8B model with the parameters <i>K</i><i><sub>C</sub></i> and <i>K</i><i><sub>D</sub></i> set to 0.  For thyristor power stages fed from the generator terminals, the limits <i>V</i><i><sub>RMAX</sub></i> and <i>V</i><i><sub>RMIN</sub></i><i> </i>should be a function of terminal voltage: V<i><sub>T</sub></i> x <i>V</i><i><sub>RMAX</sub></i><sub> </sub>and <i>V</i><i><sub>T</sub></i> x <i>V</i><i><sub>RMIN</sub></i>.\r
Reference: IEEE 421.5-2005, 6.8. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEDC1A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type DC1A model. This model represents field-controlled DC commutator exciters with continuously acting voltage regulators (especially the direct-acting rheostatic, rotating amplifier, and magnetic amplifier types).  Because this model has been widely implemented by the industry, it is sometimes used to represent other types of systems when detailed data for them are not available or when a simplified model is required.\r
Reference: IEEE 421.5-2005, 5.1. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEDC2A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type DC2A model. This model represents field-controlled DC commutator exciters with continuously acting voltage regulators having supplies obtained from the generator or auxiliary bus.  It differs from the type DC1A model only in the voltage regulator output limits, which are now proportional to terminal voltage <i>V</i><i><sub>T</sub></i>.\r
It is representative of solid-state replacements for various forms of older mechanical and rotating amplifier regulating equipment connected to DC commutator exciters.\r
Reference: IEEE 421.5-2005, 5.2. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEDC3A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type DC3A model. This model represents older systems, in particular those DC commutator exciters with non-continuously acting regulators that were commonly used before the development of the continuously acting varieties.  These systems respond at basically two different rates, depending upon the magnitude of voltage error. For small errors, adjustment is made periodically with a signal to a motor-operated rheostat. Larger errors cause resistors to be quickly shorted or inserted and a strong forcing signal applied to the exciter. Continuous motion of the motor-operated rheostat occurs for these larger error signals, even though it is bypassed by contactor action.\r
Reference: IEEE 421.5-2005, 5.3. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEDC4B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type DC4B model. These excitation systems utilize a field-controlled DC commutator exciter with a continuously acting voltage regulator having supplies obtained from the generator or auxiliary bus.\r
Reference: IEEE 421.5-2005, 5.4. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST1A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST1A model. This model represents systems in which excitation power is supplied through a transformer from the generator terminals (or the unit’s auxiliary bus) and is regulated by a controlled rectifier.  The maximum exciter voltage available from such systems is directly related to the generator terminal voltage.\r
Reference: IEEE 421.5-2005, 7.1. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST2A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST2A model. Some static systems use both current and voltage sources (generator terminal quantities) to comprise the power source.  The regulator controls the exciter output through controlled saturation of the power transformer components.  These compound-source rectifier excitation systems are designated type ST2A and are represented by ExcIEEEST2A.\r
Reference: IEEE 421.5-2005, 7.2. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST3A a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST3A model.  Some static systems utilize a field voltage control loop to linearize the exciter control characteristic. This also makes the output independent of supply source variations until supply limitations are reached.  These systems utilize a variety of controlled-rectifier designs: full thyristor complements or hybrid bridges in either series or shunt configurations. The power source can consist of only a potential source, either fed from the machine terminals or from internal windings. Some designs can have compound power sources utilizing both machine potential and current. These power sources are represented as phasor combinations of machine terminal current and voltage and are accommodated by suitable parameters in model type ST3A which is represented by ExcIEEEST3A.\r
Reference: IEEE 421.5-2005, 7.3. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST4B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST4B model. This model is a variation of the type ST3A model, with a proportional plus integral (PI) regulator block replacing the lag-lead regulator characteristic that is in the ST3A model. Both potential and compound source rectifier excitation systems are modelled.  The PI regulator blocks have non-windup limits that are represented. The voltage regulator of this model is typically implemented digitally.\r
Reference: IEEE 421.5-2005, 7.4. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST5B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST5B model. The type ST5B excitation system is a variation of the type ST1A model, with alternative overexcitation and underexcitation inputs and additional limits.\r
The block diagram in the IEEE 421.5 standard has input signal <i>Vc </i>and does not indicate the summation point with <i>Vref</i>. The implementation of the ExcIEEEST5B shall consider summation point with <i>Vref</i>.\r
Reference: IEEE 421.5-2005, 7.5. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST6B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST6B model. This model consists of a PI voltage regulator with an inner loop field voltage regulator and pre-control. The field voltage regulator implements a proportional control. The pre-control and the delay in the feedback circuit increase the dynamic response.\r
Reference: IEEE 421.5-2005, 7.6. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcIEEEST7B a rdfs:Class ;
    rdfs:comment """IEEE 421.5-2005 type ST7B model. This model is representative of static potential-source excitation systems. In this system, the AVR consists of a PI voltage regulator. A phase lead-lag filter in series allows the introduction of a derivative function, typically used with brushless excitation systems. In that case, the regulator is of the PID type. In addition, the terminal voltage channel includes a phase lead-lag filter.  The AVR includes the appropriate inputs on its reference for overexcitation limiter (OEL1), underexcitation limiter (UEL), stator current limiter (SCL), and current compensator (DROOP). All these limitations, when they work at voltage reference level, keep the PSS (VS signal from PSS) in operation. However, the UEL limitation can also be transferred to the high value (HV) gate acting on the output signal. In addition, the output signal passes through a low value (LV) gate for a ceiling overexcitation limiter (OEL2).\r
Reference: IEEE 421.5-2005, 7.7. """ ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcNI a rdfs:Class ;
    rdfs:comment "Bus or solid fed SCR (silicon-controlled rectifier) bridge excitation system model type NI (NVE)." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcOEX3T a rdfs:Class ;
    rdfs:comment "Modified IEEE type ST1 excitation system with semi-continuous and acting terminal voltage limiter." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcPIC a rdfs:Class ;
    rdfs:comment "Proportional/integral regulator excitation system.  This model can be used to represent excitation systems with a proportional-integral (PI) voltage regulator controller. " ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcREXS a rdfs:Class ;
    rdfs:comment "General purpose rotating excitation system.  This model can be used to represent a wide range of excitation systems whose DC power source is an AC or DC generator. It encompasses IEEE type AC1, AC2, DC1, and DC2 excitation system models. " ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcRQB a rdfs:Class ;
    rdfs:comment "Excitation system type RQB (four-loop regulator, r?gulateur quatre boucles, developed in France) primarily used in nuclear or thermal generating units. This excitation system shall be always used together with power system stabilizer type PssRQB.   " ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcSCRX a rdfs:Class ;
    rdfs:comment "Simple excitation system with generic characteristics typical of many excitation systems; intended for use where negative field current could be a problem." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcSEXS a rdfs:Class ;
    rdfs:comment "Simplified excitation system." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcSK a rdfs:Class ;
    rdfs:comment "Slovakian excitation system.  UEL and secondary voltage control are included in this model. When this model is used, there cannot be a separate underexcitation limiter or VAr controller model." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcST1A a rdfs:Class ;
    rdfs:comment "Modification of an old IEEE ST1A static excitation system without overexcitation limiter (OEL) and underexcitation limiter (UEL)." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcST2A a rdfs:Class ;
    rdfs:comment "Modified IEEE ST2A static excitation system with another lead-lag block added to match the model defined by WECC." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcST3A a rdfs:Class ;
    rdfs:comment "Modified IEEE ST3A static excitation system with added speed multiplier." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcST4B a rdfs:Class ;
    rdfs:comment "Modified IEEE ST4B static excitation system with maximum inner loop feedback gain <i>Vgmax</i>." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcST6B a rdfs:Class ;
    rdfs:comment "Modified IEEE ST6B static excitation system with PID controller and optional inner feedback loop." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcST7B a rdfs:Class ;
    rdfs:comment "Modified IEEE ST7B static excitation system without stator current limiter (SCL) and current compensator (DROOP) inputs." ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExcitationSystemUserDefined a rdfs:Class ;
    rdfs:comment "Excitation system function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" ;
    rdfs:subClassOf cim:ExcitationSystemDynamics .

cim:ExpectedEnergy a rdfs:Class ;
    rdfs:comment """Model Expected Energy from Market Clearing, interval based.\r
""" .

cim:ExpectedEnergyValues a rdfs:Class ;
    rdfs:comment """Model Expected Energy from Market Clearing.\r
""" .

cim:ExtensionItem a rdfs:Class ;
    rdfs:comment "Specifies the extensions list items" .

cim:ExtensionsList a rdfs:Class ;
    rdfs:comment "Specifies the enumeration of the extension item" .

cim:ExternalCustomerAgreement a rdfs:Class ;
    rdfs:comment "A type of customer agreement involving an external agency. For example, a customer may form a contracts with an Energy Service Supplier if Direct Access is permitted." ;
    rdfs:subClassOf cim:Agreement .

cim:ExternalNetworkInjection a rdfs:Class ;
    rdfs:comment "This class represents the external network and it is used for IEC 60909 calculations." ;
    rdfs:subClassOf cim:RegulatingCondEq .

cim:FACTSDevice a rdfs:Class ;
    rdfs:comment """FACTS device asset.\r
""" ;
    rdfs:subClassOf cim:Asset .

cim:FTR a rdfs:Class ;
    rdfs:comment """Financial Transmission Rights (FTR) regarding transmission capacity at a flowgate. \r
""" ;
    rdfs:subClassOf cim:Agreement .

cim:Facility a rdfs:Class ;
    rdfs:comment "A facility may contain buildings, storage facilities, switching facilities, power generation, manufacturing facilities, maintenance facilities, etc." ;
    rdfs:subClassOf cim:AssetContainer .

cim:FailureEvent a rdfs:Class ;
    rdfs:comment "An event where an asset has failed to perform its functions within specified parameters. This class is intended to reflect the failure itself. Additional information resulting from forensic analysis could be captured by a diagnosis data set. " ;
    rdfs:subClassOf cim:ActivityRecord .

cim:FaultCauseType a rdfs:Class ;
    rdfs:comment "Type of cause of the fault." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:FaultImpedance a rdfs:Class ;
    rdfs:comment "Impedance description for the fault." .

cim:FaultIndicator a rdfs:Class ;
    rdfs:comment "A FaultIndicator is typically only an indicator (which may or may not be remotely monitored), and not a piece of equipment that actually initiates a protection event. It is used for FLISR (Fault Location, Isolation and Restoration) purposes, assisting with the dispatch of crews to \"most likely\" part of the network (i.e. assists with determining circuit section where the fault most likely happened)." ;
    rdfs:subClassOf cim:AuxiliaryEquipment .

cim:FaultIndicatorInfo a rdfs:Class ;
    rdfs:comment "Parameters of fault indicator asset." ;
    rdfs:subClassOf cim:AssetInfo .

cim:Feeder a rdfs:Class ;
    rdfs:comment """A collection of equipment for organizational purposes, used for grouping distribution resources.\r
The organization a feeder does not necessarily reflect connectivity or current operation state.\r
\r
""" ;
    rdfs:subClassOf cim:EquipmentContainer .

cim:FieldDispatchHistory a rdfs:Class ;
    rdfs:comment "The history of field dispatch statuses for this work." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:FieldDispatchStep a rdfs:Class ;
    rdfs:comment "Details of the step in the field dispatch history." .

cim:FieldSafetySupervisor a rdfs:Class ;
    rdfs:comment "Crew member on work site responsible for all local safety measures for the work crew doing maintenance, construction and repair in a substation or on a power line/cable." ;
    rdfs:subClassOf cim:CrewMember .

cim:FinancialInfo a rdfs:Class ;
    rdfs:comment """Various current financial properties associated with a particular asset. Historical properties may be determined by ActivityRecords associated with the asset.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Fire a rdfs:Class ;
    rdfs:comment "A fire, often uncontrolled, covering an area of land which typically contains combustible vegetation. Associated location information is assumed to describe the total area burned as of a specified time." ;
    rdfs:subClassOf cim:GeosphericPhenomenon .

cim:FiveMinAuxiliaryData a rdfs:Class ;
    rdfs:comment """Models 5-Minutes Auxiliary Data.\r
""" .

cim:FloatQuantity a rdfs:Class ;
    rdfs:comment "Quantity with float value and associated unit information." .

cim:Flood a rdfs:Class ;
    rdfs:comment "A flood, an overflowing of a large amount of water beyond its normal confines, esp. over what is normally dry land." ;
    rdfs:subClassOf cim:HydrosphericPhenomenon .

cim:FlowDirection a rdfs:Class ;
    rdfs:comment "The coded identification of the direction of energy flow." .

cim:Flowgate a rdfs:Class ;
    rdfs:comment """A flowgate, is single or group of transmission elements intended to model MW flow impact relating to transmission limitations and transmission service usage. \r
""" ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:FlowgatePartner a rdfs:Class ;
    rdfs:comment """Flowgate defined partner.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:FlowgateRelief a rdfs:Class ;
    rdfs:comment """IDC (Interchange Distribution Calulator) sends data for a TLR (Transmission Loading Relief).\r
""" .

cim:FlowgateValue a rdfs:Class ;
    rdfs:comment """Day Ahead,  Network Native Load, Economic Dispatch, values used for calculation of Network Native Load (NNL) Determinator process.\r
""" .

cim:ForbiddenRegion a rdfs:Class ;
    rdfs:comment """Forbbiden region is operating ranges where the units are unable to maintain steady operation without causing equipment damage.  The four attributes that define a forbidden region are the low MW, the High MW, the crossing time, and the crossing cost.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Forecast a rdfs:Class ;
    rdfs:comment "A forecast group of value sets and/or phenomena characteristics." ;
    rdfs:subClassOf cim:EnvironmentalInformation .

cim:FormerReference a rdfs:Class ;
    rdfs:comment "Used to indicate former references to the same piece of equipment. The ID, name, and effectivity dates are utilized." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:FossilFuel a rdfs:Class ;
    rdfs:comment "The fossil fuel consumed by the non-nuclear thermal generating unit.   For example, coal, oil, gas, etc.   These are the specific fuels that the generating unit can consume." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Frequency a rdfs:Class ;
    rdfs:comment "Cycles per second." .

cim:FrequencyConverter a rdfs:Class ;
    rdfs:comment "A device to convert from one frequency to another (e.g., frequency F1 to F2) comprises a pair of FrequencyConverter instances. One converts from F1 to DC, the other converts the DC to F2." ;
    rdfs:subClassOf cim:RegulatingCondEq .

cim:FuelAllocationSchedule a rdfs:Class ;
    rdfs:comment """The amount of fuel of a given type which is allocated for consumption over a specified period of time.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:FuelCostCurve a rdfs:Class ;
    rdfs:comment """Relationship between unit fuel cost in $/kWh(Y-axis) and  unit output in MW (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:FuelRegion a rdfs:Class ;
    rdfs:comment "Indication of region for fuel inventory purposes." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Fuse a rdfs:Class ;
    rdfs:comment "An overcurrent protective device with a circuit opening fusible part that is heated and severed by the passage of overcurrent through it. A fuse is considered a switching device because it breaks current." ;
    rdfs:subClassOf cim:Switch .

cim:GasPrice a rdfs:Class ;
    rdfs:comment "Price of gas in monetary units." .

cim:Gate a rdfs:Class ;
    rdfs:comment "Logical gate than support logical operation based on the input." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:GenDistributionFactor a rdfs:Class ;
    rdfs:comment """This class models the generation distribution factors. This class needs to be used along with the AggregatedPnode and the IndividualPnode to show the distribution of each individual party.\r
""" .

cim:GenICompensationForGenJ a rdfs:Class ;
    rdfs:comment "Resistive and reactive components of compensation for generator associated with IEEE type 2 voltage compensator for current flow out of another generator in the interconnection." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:GenUnitOpCostCurve a rdfs:Class ;
    rdfs:comment "Relationship between unit operating cost (Y-axis) and unit output active power (X-axis). The operating cost curve for thermal units is derived from heat input and fuel costs. The operating cost curve for hydro units is derived from water flow rates and equivalent water costs." ;
    rdfs:subClassOf cim:Curve .

cim:GenUnitOpSchedule a rdfs:Class ;
    rdfs:comment """The generating unit's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses. The X-axis represents absolute time. The Y1-axis represents the status (0=off-line and unavailable: 1=available: 2=must run: 3=must run at fixed power value: etc.). The Y2-axis represents the must run fixed power value where required.\r
""" ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:GeneralClearing a rdfs:Class ;
    rdfs:comment """Model of clearing result of the market run at the market level.  Identifies interval.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:GeneralClearingResults a rdfs:Class ;
    rdfs:comment """Provides the adjusted load forecast value on a load forecast zone basis.  \r
""" .

cim:GeneratingBid a rdfs:Class ;
    rdfs:comment "Offer to supply energy/ancillary services from a generating unit or resource." ;
    rdfs:subClassOf cim:ResourceBid .

cim:GeneratingUnitDynamicValues a rdfs:Class ;
    rdfs:comment """Optimal Power Flow or State Estimator Unit Data for Operator Training Simulator. This is used for RealTime, Study and Maintenance Users.\r
""" .

cim:GenerationProvider a rdfs:Class ;
    rdfs:comment """The energy seller in the energy marketplace.\r
""" ;
    rdfs:subClassOf cim:Organisation .

cim:GeneratorTypeAsset a rdfs:Class ;
    rdfs:comment """Generic generation equipment that may be used for various purposes such as work planning. It defines both the Real and Reactive power properties (modelled at the PSR level as a GeneratingUnit + SynchronousMachine).\r
""" ;
    rdfs:subClassOf cim:CatalogAssetType .

cim:GenericAction a rdfs:Class ;
    rdfs:comment "An arbitrary switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:GenericConstraints a rdfs:Class ;
    rdfs:comment """Generic constraints can represent secure areas, voltage profile, transient stability and voltage collapse limits.\r
\r
The generic constraints can be one of the following forms:\r
a)	Thermal MW limit constraints type\r
b)	Group line flow constraint type\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:GenericDataSetVersion a rdfs:Class .

cim:GeographicalRegion a rdfs:Class ;
    rdfs:comment """A geographical region of a power system network model.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:GeosphericAnalog a rdfs:Class ;
    rdfs:comment "Analog (float) measuring a geospheric condition." ;
    rdfs:subClassOf cim:EnvironmentalAnalog .

cim:GovCT1 a rdfs:Class ;
    rdfs:comment """General model for any prime mover with a PID governor, used primarily for combustion turbine and combined cycle units.\r
This model can be used to represent a variety of prime movers controlled by PID governors.  It is suitable, for example, for the representation of: \r
<ul>\r
	<li>gas turbine and single shaft combined cycle turbines</li>\r
</ul>\r
<ul>\r
	<li>diesel engines with modern electronic or digital governors  </li>\r
</ul>\r
<ul>\r
	<li>steam turbines where steam is supplied from a large boiler drum or a large header whose pressure is substantially constant over the period under study</li>\r
	<li>simple hydro turbines in dam configurations where the water column length is short and water inertia effects are minimal.</li>\r
</ul>\r
Additional information on this model is available in the 2012 IEEE report, <i><u>Dynamic Models for Turbine-Governors in Power System Studies</u></i>, 3.1.2.3 pages 3-4 (GGOV1).""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovCT2 a rdfs:Class ;
    rdfs:comment "General governor with frequency-dependent fuel flow limit.  This model is a modification of the GovCT1<b> </b>model in order to represent the frequency-dependent fuel flow limit of a specific gas turbine manufacturer." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovGAST a rdfs:Class ;
    rdfs:comment "Single shaft gas turbine." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovGAST1 a rdfs:Class ;
    rdfs:comment "Modified single shaft gas turbine." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovGAST2 a rdfs:Class ;
    rdfs:comment "Gas turbine." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovGAST3 a rdfs:Class ;
    rdfs:comment "Generic turbogas with acceleration and temperature controller." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovGAST4 a rdfs:Class ;
    rdfs:comment "Generic turbogas." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovGASTWD a rdfs:Class ;
    rdfs:comment """Woodward™ gas turbine governor. \r
[Footnote: Woodward gas turbines are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.] \r
\r
""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydro1 a rdfs:Class ;
    rdfs:comment "Basic hydro turbine governor." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydro2 a rdfs:Class ;
    rdfs:comment "IEEE hydro turbine governor with straightforward penstock configuration and hydraulic-dashpot governor." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydro3 a rdfs:Class ;
    rdfs:comment "Modified IEEE hydro governor-turbine. This model differs from that defined in the IEEE modelling guideline paper in that the limits on gate position and velocity do not permit \"wind up\" of the upstream signals." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydro4 a rdfs:Class ;
    rdfs:comment "Hydro turbine and governor. Represents plants with straight-forward penstock configurations and hydraulic governors of the traditional 'dashpot' type.  This model can be used to represent simple, Francis/Pelton or Kaplan turbines." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroDD a rdfs:Class ;
    rdfs:comment "Double derivative hydro governor and turbine." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroFrancis a rdfs:Class ;
    rdfs:comment """Detailed hydro unit - Francis model.  This model can be used to represent three types of governors.\r
A schematic of the hydraulic system of detailed hydro unit models, such as Francis and Pelton, is provided in the DetailedHydroModelHydraulicSystem diagram.""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroIEEE0 a rdfs:Class ;
    rdfs:comment """IEEE simplified hydro governor-turbine model.  Used for mechanical-hydraulic and electro-hydraulic turbine governors, with or without steam feedback. Typical values given are for mechanical-hydraulic turbine-governor.\r
Ref<font color="#0f0f0f">erence: IEEE Transactions on Power Apparatus and Systems, November/December 1973, Volume PAS-92, Number 6, <i><u>Dynamic Models for Steam and Hydro Turbines in Power System Studies</u></i>, page 1904.</font>""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroIEEE2 a rdfs:Class ;
    rdfs:comment """IEEE hydro turbine governor model represents plants with straightforward penstock configurations and hydraulic-dashpot governors.\r
Ref<font color="#0f0f0f">erence: IEEE Transactions on Power Apparatus and Systems, November/December 1973, Volume PAS-92, Number 6, <i><u>Dynamic Models for Steam and Hydro Turbines in Power System Studies</u></i>, page 1904.</font>""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroPID a rdfs:Class ;
    rdfs:comment "PID governor and turbine." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroPID2 a rdfs:Class ;
    rdfs:comment """Hydro turbine and governor. Represents plants with straightforward penstock configurations and "three term" electro-hydraulic governors (i.e. Woodward<sup>TM</sup> electronic).\r
[Footnote: Woodward electronic governors are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.] \r
""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroPelton a rdfs:Class ;
    rdfs:comment """Detailed hydro unit - Pelton model.  This model can be used to represent the dynamic related to water tunnel and surge chamber.\r
The DetailedHydroModelHydraulicSystem diagram, located under the GovHydroFrancis class, provides a schematic of the hydraulic system of detailed hydro unit models, such as Francis and Pelton.""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroR a rdfs:Class ;
    rdfs:comment "Fourth order lead-lag governor and hydro turbine. " ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroWEH a rdfs:Class ;
    rdfs:comment """Woodward<sup>TM </sup>electric hydro governor. \r
[Footnote: Woodward electric hydro governors are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.]""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovHydroWPID a rdfs:Class ;
    rdfs:comment """Woodward<sup>TM</sup> PID hydro governor.\r
[Footnote: Woodward PID hydro governors are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.]""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteam0 a rdfs:Class ;
    rdfs:comment "A simplified steam turbine governor." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteam1 a rdfs:Class ;
    rdfs:comment "Steam turbine governor, based on the GovSteamIEEE1 (with optional deadband and nonlinear valve gain added). " ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteam2 a rdfs:Class ;
    rdfs:comment "Simplified governor." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamBB a rdfs:Class ;
    rdfs:comment "European governor model." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamCC a rdfs:Class ;
    rdfs:comment "Cross compound turbine governor.  Unlike tandem compound units, cross compound units are not on the same shaft." ;
    rdfs:subClassOf cim:CrossCompoundTurbineGovernorDynamics .

cim:GovSteamEU a rdfs:Class ;
    rdfs:comment "Simplified boiler and steam turbine with PID governor." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamFV2 a rdfs:Class ;
    rdfs:comment "Steam turbine governor with reheat time constants and modelling of the effects of fast valve closing to reduce mechanical power." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamFV3 a rdfs:Class ;
    rdfs:comment "Simplified GovSteamIEEE1 steam turbine governor with Prmax limit and fast valving." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamFV4 a rdfs:Class ;
    rdfs:comment "Detailed electro-hydraulic governor for steam unit." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamIEEE1 a rdfs:Class ;
    rdfs:comment """IEEE steam turbine governor model.\r
Ref<font color="#0f0f0f">erence: IEEE Transactions on Power Apparatus and Systems, November/December 1973, Volume PAS-92, Number 6, <i><u>Dynamic Models for Steam and Hydro Turbines in Power System Studies</u></i>, page 1904.</font>""" ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GovSteamSGO a rdfs:Class ;
    rdfs:comment "Simplified steam turbine governor." ;
    rdfs:subClassOf cim:TurbineGovernorDynamics .

cim:GrossToNetActivePowerCurve a rdfs:Class ;
    rdfs:comment "Relationship between the generating unit's gross active power output on the X-axis (measured at the terminals of the machine(s)) and the generating unit's net active power output on the Y-axis (based on utility-defined measurements at the power station). Station service loads, when modelled, should be treated as non-conforming bus loads. There may be more than one curve, depending on the auxiliary equipment that is in service." ;
    rdfs:subClassOf cim:Curve .

cim:Ground a rdfs:Class ;
    rdfs:comment "A point where the system is grounded used for connecting conducting equipment to ground. The power system model can have any number of grounds." ;
    rdfs:subClassOf cim:ConductingEquipment .

cim:GroundAction a rdfs:Class ;
    rdfs:comment "Action on ground as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:GroundDisconnector a rdfs:Class ;
    rdfs:comment "A manually operated or motor operated mechanical switching device used for isolating a circuit or equipment from ground." ;
    rdfs:subClassOf cim:Switch .

cim:GroundingImpedance a rdfs:Class ;
    rdfs:comment "A fixed impedance device used for grounding." ;
    rdfs:subClassOf cim:EarthFaultCompensator .

cim:HVDCLookUpTable a rdfs:Class .

cim:HealthScore a rdfs:Class ;
    rdfs:comment "Score that is indicative of the health of one or more assets." ;
    rdfs:subClassOf cim:AggregateScore .

cim:HeatInputCurve a rdfs:Class ;
    rdfs:comment """Relationship between unit heat input in energy per time for main fuel (Y1-axis) and supplemental fuel (Y2-axis) versus unit output in active power (X-axis). The quantity of main fuel used to sustain generation at this output level is prorated for throttling between definition points. The quantity of supplemental fuel used at this output level is fixed and not prorated.\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:HeatRate a rdfs:Class ;
    rdfs:comment "Heat generated, in energy per time unit of elapsed time." .

cim:HeatRecoveryBoiler a rdfs:Class ;
    rdfs:comment """The heat recovery system associated with combustion turbines in order to produce steam for combined cycle plants.\r
""" ;
    rdfs:subClassOf cim:FossilSteamSupply .

cim:HostControlArea a rdfs:Class ;
    rdfs:comment "A HostControlArea has a set of tie points and a set of generator controls (i.e., AGC). It also has a total load, including transmission and distribution losses." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:HourlyPreDispatchSchedule a rdfs:Class ;
    rdfs:comment """An indicator specifying that a resource shall have an Hourly Pre-Dispatch. The resource could be a RegisteredGenerator or a RegisteredInterTie.\r
\r
This schedule is assocated with the hourly parameters in a resource bid.""" ;
    rdfs:subClassOf cim:BidHourlySchedule .

cim:Hours a rdfs:Class ;
    rdfs:comment """Time specified in hours.\r
""" .

cim:Hurricane a rdfs:Class ;
    rdfs:comment "A hurricane, a subtype of cyclone occurring in the North Atlantic Ocean or North-eastern Pacific Ocean whose intensity is measured using the Saffir-Simpson Hurricane Scale." ;
    rdfs:subClassOf cim:Cyclone .

cim:HydroGeneratingEfficiencyCurve a rdfs:Class ;
    rdfs:comment """Relationship between unit efficiency as percentage and unit output active power for a given net head in meters. The relationship between efficiency, discharge, head, and power output is expressed as follows:   E =KP/HQ\r
where:  E is the efficiency, as a percentage; P is the active power; H is the height; Q is the discharge, volume/time unit; K is a constant.\r
For example, a curve instance for a given net head could show efficiency (Y-axis) versus active power output (X-axis) or versus discharge on the X-axis.""" ;
    rdfs:subClassOf cim:Curve .

cim:HydroGeneratingUnit a rdfs:Class ;
    rdfs:comment """A generating unit whose prime mover is a hydraulic turbine (e.g., Francis, Pelton, Kaplan).\r
""" ;
    rdfs:subClassOf cim:GeneratingUnit .

cim:HydroPowerPlant a rdfs:Class ;
    rdfs:comment "A hydro power station which can generate or pump. When generating, the generator turbines receive water from an upper reservoir. When pumping, the pumps receive their water from a lower reservoir." ;
    rdfs:subClassOf cim:PowerSystemResource .

cim:HydroPump a rdfs:Class ;
    rdfs:comment "A synchronous motor-driven pump, typically associated with a pumped storage plant." ;
    rdfs:subClassOf cim:Equipment .

cim:HydroPumpOpSchedule a rdfs:Class ;
    rdfs:comment "The hydro pump's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses. The unit's operating schedule status is typically given as: (0=unavailable) (1=available to startup or shutdown)  (2=must pump)." ;
    rdfs:subClassOf cim:RegularIntervalSchedule .

cim:HydroTurbine a rdfs:Class ;
    rdfs:comment """A water driven prime mover. Typical turbine types are: Francis, Kaplan, and Pelton.\r
""" ;
    rdfs:subClassOf cim:PrimeMover .

cim:HydrosphericAnalog a rdfs:Class ;
    rdfs:comment "Analog (float) measuring a hydrospheric condition." ;
    rdfs:subClassOf cim:EnvironmentalAnalog .

cim:ICCPInformationMessage a rdfs:Class ;
    rdfs:comment "This class represents the TASE.2 Information Message Object.  The IdentifiedObject.name attribute must be non-null.  The value of the attribute shall be used as the TASE.2 Information Reference, as specified by 60870-6-503." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:ICCPProvidedPoint a rdfs:Class ;
    rdfs:comment "The IdentifiedObject.name attribute must have a value.  The name attribute shall be used as the DataValue name used for the exchange." ;
    rdfs:subClassOf cim:ProvidedBilateralPoint .

cim:ICCPVCC a rdfs:Class ;
    rdfs:comment "Indicates that the ICCP information is global in nature and normally is available to all authorized peers." ;
    rdfs:subClassOf cim:BilateralExchangeActor .

cim:ICCPVirtualControlCentre a rdfs:Class ;
    rdfs:comment "This contains the information that a particular actor exposes for a particular agreed upon ICCP Bilateral Table." ;
    rdfs:subClassOf cim:BilateralExchangeActor .

cim:IEC61968CIMVersion a rdfs:Class ;
    rdfs:comment """IEC 61968 version number assigned to this UML model.\r
""" .

cim:IEC61970CIMVersion a rdfs:Class ;
    rdfs:comment """This is the IEC 61970 CIM version number assigned to this UML model.\r
""" .

cim:IEC62325CIMVersion a rdfs:Class ;
