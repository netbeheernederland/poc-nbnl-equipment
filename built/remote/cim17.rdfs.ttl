""" ;
    rdfs:subClassOf cim:WorkDocument .

cim:InspectionAnalog a rdfs:Class ;
    rdfs:comment """Asset inspection type of analog.\r
""" ;
    rdfs:subClassOf cim:AssetAnalog .

cim:InspectionDataSet a rdfs:Class ;
    rdfs:comment "Documents the result of one inspection, for a given attribute of an asset." ;
    rdfs:subClassOf cim:ProcedureDataSet .

cim:InspectionDiscrete a rdfs:Class ;
    rdfs:comment """Asset inspection type of discrete.\r
""" ;
    rdfs:subClassOf cim:AssetDiscrete .

cim:InstanceSet a rdfs:Class ;
    rdfs:comment "Instance of a version of a model part.   This corresponds to a payload of instance data.   " ;
