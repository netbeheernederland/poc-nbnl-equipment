""" .

cim:MPMTestThreshold a rdfs:Class ;
    rdfs:comment """Market Power Mitigation (MPM) test thresholds for resource as well as designated congestion areas (DCAs).\r
""" .

cim:MSSAggregation a rdfs:Class ;
    rdfs:comment "Metered Sub-System aggregation of MSS Zones." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:MSSZone a rdfs:Class ;
