cim:InternalControlArea a rdfs:Class ;
    rdfs:comment """There is one internal control area in the system, which is the single control area in the primary network company. Real time generation control affects only the internal control area.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:InternalLocation a rdfs:Class ;
    rdfs:comment "Description of location internal to a building." ;
    rdfs:subClassOf cim:WorkLocation .

cim:InterrupterUnit a rdfs:Class ;
    rdfs:comment """Breaker interrupter.\r
Some interrupters have one fixed and one moving contact, some have 2 fixed contacts, some 2 moving contacts. An interrupter will have relationships with 2 bushings and those relationships may be any combination of the FixedContact and MovingContact associations.""" ;
    rdfs:subClassOf cim:Asset .

cim:InterrupterUnitInfo a rdfs:Class ;
    rdfs:comment "Interrupter datasheet information." ;
    rdfs:subClassOf cim:AssetInfo .

cim:IntervalBlock a rdfs:Class ;
    rdfs:comment """Time sequence of readings of the same reading type. Contained interval readings may need conversion through the application of an offset and a scalar defined in associated pending.\r
Table 548 shows all association ends of IntervalBlock with other classes.\r
Table 548 – Association ends of Metering::IntervalBlock with other classes\r
Associations\r
name\r
mult to\r
type\r
description\r
\r
0..*\r
PendingCalculation\r
0..1\r
PendingCalculation\r
Pending calculation to apply to interval reading values contained by this block (after which the resulting reading type is different than the original because it reflects the conversion result).\r
\r
0..*\r
IntervalReadings\r
0..*\r
IntervalReading\r
Interval reading contained in this block.\r
\r
0..*\r
ReadingType\r
0..1\r
ReadingType\r
Type information for interval reading values contained in this block.\r
\r
0..*\r
MeterReading\r
0..1\r
MeterReading\r
Meter reading containing this interval block.\r
\r
\r
IntervalReading\r
Data captured at regular intervals of time. Interval data could be captured as incremental data, absolute data, or relative data. The source for the data is usually a tariff quantity or an engineering quantity. Data is typically captured in time-tagged, uniform, fixed-length intervals of 5 min, 10 min, 15 min, 30 min, or 60 min.\r
Note: Interval Data is sometimes also called "Interval Data Readings" (IDR).""" .

cim:IntervalReading a rdfs:Class ;
    rdfs:comment """Data captured at regular intervals of time. Interval data could be captured as incremental data, absolute data, or relative data. The source for the data is usually a tariff quantity or an engineering quantity. Data is typically captured in time-tagged, uniform, fixed-length intervals of 5 min, 10 min, 15 min, 30 min, or 60 min.\r
Note: Interval Data is sometimes also called "Interval Data Readings" (IDR).""" ;
    rdfs:subClassOf cim:BaseReading .

cim:IrregularIntervalSchedule a rdfs:Class ;
    rdfs:comment """The schedule has time points where the time between them varies.\r
""" ;
    rdfs:subClassOf cim:BasicIntervalSchedule .

cim:IrregularTimePoint a rdfs:Class ;
    rdfs:comment """TimePoints for a schedule where the time between the points varies.\r
""" .

cim:Issuer a rdfs:Class ;
    rdfs:comment " Person who issued the document and is responsible for its content." ;
    rdfs:subClassOf cim:DocumentPersonRole .

cim:Joint a rdfs:Class ;
    rdfs:comment """Joint connects two or more cables. It includes the portion of cable under wipes, welds, or other seals.\r
""" ;
    rdfs:subClassOf cim:Asset .

cim:Jumper a rdfs:Class ;
    rdfs:comment "A short section of conductor with negligible impedance which can be manually removed and replaced if the circuit is de-energized. Note that zero-impedance branches can potentially be modelled by other equipment types." ;
    rdfs:subClassOf cim:Switch .

cim:JumperAction a rdfs:Class ;
    rdfs:comment "Action on jumper as a switching step." ;
    rdfs:subClassOf cim:SwitchingAction .

cim:Junction a rdfs:Class ;
    rdfs:comment "A point where one or more conducting equipments are connected with zero resistance." ;
    rdfs:subClassOf cim:Connector .

cim:KiloActivePower a rdfs:Class ;
    rdfs:comment """Active power in kilowatts.\r
""" .

cim:LabTestDataSet a rdfs:Class ;
    rdfs:comment "Results of testing done by a lab." ;
    rdfs:subClassOf cim:ProcedureDataSet .

cim:LaborItem a rdfs:Class ;
    rdfs:comment "Labor used for work order." ;
    rdfs:subClassOf cim:WorkIdentifiedObject .

cim:LaborelecStandard a rdfs:Class ;
    rdfs:comment "Standard published by Laborelec." .

cim:LandProperty a rdfs:Class ;
    rdfs:comment "Information about a particular piece of (land) property such as its use. Ownership of the property may be determined through associations to Organisations and/or ErpPersons." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:Landslide a rdfs:Class ;
    rdfs:comment "A landslide, a large mass of rocks and earth that suddenly and quickly moves down the side of a mountain or hill." ;
    rdfs:subClassOf cim:GeosphericPhenomenon .

cim:Length a rdfs:Class ;
    rdfs:comment "Unit of length. It shall be a positive value or zero." .

cim:LevelVsVolumeCurve a rdfs:Class ;
    rdfs:comment "Relationship between reservoir volume and reservoir level. The  volume is at the Y-axis and the reservoir level at the X-axis." ;
    rdfs:subClassOf cim:Curve .

cim:LifecycleDate a rdfs:Class ;
    rdfs:comment """Dates for asset lifecycle state changes. May have multiple lifecycle dates for this device and a compound type allows a query to return multiple dates.\r
\r
""" .

cim:LightningStrike a rdfs:Class ;
    rdfs:comment "A cloud-to-ground lightning strike at a particular location." ;
    rdfs:subClassOf cim:GeosphericPhenomenon .

cim:LimitScalingLimit a rdfs:Class ;
    rdfs:comment "Specifies an operational  limit is calculated by scaling another operational limit." ;
    rdfs:subClassOf cim:LimitDependency .

cim:LineDetail a rdfs:Class ;
    rdfs:comment """Details on an amount line, with rounding, date and note.\r
""" .

cim:LineFault a rdfs:Class ;
    rdfs:comment "A fault that occurs on an AC line segment at some point along the length." ;
    rdfs:subClassOf cim:Fault .

cim:LinearShuntCompensator a rdfs:Class ;
    rdfs:comment "A linear shunt compensator has banks or sections with equal admittance values." ;
    rdfs:subClassOf cim:ShuntCompensator .

cim:LinearShuntCompensatorPhase a rdfs:Class ;
    rdfs:comment "A per phase linear shunt compensator has banks or sections with equal admittance values." ;
    rdfs:subClassOf cim:ShuntCompensatorPhase .

cim:LoadAggregate a rdfs:Class ;
    rdfs:comment """Aggregate loads are used to represent all or part of the real and reactive load from one or more loads in the static (power flow) data. This load is usually the aggregation of many individual load devices and the load model is an approximate representation of the aggregate response of the load devices to system disturbances.\r
Standard aggregate load model comprised of static and/or dynamic components.  A static load model represents the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage. A dynamic load model can be used to represent the aggregate response of the motor components of the load.\r
\r
\r
""" ;
    rdfs:subClassOf cim:LoadDynamics .

cim:LoadAggregationPoint a rdfs:Class ;
    rdfs:comment """A specialized class of type AggregatedNode type. Defines Load Aggregation Points.\r
""" ;
    rdfs:subClassOf cim:AggregateNode .

cim:LoadArea a rdfs:Class ;
    rdfs:comment "The class is the root or first level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling." ;
    rdfs:subClassOf cim:EnergyArea .

cim:LoadBid a rdfs:Class ;
    rdfs:comment "Offer to supply energy/ancillary services from a load resource (participating load reduces consumption)." ;
    rdfs:subClassOf cim:ResourceBid .

cim:LoadBreakSwitch a rdfs:Class ;
    rdfs:comment "A mechanical switching device capable of making, carrying, and breaking currents under normal operating conditions." ;
    rdfs:subClassOf cim:ProtectedSwitch .

cim:LoadComposite a rdfs:Class ;
    rdfs:comment """Combined static load and induction motor load effects.\r
The dynamics of the motor are simplified by linearizing the induction machine equations.""" ;
    rdfs:subClassOf cim:LoadDynamics .

cim:LoadDistributionFactor a rdfs:Class ;
    rdfs:comment """This class models the load distribution factors. This class should be used in one of two ways:\r
\r
Use it along with the AggregatedPnode and the IndividualPnode to show the distriubtion of each individual party\r
\r
OR\r
\r
Use it with Mkt_EnergyConsumer to represent the current MW/Mvar distribution within it's parnet load group.\r
""" .

cim:LoadFollowingInst a rdfs:Class ;
    rdfs:comment """Metered SubSystem Load Following Instruction.\r
""" .

cim:LoadFollowingOperatorInput a rdfs:Class ;
    rdfs:comment """Model of load following capabilities that are entered by operators on a temporary basis.  Related to Registered Resources in Metered Subsystems.\r
""" .

cim:LoadGenericNonLinear a rdfs:Class ;
    rdfs:comment "Generic non-linear dynamic (GNLD) load. This model can be used in mid-term and long-term voltage stability simulations (i.e., to study voltage collapse), as it can replace a more detailed representation of aggregate load, including induction motors, thermostatically controlled and static loads." ;
    rdfs:subClassOf cim:LoadDynamics .

cim:LoadModelPartVersion a rdfs:Class ;
    rdfs:comment "Load a model part version." .

cim:LoadMotor a rdfs:Class ;
    rdfs:comment """Aggregate induction motor load. This model is used to represent a fraction of an ordinary load as "induction motor load".  It allows a load that is treated as an ordinary constant power in power flow analysis to be represented by an induction motor in dynamic simulation. This model is intended for representation of aggregations of many motors dispersed through a load represented at a high voltage bus but where there is no information on the characteristics of individual motors.\r
Either a "one-cage" or "two-cage" model of the induction machine can be modelled. Magnetic saturation is not modelled.\r
This model treats a fraction of the constant power part of a load as a motor. During initialisation, the initial power drawn by the motor is set equal to <i>Pfrac</i> times the constant <i>P</i> part of the static load.  The remainder of the load is left as a static load.\r
The reactive power demand of the motor is calculated during initialisation as a function of voltage at the load bus. This reactive power demand can be less than or greater than the constant <i>Q</i> component of the load.  If the motor's reactive demand is greater than the constant <i>Q</i> component of the load, the model inserts a shunt capacitor at the terminal of the motor to bring its reactive demand down to equal the constant <i>Q</i> reactive load.  \r
If an induction motor load model and a static load model are both present for a load, the motor <i>Pfrac</i> is assumed to be subtracted from the power flow constant <i>P</i> load before the static load model is applied.  The remainder of the load, if any, is then represented by the static load model.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:LoadRatio a rdfs:Class ;
    rdfs:comment """Representing the ratio of the load share for the associated SC.\r
""" .

cim:LoadReductionPriceCurve a rdfs:Class ;
    rdfs:comment """This is the price sensitivity that bidder expresses for allowing market load interruption.  Relationship between price (Y1-axis) vs. MW (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:LoadReductionTimeCurve a rdfs:Class ;
    rdfs:comment """This is the cureve that describes the load reduction time. Relationship between time (Y1-axis) vs. MW (X-axis).\r
""" ;
    rdfs:subClassOf cim:Curve .

cim:LoadResponseCharacteristic a rdfs:Class ;
    rdfs:comment """Models the characteristic response of the load demand due to changes in system conditions such as voltage and frequency. It is not related to demand response.\r
If LoadResponseCharacteristic.exponentModel is True, the exponential voltage or frequency dependent models are specified and used as to calculate active and reactive power components of the load model.\r
The equations to calculate active and reactive power components of the load model are internal to the power flow calculation, hence they use different quantities depending on the use case of the data exchange. \r
The equations for exponential voltage dependent load model injected power are: \r
pInjection= Pnominal* (Voltage/cim:BaseVoltage.nominalVoltage) ** cim:LoadResponseCharacteristic.pVoltageExponent\r
qInjection= Qnominal* (Voltage/cim:BaseVoltage.nominalVoltage) ** cim:LoadResponseCharacteristic.qVoltageExponent\r
Where: \r
1) * means "multiply" and ** is "raised to power of";\r
2) Pnominal and Qnominal represent the active power and reactive power at nominal voltage as any load described by the voltage exponential model shall be given at nominal voltage.  This means that EnergyConsumer.p and EnergyConsumer.q  are at nominal voltage.\r
3) After power flow is solved: \r
-pInjection and qInjection correspond to SvPowerflow.p and SvPowerflow.q respectively.  \r
- Voltage corresponds to SvVoltage.v at the TopologicalNode where the load is connected.""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:LoadStatic a rdfs:Class ;
    rdfs:comment "General static load. This model represents the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage." ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:LoadUserDefined a rdfs:Class ;
    rdfs:comment "Load whose dynamic behaviour is described by a user-defined model." ;
    rdfs:subClassOf cim:LoadDynamics .

cim:LocalReliabilityArea a rdfs:Class ;
    rdfs:comment """Allows definition of reliability areas (e.g.. load pockets) within the ISO/RTO.\r
""" ;
    rdfs:subClassOf cim:IdentifiedObject .

cim:LocationGrant a rdfs:Class ;
    rdfs:comment "A grant provides a right, as defined by type, for a parcel of land. Note that the association to Location, Asset, Organisation, etc. for the Grant is inherited from Agreement, a type of Document." ;
    rdfs:subClassOf cim:Agreement .

cim:LossClearing a rdfs:Class ;
    rdfs:comment """RT only and is published on 5 minute intervals for the previous RT time interval results.\r
""" ;
    rdfs:subClassOf cim:MarketFactors .

cim:LossClearingResults a rdfs:Class ;
    rdfs:comment """Provides the MW loss for RUC Zones, subcontrol areas, and the total loss.\r
""" .

cim:LossProfile a rdfs:Class ;
