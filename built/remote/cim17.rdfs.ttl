cim:IgnAngleContInverter a rdfs:Class .

cim:Impedance a rdfs:Class ;
    rdfs:comment """Ratio of voltage to current.\r
""" .

cim:InUseDate a rdfs:Class ;
    rdfs:comment """Dates associated with asset 'in use' status. May have multiple in use dates for this device and a compound type allows a query to return multiple dates.\r
""" .

cim:InadvertentAccount a rdfs:Class ;
    rdfs:comment """An account for tracking inadvertent interchange versus time for each control area. A control area may have more than one inadvertent account in order to track inadvertent over one or more specific tie points in addition to the usual overall net inadvertent. Separate accounts would also be used to track designated time periods, such as on-peak and off-peak.\r
""" .

cim:Incident a rdfs:Class ;
    rdfs:comment "Description of a problem in the field that may be reported in a trouble ticket or come from another source. It may have to do with an outage." ;
    rdfs:subClassOf cim:Document .

cim:IncidentHazard a rdfs:Class ;
    rdfs:comment "Hazardous situation associated with an incident. Examples are line down, gas leak, fire, etc." ;
    rdfs:subClassOf cim:Hazard .

cim:IncrementalDatasetArg a rdfs:Class ;
    rdfs:comment "A generic model operation argument referencing an incremental change description." ;
    rdfs:subClassOf cim:ModelOperationArg .

cim:IncrementalDatasetArgDescription a rdfs:Class ;
    rdfs:subClassOf cim:ModelOperationArgDescription .

cim:IncrementalHeatRateCurve a rdfs:Class ;
    rdfs:comment "Relationship between unit incremental heat rate in (delta energy/time) per (delta active power) and unit output in active power. The IHR curve represents the slope of the HeatInputCurve. Note that the \"incremental heat rate\" and the \"heat rate\" have the same engineering units." ;
    rdfs:subClassOf cim:Curve .

cim:IndividualPnode a rdfs:Class ;
