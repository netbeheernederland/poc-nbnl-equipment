cim:IntSchedAgreement a rdfs:Class ;
    rdfs:comment """A type of agreement that provides the default method by which interchange schedules are to be integrated to obtain hourly MWh schedules for accounting. \r
""" ;
    rdfs:subClassOf cim:Agreement .

cim:IntegerQuantity a rdfs:Class ;
