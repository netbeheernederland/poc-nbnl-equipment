nl:CondEqMustHaveTwoTerminals a sh:NodeShape ;
    sh:targetClass cim:ACLineSegment ;
    sh:message "This type of conducting equipment must have exactly two terminals connected to it." ;
    sh:property [
        sh:path cim:ConductingEquipment.Terminals ;
	sh:minCount 2 ;
	sh:maxCount 2
    ] .

nl:CondEqMustHaveOneTerminal a sh:NodeShape ;
    sh:targetClass cim:BusbarSection ;
    sh:message "This type of conducting equipment must have exactly one terminal connected to it." ;
    sh:property [
        sh:path cim:ConductingEquipment.Terminals ;
	sh:minCount 1 ;
	sh:maxCount 1
    ] .
