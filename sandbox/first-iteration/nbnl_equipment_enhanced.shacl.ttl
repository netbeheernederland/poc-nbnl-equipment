    rdfs:comment """A base class for all objects that may contain connectivity nodes or topological nodes.\r
""" ;
    sh:closed false ;
    sh:ignoredProperties ( cim:Bay.busBarConfiguration <https://modellen.netbeheernederland.nl/nbnl-equipment/3.0/Region> cim:Substation cim:Bay.breakerConfiguration cim:BaseVoltage cim:VoltageLevel rdf:type ) ;
